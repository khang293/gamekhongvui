    }
  }

  // Nền bàn (vẽ một lần vào canvas phụ): thành gỗ có vân, mặt thành sáng với chấm xà cừ, đệm cao su có mũi hàm,
  // mặt nỉ dệt có ánh đèn, lỗ có viền da và nẹp đồng.
  let rngS = 7;
  const rnd = () => { rngS = (rngS * 16807) % 2147483647; return rngS / 2147483647; };
  const holeOf = (k: (typeof POOL_POCKETS)[number]): [number, number] => k.kind === 0 ? [k.cx - Math.sign(k.ux) * 5, k.cy - Math.sign(k.uy) * 5] : [k.cx, k.cy - k.uy * 7];
  function buildBg() {
    const c = mk(cv.width, cv.height), x = c.getContext('2d')!;
    x.scale(sc, sc);
    rngS = 7;
    const hasP = mode !== 'carom';
    const rr = (px: number, py: number, w: number, h: number, r: number) => { x.beginPath(); x.roundRect(px, py, w, h, r); };
    // ---- gỗ khung
    rr(0, 0, LW, LH, 30);
    const wood = x.createLinearGradient(0, 0, LW * 0.6, LH); wood.addColorStop(0, '#74431d'); wood.addColorStop(0.5, '#4c2b13'); wood.addColorStop(1, '#321a0b');
    x.fillStyle = wood; x.fill();
    x.save(); rr(0, 0, LW, LH, 30); x.clip();
    const grain = (gx: number, gy: number, gw: number, gh: number, vert: boolean, n: number) => {
      x.save(); x.beginPath(); x.rect(gx, gy, gw, gh); x.clip();
      for (let i = 0; i < n; i++) {
        const light = rnd() > 0.45;
        x.strokeStyle = `rgba(${light ? '255,205,140' : '24,9,0'},${(0.05 + rnd() * 0.1).toFixed(3)})`; x.lineWidth = 0.5 + rnd() * 1.8;
        x.beginPath();
        if (!vert) { const yy = gy + rnd() * gh, w1 = (rnd() - 0.5) * 7, w2 = (rnd() - 0.5) * 7; x.moveTo(gx, yy); x.bezierCurveTo(gx + gw * 0.3, yy + w1, gx + gw * 0.7, yy + w2, gx + gw, yy + (w1 + w2) / 2); }
        else { const xx = gx + rnd() * gw, w1 = (rnd() - 0.5) * 7, w2 = (rnd() - 0.5) * 7; x.moveTo(xx, gy); x.bezierCurveTo(xx + w1, gy + gh * 0.3, xx + w2, gy + gh * 0.7, xx + (w1 + w2) / 2, gy + gh); }
        x.stroke();
      }
      // vài mắt gỗ
      for (let i = 0; i < 3; i++) { const ex = gx + rnd() * gw, ey = gy + rnd() * gh; x.strokeStyle = 'rgba(20,8,0,.14)'; x.lineWidth = 1; for (let k = 1; k < 4; k++) { x.beginPath(); x.ellipse(ex, ey, (vert ? 3 : 14) * k * 0.7, (vert ? 14 : 3) * k * 0.7, 0, 0, 7); x.stroke(); } }
      x.restore();
    };
    grain(0, 0, LW, M, false, 80); grain(0, LH - M, LW, M, false, 80); grain(0, M, M, H, true, 46); grain(LW - M, M, M, H, true, 46);
    x.restore();
    // mặt thành trên (sáng hơn) có vát cạnh
    rr(9, 9, LW - 18, LH - 18, 22);
    const cap = x.createLinearGradient(0, 0, LW * 0.5, LH); cap.addColorStop(0, 'rgba(255,190,120,.30)'); cap.addColorStop(0.5, 'rgba(255,170,100,.10)'); cap.addColorStop(1, 'rgba(0,0,0,.12)');
    x.fillStyle = cap; x.fill();
    rr(2, 2, LW - 4, LH - 4, 29); x.strokeStyle = 'rgba(255,225,175,.4)'; x.lineWidth = 2.4; x.stroke();
    rr(9, 9, LW - 18, LH - 18, 22); x.strokeStyle = 'rgba(0,0,0,.5)'; x.lineWidth = 3; x.stroke();
    rr(11.5, 11.5, LW - 23, LH - 23, 20); x.strokeStyle = 'rgba(255,220,170,.16)'; x.lineWidth = 1.2; x.stroke();
    // lòng bàn (tối) quanh cao su
    rr(M - 28, M - 28, W + 56, H + 56, 10); x.fillStyle = '#120a05'; x.fill();
    rr(M - 28, M - 28, W + 56, H + 56, 10); x.strokeStyle = 'rgba(255,225,180,.22)'; x.lineWidth = 1.4; x.stroke();
    // ---- mặt nỉ
    const cloth = hasP ? ['#2fa263', '#1d8049', '#13613a'] : ['#3283c9', '#22649f', '#17497a'];
    const cl = x.createRadialGradient(LW * 0.48, LH * 0.42, 30, LW / 2, LH / 2, LW * 0.6);
    cl.addColorStop(0, cloth[0]); cl.addColorStop(0.55, cloth[1]); cl.addColorStop(1, cloth[2]);
    x.fillStyle = cl; x.fillRect(M, M, W, H);
    { // vải dệt: ô hoa văn nhỏ lặp lại
      const t = mk(6, 6), tx = t.getContext('2d')!;
      tx.strokeStyle = 'rgba(255,255,255,.07)'; tx.lineWidth = 1; tx.beginPath(); tx.moveTo(0, 6); tx.lineTo(6, 0); tx.moveTo(-3, 3); tx.lineTo(3, -3); tx.moveTo(3, 9); tx.lineTo(9, 3); tx.stroke();
      tx.strokeStyle = 'rgba(0,0,0,.08)'; tx.beginPath(); tx.moveTo(0, 0); tx.lineTo(6, 6); tx.moveTo(-3, 3); tx.lineTo(3, 9); tx.moveTo(3, -3); tx.lineTo(9, 3); tx.stroke();
      const pat = x.createPattern(t, 'repeat'); if (pat) { x.fillStyle = pat; x.fillRect(M, M, W, H); }
    }
    for (let i = 0; i < 4200; i++) { x.fillStyle = `rgba(${rnd() > 0.5 ? '255,255,255' : '0,0,0'},${(0.015 + rnd() * 0.035).toFixed(3)})`; x.fillRect(M + rnd() * W, M + rnd() * H, 1.1, 1.1); }
    // ánh đèn chiếu từ trên: sáng ở giữa, tối dần ra mép
    const spot = x.createRadialGradient(LW / 2, LH * 0.42, 20, LW / 2, LH * 0.45, W * 0.55); spot.addColorStop(0, 'rgba(255,255,230,.17)'); spot.addColorStop(1, 'rgba(255,255,230,0)');
    x.fillStyle = spot; x.fillRect(M, M, W, H);
    const vg = x.createRadialGradient(LW / 2, LH / 2, H * 0.3, LW / 2, LH / 2, W * 0.62); vg.addColorStop(0, 'rgba(0,0,0,0)'); vg.addColorStop(1, 'rgba(0,0,0,0.34)');
    x.fillStyle = vg; x.fillRect(M, M, W, H);
    // phấn kẻ: vạch đầu bàn và chấm
    x.strokeStyle = 'rgba(255,255,255,.13)'; x.lineWidth = 1.4;
    if (hasP) { x.beginPath(); x.moveTo(M + W * 0.25, M + 6); x.lineTo(M + W * 0.25, M + H - 6); x.stroke(); }
    x.fillStyle = 'rgba(255,255,255,.34)';
    for (const [px, py] of hasP ? [[0.25, 0.5], [0.72, 0.5]] : [[0.25, 0.5], [0.5, 0.5], [0.75, 0.5]]) { x.beginPath(); x.arc(M + W * px, M + H * py, 3, 0, 7); x.fill(); }
    // ---- đệm cao su (cục bộ: u dọc băng, v hướng ra ngoài)
    const CUS = hasP ? ['#2a8d52', '#14663a', '#0a3f23'] : ['#2f78b8', '#1d5a93', '#0f3a63'];
    const cushion = (side: number, u1: number, u2: number, e1: number, e2: number) => {
      x.save();
      if (side === 0) x.transform(1, 0, 0, -1, M, M); else if (side === 1) x.transform(1, 0, 0, 1, M, M + H);
      else if (side === 2) x.transform(0, 1, -1, 0, M, M); else x.transform(0, 1, 1, 0, M + W, M);
      const sh = x.createLinearGradient(0, 0, 0, -11); sh.addColorStop(0, 'rgba(0,0,0,.42)'); sh.addColorStop(1, 'rgba(0,0,0,0)'); // bóng của đệm đổ lên nỉ
      x.fillStyle = sh; x.beginPath(); x.moveTo(u1, 0); x.lineTo(u2, 0); x.lineTo(u2 + e2 * 0.4, -11); x.lineTo(u1 - e1 * 0.4, -11); x.closePath(); x.fill();
      const gr = x.createLinearGradient(0, 0, 0, 23); gr.addColorStop(0, CUS[0]); gr.addColorStop(0.35, CUS[1]); gr.addColorStop(1, CUS[2]);
      x.beginPath(); x.moveTo(u1, 0); x.lineTo(u2, 0); x.lineTo(u2 + e2, 23); x.lineTo(u1 - e1, 23); x.closePath();
      x.fillStyle = gr; x.fill(); x.strokeStyle = 'rgba(0,0,0,.45)'; x.lineWidth = 1.2; x.stroke();
      x.strokeStyle = 'rgba(200,255,225,.42)'; x.lineWidth = 1.8; x.beginPath(); x.moveTo(u1 + 1, 0.9); x.lineTo(u2 - 1, 0.9); x.stroke();
      x.strokeStyle = 'rgba(255,255,255,.1)'; x.lineWidth = 3; x.beginPath(); x.moveTo(u1 + 2, 4); x.lineTo(u2 - 2, 4); x.stroke();
      x.restore();
    };
    if (hasP) {
      const A = TC, B = W / 2 - TS, Cc = W / 2 + TS, D = W - TC, E = TC, F = H - TC;
      for (const side of [0, 1]) { cushion(side, A, B, 17, 11); cushion(side, Cc, D, 11, 17); }
      for (const side of [2, 3]) cushion(side, E, F, 17, 17);
    } else {
      cushion(0, 0, W, 23, 23); cushion(1, 0, W, 23, 23); cushion(2, 0, H, 23, 23); cushion(3, 0, H, 23, 23);
    }
    // ---- lỗ: nẹp đồng, viền da, miệng lỗ sâu
    if (hasP) {
      for (const k of POOL_POCKETS) {
        const [hx0, hy0] = holeOf(k), hx = M + hx0, hy = M + hy0, hr = k.r - 1;
        const iux = k.kind === 0 ? k.ux : 0, iuy = k.uy;       // hướng vào trong bàn
        const ox = -iux, oy = -iuy, ol = Math.hypot(ox, oy) || 1, nx = ox / ol, ny = oy / ol; // hướng ra ngoài (đơn vị)
        // nẹp đồng: hình lưỡi liềm ôm phía ngoài của lỗ
        const ang = Math.atan2(ny, nx);
        const brass = x.createLinearGradient(hx + nx * (hr + 15), hy + ny * (hr + 15), hx - nx * 4, hy - ny * 4);
        brass.addColorStop(0, '#f1d58a'); brass.addColorStop(0.45, '#b98a2e'); brass.addColorStop(1, '#6b4b14');
        x.beginPath(); x.arc(hx, hy, hr + 15, ang - Math.PI / 2, ang + Math.PI / 2, false); x.closePath();
        x.fillStyle = brass; x.fill(); x.strokeStyle = 'rgba(40,20,0,.6)'; x.lineWidth = 1.6; x.stroke();
        for (const t of [-0.55, 0.55]) { const sx = hx + Math.cos(ang + t) * (hr + 9.5), sy = hy + Math.sin(ang + t) * (hr + 9.5); x.beginPath(); x.arc(sx, sy, 1.9, 0, 7); x.fillStyle = '#5a3d10'; x.fill(); x.strokeStyle = 'rgba(255,230,160,.6)'; x.lineWidth = 0.6; x.stroke(); }
        // viền da/cao su
        x.beginPath(); x.arc(hx, hy, hr + 6.5, 0, 7); x.fillStyle = '#25160c'; x.fill();
        x.strokeStyle = 'rgba(255,205,140,.3)'; x.lineWidth = 1.2; x.stroke();
        x.setLineDash([2.2, 3.2]); x.beginPath(); x.arc(hx, hy, hr + 3.6, 0, 7); x.strokeStyle = 'rgba(235,190,130,.5)'; x.lineWidth = 1; x.stroke(); x.setLineDash([]);
        // miệng lỗ
        const hg = x.createRadialGradient(hx - iux * 3, hy - iuy * 3, 2, hx, hy, hr);
        hg.addColorStop(0, '#000'); hg.addColorStop(0.7, '#030202'); hg.addColorStop(1, '#17100a');
        x.beginPath(); x.arc(hx, hy, hr, 0, 7); x.fillStyle = hg; x.fill();
        x.strokeStyle = 'rgba(0,0,0,.9)'; x.lineWidth = 2; x.stroke();
        // ánh sáng mờ ở thành lỗ phía ngoài
        x.save(); x.beginPath(); x.arc(hx, hy, hr - 1, 0, 7); x.clip();
        const rim = x.createRadialGradient(hx + iux * 7, hy + iuy * 7, hr * 0.5, hx, hy, hr); rim.addColorStop(0, 'rgba(0,0,0,0)'); rim.addColorStop(1, 'rgba(90,55,25,.4)');
        x.fillStyle = rim; x.fillRect(hx - hr, hy - hr, hr * 2, hr * 2);
