    const dia = (px: number, py: number, vert: boolean) => {
      x.save(); x.translate(px, py);
      x.fillStyle = 'rgba(0,0,0,.35)'; x.beginPath(); x.moveTo(0.8, -6 + 1.2); x.lineTo(5.6, 1.2); x.lineTo(0.8, 6 + 1.2); x.lineTo(-4, 1.2); x.closePath(); x.fill();
      const gr = x.createRadialGradient(-1.2, -1.8, 0.5, 0, 0, 7); gr.addColorStop(0, '#ffffff'); gr.addColorStop(0.55, '#e8eef7'); gr.addColorStop(1, '#a9b8d0');
      x.beginPath(); x.moveTo(0, vert ? -7 : -6); x.lineTo(vert ? 4.6 : 5.4, 0); x.lineTo(0, vert ? 7 : 6); x.lineTo(vert ? -4.6 : -5.4, 0); x.closePath();
      x.fillStyle = gr; x.fill(); x.strokeStyle = 'rgba(50,25,5,.6)'; x.lineWidth = 0.9; x.stroke();
      x.strokeStyle = 'rgba(255,255,255,.9)'; x.lineWidth = 0.8; x.beginPath(); x.moveTo(-1.2, -2.2); x.lineTo(0, -4.4); x.stroke();
      x.restore();
    };
    for (let i = 1; i < 8; i++) { if (hasP && i === 4) continue; dia(M + (W * i) / 8, 23, false); dia(M + (W * i) / 8, LH - 23, false); }
    for (let i = 1; i < 4; i++) { dia(23, M + (H * i) / 4, true); dia(LW - 23, M + (H * i) / 4, true); }
    bg = c;
  }

  function fit() {
    const parent = cv.parentElement as HTMLElement;
    const cssW = parent.clientWidth || LW;
    const dpr = Math.min(2, window.devicePixelRatio || 1);
    const ns = Math.max(0.5, Math.min(2, (cssW * dpr) / LW));
    const pw = Math.round(LW * ns), ph = Math.round(LH * ns);
    if (cv.width !== pw || cv.height !== ph || Math.abs(ns - sc) > 0.001 || !bg) {
      sc = ns; cv.width = pw; cv.height = ph; buildBg();
    }
  }

  // ---------- Bảng người chơi ----------
  const BAR_COL = ['#d8262a', '#f2c200'];
  function chip(id: number) {
    const col = BALL_COL[id <= 8 ? id : id - 8];
    const dead = !world.alive[id];
    const style = id <= 8 ? `background:${col}` : `background:linear-gradient(transparent 26%,${col} 26%,${col} 74%,transparent 74%),#f6f3e8`;
    return `<i class="bl-chip${dead ? ' out' : ''}" style="${style}"><span>${id}</span></i>`;
  }
  function paintBars() {
    for (let p = 0; p < 2; p++) {
      const el = $('bl-p' + p);
      const on = phase !== 'over' && phase !== 'menu' && cur === p;
      el.className = 'bl-player' + (on ? ' on' : '');
      let body = '';
      if (isRack()) body = '';
      else if (mode === 'pool') {
        const gp = pool.group[p];
        if (!gp) body = `<small>${T.open}</small>`;
        else {
          const ids: number[] = [];
          for (let i = 1; i <= 15; i++) if (typeOf(i) === gp) ids.push(i);
          const left = ownLeft(world.alive, gp);
          body = `<small>${groupName(gp)}</small><span class="bl-chips">${ids.map(chip).join('')}${left === 0 ? chip(8) : ''}</span>`;
        }
      } else {
        const ball = p === 0 ? T.white : T.yellow;
        body = `<small>${ball}</small><em>${score[p]} / ${goal}</em>`;
      }
      const av = mode === 'carom' ? `<span class="bl-av" style="background:${p === 0 ? '#f6f3e8' : '#f2c200'}"></span>` : `<span class="bl-av" style="background:${p === 0 ? '#2b6cb0' : '#c05621'}">${p + 1}</span>`;
      el.innerHTML = `${av}<b>${nameOf(p)}</b>${body}`;
    }
  }
  function chipStyle(id: number) {
    const col = BALL_COL[id <= 8 ? id : id - 8];
    return id <= 8 ? `background:${col}` : `background:linear-gradient(transparent 26%,${col} 26%,${col} 74%,transparent 74%),#f6f3e8`;
  }
  const chipOf = (id: number, hl = false) => `<i class="bl-chip${hl ? ' hl' : ''}" style="${chipStyle(id)}"><span>${id}</span></i>`;
  function paintInfo() {
    const el = $('bl-info');
    el.hidden = !isRack() || phase === 'menu';
    if (el.hidden) return;
    const last = lastBall(mode), low = lowestBall(world.alive, last);
    const chips: string[] = [];
    for (let i = 1; i <= last; i++) if (world.alive[i]) chips.push(chipOf(i, i === low));
    let h = `<span class="bl-nx"><small>${T.next}</small>${low > 0 ? chipOf(low, true) : ''}</span><span class="bl-left"><small>${T.left}</small><span class="bl-chips">${chips.join('')}</span></span>`;
    if (mode === 'ten' && !pool.breakPending) {
      const ok = !!call && call.pocket >= 0;
      h += `<span class="bl-call${ok ? ' ok' : ''}"><small>${T.callLbl}</small>${call && world.alive[call.ball] ? chipOf(call.ball) : ''}${ok ? ` → <b>${T.pockets[call!.pocket]}</b>` : ` <em>${T.callPrompt}</em>`}</span>`;
    }
    el.innerHTML = h;
  }
  function setStatus(text: string, done = false) {
    statusEl.textContent = text;
    statusEl.classList.toggle('done', done);
  }
  function statusFor() {
    if (phase === 'over') return;
    let t = '';
    if (phase === 'think' || phase === 'aimbot') t = T.thinking;
    else if (phase === 'roll' || phase === 'strike') t = T.rolling;
    else if (phase === 'place') t = pool.breakPending ? T.placeBreak : fmt(T.placeFree, { n: nameOf(cur) });
    else t = opp === 'bot' && isHuman(cur) ? T.yourTurn : fmt(T.turnOf, { n: nameOf(cur) });
    if (phase === 'aim' && mode === 'ten' && !pool.breakPending && isHuman(cur)) t += ' ' + (call && call.pocket >= 0 ? '' : T.callNeedPocket);
    setStatus((note ? note + ' ' : '') + t);
  }
  function refresh() { paintBars(); paintInfo(); statusFor(); updateControls(); }

  function updateControls() {
    const act = (phase === 'aim' || phase === 'place') && isHuman(cur);
    $('bl-ctl').classList.toggle('off', !act);
    const btn = $('bl-shoot');
    btn.textContent = phase === 'place' ? T.place : T.shoot;
    (btn as HTMLButtonElement).disabled = !act;
    powerEl.disabled = !act || phase === 'place';
    ($('bl-left') as HTMLButtonElement).disabled = !act || phase === 'place';
    ($('bl-right') as HTMLButtonElement).disabled = !act || phase === 'place';
  }

  // ---------- Luồng ván ----------
  function newGame() {
    gid++;
    world = newWorld(mode);
    rot.fill(0); sinks.length = 0; note = ''; call = null; bg = null;
    if (mode === 'pool') { rackPool(world); pool = { cur: 0, group: [0, 0], breakPending: true, inHand: true, headOnly: true }; }
    else if (isRack()) { rackRows(world, mode as 'nine' | 'ten'); pool = { cur: 0, group: [0, 0], breakPending: true, inHand: true, headOnly: true }; }
    else setupCarom(world);
    cur = 0; score = [0, 0];
    aim.sx = 0; aim.sy = 0; moveDot();
    buildPatterns();
    fit();
    phase = 'aim'; // thoát trạng thái 'over' của ván trước, nếu không beginTurn() thoát ngay và bàn bị đứng
    beginTurn();
  }

  function nearestTarget(): number {
    const cid = cueId();
    let best = -1, bd = 1e9;
    for (let i = 0; i < world.n; i++) {
      if (i === cid || !world.alive[i]) continue;
      if (isRack()) { if (i !== lowestBall(world.alive, lastBall(mode))) continue; }
      else if (mode === 'pool') { const t = typeOf(i); const gp = pool.group[cur]; if (gp && ownLeft(world.alive, gp) > 0 ? t !== gp : (gp ? t !== 3 : t === 3)) continue; }
      const d = Math.hypot(world.x[i] - world.x[cid], world.y[i] - world.y[cid]);
      if (d < bd) { bd = d; best = i; }
    }
    return best;
  }
  function defaultAim() {
    const cid = cueId(), t = nearestTarget();
    if (t >= 0) aim.angle = Math.atan2(world.y[t] - world.y[cid], world.x[t] - world.x[cid]);
  }
  function ensureCueOnTable() {
    if (world.alive[0]) return;
    const spots: [number, number][] = [[W * 0.22, H / 2], [W * 0.2, H * 0.3], [W * 0.2, H * 0.7], [W * 0.15, H / 2], [W * 0.5, H / 2]];
    for (const [px, py] of spots) if (canPlace(world, 0, px, py, false)) { world.x[0] = px; world.y[0] = py; break; }
    world.alive[0] = 1; world.vx[0] = world.vy[0] = 0;
  }

  function beginTurn() {
    if (phase === 'over') return;
    if (mode !== 'carom' && pool.inHand) {
      ensureCueOnTable();
      if (pool.headOnly && world.x[0] > W * 0.25) { world.x[0] = W * 0.22; world.y[0] = H / 2; }
      phase = isHuman(cur) ? 'place' : 'think';
    } else phase = isHuman(cur) ? 'aim' : 'think';
    call = mode === 'ten' && !pool.breakPending ? { ball: lowestBall(world.alive, 10), pocket: -1 } : null;
    if (phase === 'aim') { defaultAim(); aim.power = Math.max(0.05, aim.power); pull = 10; }
    if (phase === 'place') defaultAim();
    refresh();
    if (phase === 'think') botTurn();
  }

  // ---------- Máy ----------
  let worker: Worker | null = null;
  let jobId = 0;
  const pending = new Map<number, (s: Shot) => void>();
  function initWorker() {
    if (worker) return;
    try {
      worker = new Worker(new URL('../../data/billiardsWorker.ts', import.meta.url), { type: 'module' });
      worker.onmessage = (e) => { const f = pending.get(e.data.id); if (f) { pending.delete(e.data.id); f(e.data.shot); } };
      worker.onerror = () => { worker = null; };
    } catch { worker = null; }
  }
  function makeJob(): Job {
    return {
      kind: mode, x: Array.from(world.x), y: Array.from(world.y), alive: Array.from(world.alive),
      cur, group: pool.group.slice(), breakPending: pool.breakPending, inHand: pool.inHand, headOnly: pool.headOnly,
      level, ms: [500, 900, 1500][level - 1],
    };
  }
  function askBot(): Promise<Shot> {
    initWorker();
    const job = makeJob();
    return new Promise((resolve) => {
      if (worker) {
        const id = ++jobId;
        pending.set(id, resolve);
        worker.postMessage({ id, job });
        setTimeout(() => { if (pending.has(id)) { pending.delete(id); setTimeout(() => resolve(chooseShot(job)), 0); } }, job.ms + 4000);
      } else setTimeout(() => resolve(chooseShot(job)), 40);
    });
  }
  function botTurn() {
    const id = gid;
    setTimeout(() => {
      if (id !== gid || phase !== 'think') return;
      askBot().then((s) => {
        if (id !== gid || phase !== 'think') return;
        if (s.pos) { world.x[0] = s.pos[0]; world.y[0] = s.pos[1]; world.alive[0] = 1; world.vx[0] = world.vy[0] = 0; pool.inHand = false; pool.headOnly = false; }
        aim.angle = s.angle; aim.power = s.power; aim.sx = s.sx; aim.sy = s.sy; moveDot();
        if (mode === 'ten' && !pool.breakPending) call = s.call ?? { ball: lowestBall(world.alive, 10), pocket: 0 };
        pull = 10; phase = 'aimbot'; refresh();
        setTimeout(() => { if (id === gid && phase === 'aimbot') startStrike(); }, 750);
      });
    }, 350);
  }

  // ---------- Đánh và mô phỏng ----------
  function startStrike() {
    phase = 'strike'; strikeT = 0; pullStart = pull; refresh();
  }
  function doShoot() {
    aliveBefore = world.alive.slice();
    shoot(world, cueId(), aim.angle, aim.power, aim.sx, aim.sy);
    note = '';
    evi = 0; acc = 0; rollSteps = 0;
    sfx.play('cue', aim.power);
    phase = 'roll'; refresh();
  }

  function handleEvents() {
    let clack = 0;
    for (; evi < world.ev.length; evi++) {
      const e = world.ev[evi];
      if (e.k === 0) { if (clack++ < 3) sfx.play('clack', Math.min(1, e.v / 1800)); }
      else if (e.k === 1) sfx.play('cushion', Math.min(1, e.v / 1500));
      else {
        sfx.play('pocket');
        const p = POOL_POCKETS[e.b];
        paintBars();
        const [hx, hy] = holeOf(p);
        sinks.push({ id: e.a, x: world.x[e.a], y: world.y[e.a], px: hx, py: hy, t: 0 });
      }
    }
  }

  function finish(winner: number, text: string) {
    phase = 'over';
    const youWon = opp === 'bot' ? winner === 0 : true;
    const msg = opp === 'bot' ? (winner === 0 ? T.youWin : T.youLose) : fmt(T.winner, { n: nameOf(winner) });
    if (opp === 'bot') { if (winner === 0) stats[mode].w++; else stats[mode].l++; saveStats(); }
    setStatus((text ? text + ' ' : '') + msg, true);
    sfx.play(youWon ? 'win' : 'lose');
    paintBars(); updateControls();
  }

  function respot8() {
    let x = W * 0.72 + 4 * (R * 1.732 + 0.35), y = H / 2;
    for (let k = 0; k < 12 && !canPlace(world, 8, x, y, false); k++) { x += R * 2 + 1; if (x > W - R - 2) { x = W * 0.72; y += R * 2 + 1; } }
    world.x[8] = x; world.y[8] = y; world.alive[8] = 1; world.vx[8] = world.vy[8] = 0;
  }

  function endShot() {
    if (mode === 'pool') {
      const res = resolvePool(pool, aliveBefore, world.ev);
      const shooter = cur;
      if (res.respot8) respot8();
      if (res.winner >= 0) {
        const why = res.reason === 'early8' ? T.early8 : res.reason ? foulText(res.reason) : '';
        finish(res.winner, why);
        return;
      }
      let t = '';
      if (res.assign) {
        pool.group[shooter] = res.assign; pool.group[1 - shooter] = res.assign === 1 ? 2 : 1;
        t = fmt(T.assigned, { n: nameOf(shooter), g: groupName(res.assign) });
      }
      pool.breakPending = false; pool.headOnly = false;
      if (res.foul) {
        pool.inHand = true; cur = 1 - shooter;
        t = foulText(res.reason) + (isHuman(cur) ? '' : ' ' + fmt(T.foulHand, { n: nameOf(cur) }));
      } else {
        pool.inHand = false; if (!res.keep) cur = 1 - shooter;
        t = (t ? t + ' ' : '') + (res.keep ? fmt(T.keepPot, { n: nameOf(shooter) }) : fmt(T.miss, { n: nameOf(cur) }));
      }
      note = t;
    } else if (isRack()) {
      const shooter = cur, wasBreak = pool.breakPending;
      const res = resolveRack(mode, { cur: shooter, breakPending: wasBreak, inHand: pool.inHand, headOnly: pool.headOnly }, aliveBefore, world.ev, call);
      let t = '';
      for (const id of res.respot) { respotBall(world, id); t += fmt(T.respotBall, { b: id }) + ' '; }
      if (res.winner >= 0) { finish(res.winner, t.trim()); return; }
      pool.breakPending = false; pool.headOnly = false;
      if (res.foul) {
        pool.inHand = true; cur = 1 - shooter;
        t += foulText(res.reason) + (isHuman(cur) ? '' : ' ' + fmt(T.foulHand, { n: nameOf(cur) }));
      } else {
        pool.inHand = false;
        if (res.keep) t += fmt(T.keepPot, { n: nameOf(shooter) });
        else {
          cur = 1 - shooter;
          t += mode === 'ten' && !wasBreak && res.potted.length > 0 && !res.calledOk ? fmt(T.wrongCall, { n: nameOf(cur) }) : fmt(T.miss, { n: nameOf(cur) });
        }
      }
      note = t.trim();
    } else {
      const res = resolveCarom(world.ev, cueId());
      if (res.point) {
        score[cur]++;
        if (score[cur] >= goal) { paintBars(); finish(cur, fmt(T.point, { n: nameOf(cur) })); return; }
        note = fmt(T.point, { n: nameOf(cur) });
      } else { cur = 1 - cur; note = fmt(T.miss, { n: nameOf(cur) }); }
    }
    beginTurn();
  }
  function foulText(r: string) {
    return r === 'scratch' ? T.foulScratch : r === 'nohit' ? T.foulNohit : r === 'wrong' ? T.foulWrong : r === 'norail' ? T.foulNorail : '';
  }

  // ---------- Điều khiển ----------
  function tablePos(e: PointerEvent) {
    const r = cv.getBoundingClientRect();
    return { x: ((e.clientX - r.left) / r.width) * LW - M, y: ((e.clientY - r.top) / r.height) * LH - M };
  }
  let dragging = false;
  function handlePointer(e: PointerEvent) {
    const p = tablePos(e);
    const cid = cueId();
    if (phase === 'place') {
      const maxX = pool.headOnly ? W * 0.25 : W - R - 1;
      const x = Math.max(R + 1, Math.min(maxX, p.x)), y = Math.max(R + 1, Math.min(H - R - 1, p.y));
      if (canPlace(world, 0, x, y, pool.headOnly)) { world.x[0] = x; world.y[0] = y; }
      defaultAim();
    } else if (phase === 'aim') {
      const dx = p.x - world.x[cid], dy = p.y - world.y[cid];
      if (dx * dx + dy * dy > 100) aim.angle = Math.atan2(dy, dx);
    }
  }
  // 10 bi: bấm vào lỗ để gọi lỗ, bấm vào bi để gọi bi
  function pickPocket(p: { x: number; y: number }): boolean {
    for (let i = 0; i < POOL_POCKETS.length; i++) {
      const k = POOL_POCKETS[i];
      const [hx, hy] = holeOf(k);
      if (Math.hypot(p.x - hx, p.y - hy) < k.r + 16) { callPocket(i); return true; }
    }
    return false;
  }
  function callPocket(i: number) {
    call = { ball: call && world.alive[call.ball] ? call.ball : lowestBall(world.alive, 10), pocket: i };
    sfx.play('select'); refresh();
  }
  function pickBall(p: { x: number; y: number }) {
    for (let id = 1; id < world.n; id++) {
      if (!world.alive[id]) continue;
      if (Math.hypot(p.x - world.x[id], p.y - world.y[id]) < R * 1.4) { call = { ball: id, pocket: call ? call.pocket : -1 }; refresh(); return; }
    }
  }
  cv.addEventListener('pointerdown', (e) => {
    if (!((phase === 'aim' || phase === 'place') && isHuman(cur))) return;
    if (phase === 'aim' && mode === 'ten' && !pool.breakPending) { const tp = tablePos(e); if (pickPocket(tp)) return; pickBall(tp); }
    dragging = true; try { cv.setPointerCapture(e.pointerId); } catch {}
    handlePointer(e);
  });
  cv.addEventListener('pointermove', (e) => { if (dragging) handlePointer(e); });
  const endDrag = () => { dragging = false; };
  cv.addEventListener('pointerup', endDrag); cv.addEventListener('pointercancel', endDrag);

  function act() {
    if (!isHuman(cur)) return;
    if (phase === 'place') {
      pool.inHand = false; pool.headOnly = false;
      phase = 'aim'; defaultAim(); pull = 10; sfx.play('select'); refresh();
    } else if (phase === 'aim') {
      if (mode === 'ten' && !pool.breakPending && (!call || call.pocket < 0)) { setStatus(T.callNeedPocket); return; }
      startStrike();
    }
  }
  $('bl-shoot').addEventListener('click', act);
  powerEl.addEventListener('input', () => { aim.power = Number(powerEl.value) / 100; $('bl-powv').textContent = powerEl.value; });
  // ngắm tinh: giữ nút để quay đều
  function holdBtn(id: string, dir: number) {
    const el = $(id); let iv = 0;
    const stop = () => { if (iv) { clearInterval(iv); iv = 0; } };
    el.addEventListener('pointerdown', (e) => { if (phase !== 'aim') return; e.preventDefault(); aim.angle += dir * 0.0035; stop(); iv = window.setInterval(() => { if (phase !== 'aim') return stop(); aim.angle += dir * 0.0035; }, 40); });
    for (const ev of ['pointerup', 'pointerleave', 'pointercancel']) el.addEventListener(ev, stop);
  }
  holdBtn('bl-left', -1); holdBtn('bl-right', 1);
  window.addEventListener('keydown', (e) => {
    if (gameEl.hidden || (e.target as HTMLElement)?.tagName === 'INPUT' || !isHuman(cur)) return;
    if (phase === 'aim') {
      const k = e.shiftKey ? 5 : 1;
      if (e.key === 'ArrowLeft') { aim.angle -= 0.004 * k; e.preventDefault(); }
      else if (e.key === 'ArrowRight') { aim.angle += 0.004 * k; e.preventDefault(); }
      else if (e.key === 'ArrowUp' || e.key === 'ArrowDown') { const v = Math.max(3, Math.min(100, Number(powerEl.value) + (e.key === 'ArrowUp' ? 3 : -3))); powerEl.value = String(v); powerEl.dispatchEvent(new Event('input')); e.preventDefault(); }
    }
    if (phase === 'aim' && mode === 'ten' && !pool.breakPending && e.key >= '1' && e.key <= '6') { callPocket(Number(e.key) - 1); e.preventDefault(); }
    if ((e.key === ' ' || e.key === 'Enter') && (phase === 'aim' || phase === 'place')) { e.preventDefault(); act(); }
  });
  // vòng chọn xoáy
  const dial = $('bl-dial'), dot = $('bl-dot');
  function moveDot() { dot.style.left = 50 + aim.sx * 45 + '%'; dot.style.top = 50 - aim.sy * 45 + '%'; }
  function dialPtr(e: PointerEvent) {
    const r = dial.getBoundingClientRect();
    let x = ((e.clientX - r.left) / r.width - 0.5) * 2, y = ((e.clientY - r.top) / r.height - 0.5) * 2;
    const m = Math.hypot(x, y); if (m > 0.9) { x *= 0.9 / m; y *= 0.9 / m; }
    aim.sx = x; aim.sy = -y; moveDot();
  }
  let dialDrag = false;
  dial.addEventListener('pointerdown', (e) => { if (!((phase === 'aim' || phase === 'place') && isHuman(cur))) return; dialDrag = true; try { dial.setPointerCapture(e.pointerId); } catch {} dialPtr(e); });
  dial.addEventListener('pointermove', (e) => { if (dialDrag) dialPtr(e); });
  dial.addEventListener('pointerup', () => { dialDrag = false; });
  dial.addEventListener('dblclick', () => { aim.sx = 0; aim.sy = 0; moveDot(); });

  // ---------- Menu ----------
  function pick(attr: string, cb: (v: string) => void) {
    document.querySelectorAll<HTMLElement>(`#bl-menu [data-${attr}]`).forEach((btn) => btn.addEventListener('click', () => {
      document.querySelectorAll(`#bl-menu [data-${attr}]`).forEach((x) => x.classList.remove('sel'));
      btn.classList.add('sel'); cb(btn.dataset[attr] as string);
    }));
  }
  function syncMenu() {
    $('bl-botopts').hidden = opp !== 'bot';
    $('bl-goalopts').hidden = mode !== 'carom';
    for (const k of ['pool', 'nine', 'ten', 'carom']) $('bl-help-' + k).hidden = mode !== k;
    paintStat();
  }
  pick('mode', (v) => { mode = v as Kind; syncMenu(); });
  pick('opp', (v) => { opp = v as 'bot' | 'two'; syncMenu(); });
  pick('level', (v) => { level = Number(v); });
  pick('goal', (v) => { goal = Number(v); });
  $('bl-start').addEventListener('click', () => { menu.hidden = true; gameEl.hidden = false; powerEl.value = '55'; aim.power = 0.55; $('bl-powv').textContent = '55'; newGame(); });
  $('bl-new').addEventListener('click', () => { newGame(); });
  $('bl-menu-btn').addEventListener('click', () => { gid++; phase = 'menu'; gameEl.hidden = true; menu.hidden = false; syncMenu(); });
  buildSprites();
  syncMenu();
  window.addEventListener('resize', () => { if (!gameEl.hidden) fit(); });

  // ---------- Vẽ ----------
  function drawBall(i: number) {
    const bx = M + world.x[i], by = M + world.y[i];
    g.save(); g.translate(bx, by); g.rotate(rot[i]); g.drawImage(patterns[i], -R, -R, 2 * R, 2 * R); g.restore();
    g.drawImage(shade, bx - R, by - R, 2 * R, 2 * R);
  }
  function draw() {
    if (!bg) return;
    g.setTransform(1, 0, 0, 1, 0, 0);
    g.drawImage(bg, 0, 0);
    g.setTransform(sc, 0, 0, sc, 0, 0);
    // vùng đặt bi
    if (phase === 'place' && pool.headOnly) { g.fillStyle = 'rgba(255,255,255,0.1)'; g.fillRect(M + 26, M, W * 0.25 - 26, H); g.fillRect(M, M + 26, 26, H - 52); } // chừa góc lỗ
    // bóng bi
    for (let i = 0; i < world.n; i++) if (world.alive[i]) g.drawImage(shadow, M + world.x[i] - R * 1.3 + 2.5, M + world.y[i] - R * 1.3 + 4, R * 2.6, R * 2.6);
    for (let i = 0; i < world.n; i++) if (world.alive[i]) drawBall(i);
    // bi đang rơi lỗ
    for (const s of sinks) {
      const k = Math.min(1, s.t / 0.35), e = k * k;
      const x = M + s.x + (s.px - s.x) * e, y = M + s.y + (s.py - s.y) * e, r = R * (1 - 0.7 * k);
      g.globalAlpha = 1 - k * 0.6;
      g.save(); g.translate(x, y); g.rotate(rot[s.id]); g.drawImage(patterns[s.id], -r, -r, 2 * r, 2 * r); g.restore();
      g.drawImage(shade, x - r, y - r, 2 * r, 2 * r);
      g.globalAlpha = 1;
    }
    // 10 bi: bi và lỗ đã gọi (vòng vàng), các lỗ có thể chọn (vòng trắng nhấp nháy)
    if (mode === 'ten' && call && !pool.breakPending && (phase === 'aim' || phase === 'aimbot' || phase === 'strike' || phase === 'roll')) {
      const pulse = 0.5 + 0.5 * Math.sin(performance.now() / 160);
      const pp = (i: number) => { const [hx, hy] = holeOf(POOL_POCKETS[i]); return [M + hx, M + hy]; };
      if (phase === 'aim' && isHuman(cur)) {
        for (let i = 0; i < POOL_POCKETS.length; i++) {
          if (i === call.pocket) continue;
          const [px, py] = pp(i);
          g.strokeStyle = `rgba(255,255,255,${0.35 + 0.4 * pulse})`; g.lineWidth = 3; g.setLineDash([6, 5]);
          g.beginPath(); g.arc(px, py, POOL_POCKETS[i].r + 6, 0, 7); g.stroke(); g.setLineDash([]);
        }
      }
      const bx = M + world.x[call.ball], by = M + world.y[call.ball], bAlive = !!world.alive[call.ball];
      if (call.pocket >= 0) {
        const [px, py] = pp(call.pocket);
        const cr = POOL_POCKETS[call.pocket].r + 7;
        g.fillStyle = 'rgba(255,196,40,.28)'; g.beginPath(); g.arc(px, py, cr, 0, 7); g.fill();
        g.strokeStyle = '#ffc428'; g.lineWidth = 4; g.beginPath(); g.arc(px, py, cr, 0, 7); g.stroke();
        if (bAlive) { g.strokeStyle = 'rgba(255,196,40,.7)'; g.lineWidth = 2; g.setLineDash([4, 6]); g.beginPath(); g.moveTo(bx, by); g.lineTo(px, py); g.stroke(); g.setLineDash([]); }
      }
      if (bAlive) { g.strokeStyle = '#ffc428'; g.lineWidth = 3; g.beginPath(); g.arc(bx, by, R + 5 + pulse * 1.5, 0, 7); g.stroke(); }
    }
    // ngắm và gậy
    const cid = cueId();
    const showAim = (phase === 'aim' || phase === 'aimbot' || phase === 'strike' || phase === 'place') && world.alive[cid];
    if (showAim) {
      const cx = M + world.x[cid], cy = M + world.y[cid];
      if (phase === 'place') {
        g.strokeStyle = 'rgba(255,255,255,.85)'; g.lineWidth = 2; g.setLineDash([5, 4]); g.beginPath(); g.arc(cx, cy, R + 5, 0, 7); g.stroke(); g.setLineDash([]);
      } else {
        const a = aim.angle, ca = Math.cos(a), sa = Math.sin(a);
        if (phase !== 'strike') {
          const rc = rayCast(world, cid, a);
          const ex = cx + ca * rc.t, ey = cy + sa * rc.t;
          g.lineWidth = 2; g.strokeStyle = 'rgba(255,255,255,.75)'; g.setLineDash([9, 7]);
          g.beginPath(); g.moveTo(cx + ca * (R + 2), cy + sa * (R + 2)); g.lineTo(ex, ey); g.stroke(); g.setLineDash([]);
          g.strokeStyle = 'rgba(255,255,255,.9)'; g.beginPath(); g.arc(ex, ey, R, 0, 7); g.stroke();
          if (rc.ball >= 0) {
            const tx = M + world.x[rc.ball], ty = M + world.y[rc.ball];
            const nx = (tx - ex) / (2 * R), ny = (ty - ey) / (2 * R);
            g.strokeStyle = 'rgba(255,225,120,.95)'; g.lineWidth = 2.4;
            g.beginPath(); g.moveTo(tx, ty); g.lineTo(tx + nx * 90, ty + ny * 90); g.stroke();
            const dot = ca * nx + sa * ny, tx2 = ca - dot * nx, ty2 = sa - dot * ny, tl = Math.hypot(tx2, ty2);
            if (tl > 0.08) { g.strokeStyle = 'rgba(255,255,255,.5)'; g.lineWidth = 1.6; g.beginPath(); g.moveTo(ex, ey); g.lineTo(ex + (tx2 / tl) * 55, ey + (ty2 / tl) * 55); g.stroke(); }
          }
        }
        g.save(); g.translate(cx, cy); g.rotate(a);
        g.drawImage(cueSpr, -(R + 5 + pull) - CUEL, -CUEH / 2, CUEL, CUEH);
        g.restore();
      }
    }
    // chữ kết thúc
    if (phase === 'over') {
      g.fillStyle = 'rgba(10,8,4,.45)'; g.fillRect(M, M, W, H);
      g.fillStyle = '#fff3d6'; g.font = 'bold 46px system-ui, Arial, sans-serif'; g.textAlign = 'center'; g.textBaseline = 'middle';
      g.shadowColor = 'rgba(0,0,0,.6)'; g.shadowBlur = 12;
      g.fillText(statusEl.textContent || '', LW / 2, LH / 2, W - 60);
      g.shadowBlur = 0;
    }
  }

  let last = performance.now();
  function update(dt: number) {
    if (phase === 'roll') {
      acc += Math.min(dt, 1 / 20);
      let n = 0;
      while (acc >= DT && n < 40) { step(world); acc -= DT; n++; rollSteps++; }
      handleEvents();
      for (let i = 0; i < world.n; i++) if (world.alive[i]) { const sp = Math.hypot(world.vx[i], world.vy[i]); if (sp > 0) rot[i] += (sp * dt / R) * 0.5 * (world.vx[i] >= 0 ? 1 : -1); }
      if (allStopped(world) || rollSteps > 480 * 40) {
        if (!allStopped(world)) { world.vx.fill(0); world.vy.fill(0); }
        handleEvents(); acc = 0;
        phase = 'roll'; endShot();
      }
    } else if (phase === 'strike') {
      strikeT += dt;
      const k = Math.min(1, strikeT / 0.11);
      pull = pullStart + (-8 - pullStart) * k * k;
      if (k >= 1) doShoot();
    } else if (phase === 'aim' || phase === 'aimbot') {
      const target = 8 + aim.power * 80;
      pull += (target - pull) * Math.min(1, dt * 14);
    }
    for (let i = sinks.length - 1; i >= 0; i--) { sinks[i].t += dt; if (sinks[i].t > 0.4) sinks.splice(i, 1); }
  }
  function frame(now: number) {
    requestAnimationFrame(frame);
    if (gameEl.hidden) { last = now; return; }
    const dt = Math.min(0.05, (now - last) / 1000); last = now;
    update(dt);
    draw();
  }
  requestAnimationFrame(frame);

  if (location.hash.includes('debug')) {
    (window as any).__bl = {
      start: (m: Kind = 'pool', o: 'bot' | 'two' = 'two', lv = 2) => { mode = m; opp = o; level = lv; menu.hidden = true; gameEl.hidden = false; newGame(); },
      get call() { return call; }, setCall: (ball: number, pocket: number) => { call = { ball, pocket }; refresh(); }, tap: (x: number, y: number) => { const tp = { x, y }; if (mode === 'ten' && !pool.breakPending && phase === 'aim') { if (pickPocket(tp)) return; pickBall(tp); } },
      get phase() { return phase; }, get cur() { return cur; }, get world() { return world; }, get pool() { return pool; }, get score() { return score; }, get aim() { return aim; },
      place: () => act(),
      shoot: (angle: number, power: number, sx = 0, sy = 0) => { if (phase === 'place') act(); aim.angle = angle; aim.power = power; aim.sx = sx; aim.sy = sy; startStrike(); },
      setAim: (angle: number, power: number) => { aim.angle = angle; aim.power = power; },
      status: () => statusEl.textContent,
      finish: (w: number, t = '') => finish(w, t),
      tick: (n = 1, dt = 1 / 60) => { for (let i = 0; i < n; i++) update(dt); },
    };
  }
</script>

<style is:global>
  #bl .bd-row { display: flex; flex-wrap: wrap; gap: 10px; }
  .bl-wrap { position: relative; width: min(100%, 1000px); margin: 0 auto; }
