---
import Base from '../../layouts/Base.astro';
import { lp, type Lang } from '../../i18n';
import { gamesUi } from '../../data/games';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const g = gamesUi[lang];

// Chữ hiển thị của game bida (/billiards/). Chỗ có {n}, {g} được thay lúc chạy.
const TX = {
  vi: {
    title: 'Bida',
    sub: 'Bida lỗ 8 bi, 9 bi, 10 bi và bida 3 băng. Ngắm, chỉnh lực, chỉnh xoáy bi rồi đánh. Đấu với máy hoặc chơi với bạn.',
    modePool: 'Bida lỗ 8 bi', modeNine: 'Bida 9 bi', modeTen: 'Bida 10 bi', modeCarom: 'Bida 3 băng',
    oppBot: 'Chơi với máy', oppTwo: 'Hai người một máy',
    level: 'Độ khó', levels: ['Dễ', 'Thường', 'Khó'],
    goal: 'Chơi tới', goals: ['5 điểm', '10 điểm', '15 điểm'],
    start: 'Bắt đầu', shoot: 'Đánh', place: 'Đặt bi', power: 'Lực', spin: 'Xoáy', again: 'Ván mới', menu: 'Menu', fine: 'Ngắm tinh',
    stats: 'Thắng / Thua với máy',
    helpPool: 'Luật rút gọn: đánh bi trắng vào bi của nhóm mình (đặc 1–7 hoặc vằn 9–15; nhóm được chia khi có người bỏ bi hợp lệ đầu tiên sau cú phá). Bỏ bi nhóm mình thì được đánh tiếp. Lỗi (bi trắng rơi lỗ, không chạm bi nào, chạm sai bi đầu tiên, không bi nào chạm băng) thì đối thủ được đặt bi trắng ở bất kỳ đâu. Bỏ hết nhóm rồi bỏ bi số 8 là thắng; bỏ 8 quá sớm hoặc lỗi khi bỏ 8 là thua.',
    helpNine: 'Bida 9 bi (bi 1–9, xếp hình thoi): luôn phải đánh trúng bi số nhỏ nhất còn trên bàn trước. Bỏ bi nào vào lỗ hợp lệ cũng được đánh tiếp; bỏ bi số 9 hợp lệ (kể cả cú phá hoặc đánh gián tiếp) là thắng ngay. Lỗi (bi trắng rơi lỗ, không chạm bi nào, chạm sai bi đầu tiên, không bi nào chạm băng) thì đối thủ được đặt bi trắng ở bất kỳ đâu; nếu bi 9 rơi lúc lỗi thì được đặt lại ở điểm chấm cuối bàn.',
    helpTen: 'Bida 10 bi (bi 1–10, xếp tam giác): giống 9 bi nhưng phải gọi bi và lỗ trước mỗi cú (trừ cú phá): bấm vào bi muốn bỏ rồi bấm vào lỗ. Chỉ bi đã gọi vào đúng lỗ đã gọi mới tính và được đánh tiếp; bi khác lỡ vào lỗ vẫn nằm xuống, hết lượt. Bi 10 vào đúng lỗ đã gọi là thắng; bi 10 rơi sai thì đặt lại ở điểm chấm.',
    helpCarom: 'Bi trắng của người 1, bi vàng của người 2, bi đỏ là bi chung. Được 1 điểm khi bi của bạn chạm cả hai bi còn lại và đã chạm băng ít nhất 3 lần trước khi chạm bi thứ hai. Ghi điểm thì đánh tiếp, hụt thì đổi lượt.',
    helpCtl: 'Điều khiển: kéo trên bàn để ngắm, kéo thanh Lực, chấm vào vòng tròn Xoáy (lên = bi chạy theo, xuống = bi kéo về, trái hoặc phải = xoáy ngang) rồi bấm Đánh. Bàn phím: ← → ngắm tinh, ↑ ↓ lực, Space để đánh.',
    you: 'Bạn', bot: 'Máy', p1: 'Người chơi 1', p2: 'Người chơi 2',
    solids: 'bi đặc', stripes: 'bi vằn', open: 'Chưa chia nhóm', eight: 'Bi số 8', white: 'Bi trắng', yellow: 'Bi vàng',
    turnOf: 'Lượt của {n}', yourTurn: 'Lượt của bạn', thinking: 'Máy đang ngắm...', rolling: 'Bi đang lăn...',
    placeBreak: 'Đặt bi trắng ở nửa trái bàn (sau vạch đầu bàn) rồi bấm "Đặt bi" để phá.',
    placeFree: '{n} được đặt bi trắng ở bất kỳ đâu: kéo bi rồi bấm "Đặt bi".',
    aimHint: 'Kéo trên bàn để ngắm, chỉnh lực rồi bấm Đánh.',
    callPrompt: 'Gọi bi và lỗ: bấm vào bi muốn bỏ, rồi bấm vào một lỗ.', callNeedPocket: 'Chưa gọi lỗ: bấm vào một lỗ trên bàn.', next: 'Bi nhỏ nhất', left: 'Còn', callLbl: 'Gọi',
    pockets: ['góc trên trái', 'góc trên phải', 'góc dưới trái', 'góc dưới phải', 'giữa trên', 'giữa dưới'],
    keepPot: 'Vào bi — {n} đánh tiếp.', wrongCall: 'Không vào đúng bi và lỗ đã gọi — lượt của {n}.', foulHand: '{n} được đặt bi trắng.', respotBall: 'Bi {b} được đặt lại ở điểm chấm.',
    foulScratch: 'Lỗi: bi trắng rơi lỗ.', foulNohit: 'Lỗi: bi trắng không chạm bi nào.', foulWrong: 'Lỗi: chạm sai bi đầu tiên.', foulNorail: 'Lỗi: không có bi nào chạm băng.', early8: 'Bi số 8 rơi lỗ không đúng luật.',
    assigned: '{n} đánh {g}.', point: '{n} ghi điểm — đánh tiếp!', miss: 'Hụt — lượt của {n}.', cushions: 'chạm băng {c} lần',
    winner: '{n} thắng!', youWin: 'Bạn thắng!', youLose: 'Bạn thua rồi.',
  },
  en: {
    title: 'Billiards',
    sub: '8-ball, 9-ball and 10-ball pool, plus three-cushion carom. Aim, set the power and spin, then shoot. Play the computer or a friend.',
    modePool: '8-ball pool', modeNine: '9-ball', modeTen: '10-ball', modeCarom: 'Three-cushion carom',
    oppBot: 'Play the computer', oppTwo: 'Two players, one device',
    level: 'Level', levels: ['Easy', 'Normal', 'Hard'],
    goal: 'Play to', goals: ['5 points', '10 points', '15 points'],
    start: 'Start', shoot: 'Shoot', place: 'Place ball', power: 'Power', spin: 'Spin', again: 'New game', menu: 'Menu', fine: 'Fine aim',
    stats: 'Wins / Losses vs computer',
    helpPool: 'Simplified rules: hit your own group first (solids 1–7 or stripes 9–15; groups are set when someone legally pockets the first ball after the break). Pocket one of yours and you shoot again. On a foul (cue ball pocketed, no ball hit, wrong ball hit first, no ball touches a rail) the opponent gets ball-in-hand. Clear your group, then pocket the 8 to win; pocketing the 8 too early or fouling on it loses.',
    helpNine: '9-ball (balls 1–9, diamond rack): you must always hit the lowest-numbered ball on the table first. Pocket any ball legally and you shoot again; legally pocketing the 9 (even on the break or by a combination) wins at once. On a foul (cue ball pocketed, no ball hit, wrong ball hit first, no ball touches a rail) the opponent gets ball-in-hand; if the 9 drops on a foul it is spotted again on the foot spot.',
    helpTen: '10-ball (balls 1–10, triangle rack): like 9-ball, but you must call a ball and a pocket before every shot (except the break): tap the ball you want to pocket, then tap a pocket. Only the called ball in the called pocket counts and keeps your turn; other balls that drop stay down and the turn passes. The 10 in the called pocket wins; a 10 pocketed any other way is spotted again.',
    helpCarom: 'Player 1 has the white ball, player 2 the yellow, red is shared. You score when your ball touches both other balls and has hit the cushions at least 3 times before touching the second ball. Score and you keep shooting; miss and the turn passes.',
    helpCtl: 'Controls: drag on the table to aim, drag the Power bar, tap the Spin circle (up = follow, down = draw, left or right = side spin), then press Shoot. Keyboard: ← → fine aim, ↑ ↓ power, Space to shoot.',
    you: 'You', bot: 'Computer', p1: 'Player 1', p2: 'Player 2',
    solids: 'solids', stripes: 'stripes', open: 'Table open', eight: '8 ball', white: 'White ball', yellow: 'Yellow ball',
    turnOf: '{n} to shoot', yourTurn: 'Your turn', thinking: 'Computer is aiming...', rolling: 'Balls rolling...',
    placeBreak: 'Place the cue ball in the left half (behind the head string), then press "Place ball" to break.',
    placeFree: '{n} has ball-in-hand: drag the cue ball anywhere, then press "Place ball".',
    aimHint: 'Drag on the table to aim, set the power, then press Shoot.',
    callPrompt: 'Call your shot: tap the ball you want to pocket, then tap a pocket.', callNeedPocket: 'No pocket called yet: tap a pocket on the table.', next: 'Lowest ball', left: 'Left', callLbl: 'Call',
    pockets: ['top-left corner', 'top-right corner', 'bottom-left corner', 'bottom-right corner', 'top side', 'bottom side'],
    keepPot: 'Pocketed — {n} shoots again.', wrongCall: 'Not the called ball and pocket — {n} to shoot.', foulHand: '{n} has ball-in-hand.', respotBall: 'Ball {b} is spotted again.',
    foulScratch: 'Foul: cue ball pocketed.', foulNohit: 'Foul: cue ball hit nothing.', foulWrong: 'Foul: wrong ball hit first.', foulNorail: 'Foul: no ball touched a rail.', early8: 'The 8 ball was pocketed illegally.',
    assigned: '{n} shoots {g}.', point: '{n} scores — shoots again!', miss: 'Miss — {n} to shoot.', cushions: '{c} cushions',
    winner: '{n} wins!', youWin: 'You win!', youLose: 'You lost.',
  },
};
const T = TX[lang];
---
<Base lang={lang} title={T.title} description={T.sub} noindex wide>
  <p class="meta"><a href={lp(lang, '/')}>{g.back}</a></p>
  <h1>{T.title}</h1>
  <p class="meta">{T.sub}</p>

  <div id="bl" data-ui={JSON.stringify(T)}>
    <div id="bl-menu">
      <div class="bd-row" id="bl-modes">
        <button type="button" class="bd-opt sel" data-mode="pool">🎱 {T.modePool}</button>
        <button type="button" class="bd-opt" data-mode="nine">🎱 {T.modeNine}</button>
        <button type="button" class="bd-opt" data-mode="ten">🎱 {T.modeTen}</button>
        <button type="button" class="bd-opt" data-mode="carom">⚪ {T.modeCarom}</button>
      </div>
      <div class="bd-row" id="bl-opps">
        <button type="button" class="bd-opt sel" data-opp="bot">{T.oppBot}</button>
        <button type="button" class="bd-opt" data-opp="two">{T.oppTwo}</button>
      </div>
      <div id="bl-botopts">
        <h2 class="bd-h">{T.level}</h2>
        <div class="bd-row">
          {T.levels.map((l, i) => <button type="button" class={`bd-opt${i === 1 ? ' sel' : ''}`} data-level={i + 1}>{l}</button>)}
        </div>
      </div>
      <div id="bl-goalopts" hidden>
        <h2 class="bd-h">{T.goal}</h2>
        <div class="bd-row">
          {T.goals.map((l, i) => <button type="button" class={`bd-opt${i === 1 ? ' sel' : ''}`} data-goal={[5, 10, 15][i]}>{l}</button>)}
        </div>
      </div>
      <p class="bd-stat" id="bl-stat"></p>
      <button class="btn" type="button" id="bl-start">▶ {T.start}</button>
      <p class="meta" id="bl-help-pool">{T.helpPool}</p>
      <p class="meta" id="bl-help-nine" hidden>{T.helpNine}</p>
      <p class="meta" id="bl-help-ten" hidden>{T.helpTen}</p>
      <p class="meta" id="bl-help-carom" hidden>{T.helpCarom}</p>
      <p class="meta">{T.helpCtl}</p>
    </div>

    <div id="bl-game" hidden>
      <div class="bl-wrap">
        <div class="bl-players">
          <div class="bl-player" id="bl-p0"></div>
          <div class="bl-player" id="bl-p1"></div>
        </div>
        <div class="bl-info" id="bl-info" hidden></div>
        <p class="bd-status" id="bl-status" aria-live="polite"></p>
        <div class="bl-stage"><canvas id="bl-cv" width="1128" height="628" aria-label="Billiards table"></canvas></div>
        <div class="bl-ctl" id="bl-ctl">
          <div class="bl-spin">
            <span class="bl-lbl">{T.spin}</span>
            <div class="bl-dial" id="bl-dial" aria-label={T.spin}><i class="bl-dot" id="bl-dot"></i></div>
          </div>
          <div class="bl-pow">
            <span class="bl-lbl">{T.power} <b id="bl-powv">55</b></span>
            <input type="range" id="bl-power" min="3" max="100" value="55" aria-label={T.power} />
            <div class="bl-fine">
              <button type="button" class="btn ghost sm" id="bl-left" aria-label={T.fine}>◀</button>
              <span class="bl-lbl">{T.fine}</span>
              <button type="button" class="btn ghost sm" id="bl-right" aria-label={T.fine}>▶</button>
            </div>
          </div>
          <button type="button" class="btn bl-shoot" id="bl-shoot">{T.shoot}</button>
        </div>
        <div class="bd-row bd-actions">
          <button type="button" class="btn ghost sm" id="bl-new">{T.again}</button>
          <button type="button" class="btn ghost sm" id="bl-menu-btn">{T.menu}</button>
        </div>
      </div>
    </div>
  </div>
</Base>

<script>
  import { W, H, R, DT, newWorld, rackPool, setupCarom, shoot, step, allStopped, canPlace, rayCast, resolvePool, resolveCarom, resolveRack, rackRows, respotBall, lowestBall, lastBall, ownLeft, typeOf, POOL_POCKETS, TC, TS, type World, type PoolState, type Call, type Kind } from '../../data/billiardsPhysics';
  import { chooseShot, type Job, type Shot } from '../../data/billiardsAI';
  import { sfx, mountMute } from '../../data/sfx';

  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const root = $('bl');
  const T = JSON.parse(root.dataset.ui || '{}') as Record<string, any>;
  const fmt = (s: string, o: Record<string, string | number>) => s.replace(/\{(\w+)\}/g, (_, k) => String(o[k] ?? ''));
  const menu = $('bl-menu'), gameEl = $('bl-game');
  const cv = $('bl-cv') as HTMLCanvasElement;
  const g = cv.getContext('2d')!;
  const statusEl = $('bl-status');
  const powerEl = $('bl-power') as HTMLInputElement;
  mountMute(document.querySelector('.bl-wrap') as HTMLElement);

  // ---------- Hình học vẽ ----------
  const M = 64;                    // độ rộng thành bàn (đơn vị logic)
  const LW = W + 2 * M, LH = H + 2 * M;
  let sc = 1;                      // số điểm ảnh thật cho mỗi đơn vị logic
  let bg: HTMLCanvasElement | null = null;

  // ---------- Trạng thái ----------
  type Phase = 'menu' | 'place' | 'aim' | 'think' | 'aimbot' | 'strike' | 'roll' | 'over';
  let mode: Kind = 'pool', opp: 'bot' | 'two' = 'bot', level = 2, goal = 10;
  let world: World = newWorld('pool');
  let pool: PoolState = { cur: 0, group: [0, 0], breakPending: true, inHand: true, headOnly: true };
  let cur = 0;
  let score = [0, 0];
  let phase: Phase = 'menu';
  const aim = { angle: 0, power: 0.55, sx: 0, sy: 0 };
  let pull = 10, pullStart = 10, strikeT = 0;
  let aliveBefore = new Uint8Array(16);
  let evi = 0, acc = 0, rollSteps = 0;
  let gid = 0;
  let note = '';                    // thông báo của lượt trước (lỗi, ghi điểm...)
  const rot = new Float64Array(16);
  const sinks: { id: number; x: number; y: number; px: number; py: number; t: number }[] = [];
  let stats: Record<string, { w: number; l: number }> = { pool: { w: 0, l: 0 }, nine: { w: 0, l: 0 }, ten: { w: 0, l: 0 }, carom: { w: 0, l: 0 } };
  let call: Call | null = null;     // 10 bi: bi và lỗ đã gọi
  const isRack = () => mode === 'nine' || mode === 'ten';
  try { const s = JSON.parse(localStorage.getItem('bl-stats') || 'null'); if (s) stats = { ...stats, ...s }; } catch {}

  const isHuman = (p: number) => opp === 'two' || p === 0;
  const cueId = () => (mode === 'carom' ? cur : 0);
  const nameOf = (p: number) => (opp === 'bot' ? (p === 0 ? T.you : T.bot) : (p === 0 ? T.p1 : T.p2));
  const groupName = (gp: number) => (gp === 1 ? T.solids : T.stripes);
  function paintStat() {
    const s = stats[mode];
    $('bl-stat').textContent = s.w + s.l ? `${T.stats}: ${s.w} / ${s.l}` : '';
  }
  function saveStats() { try { localStorage.setItem('bl-stats', JSON.stringify(stats)); } catch {} }

  // ---------- Sprite bi, gậy, nền bàn (vẽ sẵn một lần) ----------
  const BALL_COL = ['#f6f3e8', '#f2c200', '#1f4fbf', '#d8262a', '#6a2a96', '#f07a10', '#1f8a3a', '#8a1f2d', '#151515'];
  const SP = 64;
  const mk = (w: number, h: number) => { const c = document.createElement('canvas'); c.width = w; c.height = h; return c; };
  const patterns: HTMLCanvasElement[] = [];
  let shade: HTMLCanvasElement, shadow: HTMLCanvasElement, cueSpr: HTMLCanvasElement;
  const CUEL = 560, CUEH = 16;

  function circleClip(x: CanvasRenderingContext2D) { x.beginPath(); x.arc(SP / 2, SP / 2, SP / 2, 0, Math.PI * 2); x.clip(); }
  function buildSprites() {
    shade = mk(SP, SP);
    { const x = shade.getContext('2d')!; circleClip(x);
      // khối cầu: sáng phía trên trái, tối dần về mép, tối hơn ở đáy (che sáng), có chút ánh phản chiếu từ nỉ ở dưới phải
      const gr = x.createRadialGradient(23, 20, 2, 31, 31, 40);
      gr.addColorStop(0, 'rgba(255,255,255,0.5)'); gr.addColorStop(0.3, 'rgba(255,255,255,0.04)'); gr.addColorStop(0.7, 'rgba(0,0,0,0.2)'); gr.addColorStop(1, 'rgba(0,0,0,0.62)');
      x.fillStyle = gr; x.fillRect(0, 0, SP, SP);
      const ao = x.createRadialGradient(34, 38, 18, 32, 34, 34); ao.addColorStop(0, 'rgba(0,0,0,0)'); ao.addColorStop(1, 'rgba(0,0,0,0.3)');
      x.fillStyle = ao; x.fillRect(0, 0, SP, SP);
      const bounce = x.createRadialGradient(44, 48, 0, 44, 48, 12); bounce.addColorStop(0, 'rgba(120,255,170,0.16)'); bounce.addColorStop(1, 'rgba(120,255,170,0)');
      x.fillStyle = bounce; x.fillRect(0, 0, SP, SP);
      const soft = x.createRadialGradient(22, 19, 0, 22, 19, 15); soft.addColorStop(0, 'rgba(255,255,255,0.55)'); soft.addColorStop(1, 'rgba(255,255,255,0)');
      x.fillStyle = soft; x.fillRect(0, 0, SP, SP);
      const hl = x.createRadialGradient(20, 17, 0, 20, 17, 6.5); hl.addColorStop(0, 'rgba(255,255,255,1)'); hl.addColorStop(0.5, 'rgba(255,255,255,0.8)'); hl.addColorStop(1, 'rgba(255,255,255,0)');
      x.fillStyle = hl; x.fillRect(0, 0, SP, SP);
    }
    shadow = mk(80, 80);
    { const x = shadow.getContext('2d')!;
      const wide = x.createRadialGradient(40, 40, 10, 40, 40, 40); wide.addColorStop(0, 'rgba(0,0,0,0.34)'); wide.addColorStop(1, 'rgba(0,0,0,0)'); x.fillStyle = wide; x.fillRect(0, 0, 80, 80);
      const core = x.createRadialGradient(40, 40, 6, 40, 40, 22); core.addColorStop(0, 'rgba(0,0,0,0.6)'); core.addColorStop(1, 'rgba(0,0,0,0)'); x.fillStyle = core; x.fillRect(0, 0, 80, 80); }
    cueSpr = mk(CUEL * 2, CUEH * 2);
    { const x = cueSpr.getContext('2d')!; const L = CUEL * 2, Hh = CUEH * 2;
      // đầu gậy (bên phải) -> cán (bên trái); thân thon dần về phía đầu
      x.beginPath(); x.moveTo(0, 2); x.lineTo(L - 14, Hh / 2 - 5); x.lineTo(L - 14, Hh / 2 + 5); x.lineTo(0, Hh - 2); x.closePath();
      const sh = x.createLinearGradient(0, 0, L, 0);
      sh.addColorStop(0, '#2b1a0f'); sh.addColorStop(0.28, '#3b2415'); sh.addColorStop(0.3, '#c99a55'); sh.addColorStop(0.7, '#ecd09a'); sh.addColorStop(1, '#f6e4b8');
      x.fillStyle = sh; x.fill();
      x.fillStyle = '#f4f4f4'; x.fillRect(L - 20, Hh / 2 - 5, 8, 10);
      x.fillStyle = '#4f93c9'; x.fillRect(L - 12, Hh / 2 - 5, 12, 10);
      x.fillStyle = 'rgba(255,255,255,.28)'; x.fillRect(0, 3, L - 20, 2);
    }
  }
  function buildPatterns() {
    patterns.length = 0;
    const n = mode === 'pool' ? 16 : mode === 'nine' ? 10 : mode === 'ten' ? 11 : 3;
    for (let id = 0; id < n; id++) {
      const c = mk(SP, SP), x = c.getContext('2d')!;
      circleClip(x);
      if (mode !== 'carom') {
        if (id === 0) { x.fillStyle = BALL_COL[0]; x.fillRect(0, 0, SP, SP); x.fillStyle = '#d33'; for (const [px, py] of [[32, 12], [32, 52]]) { x.beginPath(); x.arc(px, py, 3.4, 0, 7); x.fill(); } }
        else {
          const col = BALL_COL[id <= 8 ? id : id - 8];
          if (id <= 8) { x.fillStyle = col; x.fillRect(0, 0, SP, SP); }
          else { x.fillStyle = '#f6f3e8'; x.fillRect(0, 0, SP, SP); x.fillStyle = col; x.fillRect(0, 17, SP, 30); }
          x.fillStyle = '#f6f3e8'; x.beginPath(); x.arc(32, 32, 14.5, 0, 7); x.fill();
          x.fillStyle = '#111'; x.font = 'bold 21px system-ui, Arial, sans-serif'; x.textAlign = 'center'; x.textBaseline = 'middle';
          x.fillText(String(id), 32, 33.8);
        }
      } else {
        x.fillStyle = id === 0 ? '#f6f3e8' : id === 1 ? '#f2c200' : '#d8262a'; x.fillRect(0, 0, SP, SP);
        if (id < 2) { x.fillStyle = id === 0 ? '#222' : '#a33'; for (const [px, py] of [[32, 11], [32, 53], [11, 32], [53, 32]]) { x.beginPath(); x.arc(px, py, 3.2, 0, 7); x.fill(); } }
      }
