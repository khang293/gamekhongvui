  .dg-x { border: 0; border-radius: 8px; width: 32px; height: 32px; background: #ffffff2a; color: #fff; cursor: pointer; flex: none; }

  .dg-board { position: relative; align-self: start; border-radius: 14px; overflow: hidden; border: 3px solid #6d3bc4; background: #fff; }
