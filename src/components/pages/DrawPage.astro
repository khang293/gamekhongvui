    .dg-players { grid-column: 1; grid-row: 2 / 5; grid-template-columns: minmax(0, 1fr); }
    .dg-board { grid-column: 2; grid-row: 2; }
    .dg-tools { grid-column: 2; grid-row: 3; }
    .dg-log { grid-column: 3; grid-row: 2; height: auto; min-height: 0; contain: size; }
    .dg-say { grid-column: 3; grid-row: 3; }
  }
  @media (max-width: 480px) {
    .dg-colors { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .dg-row button { width: 29px; height: 34px; font-size: 15px; }
    .dg-row .sep { width: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .dg-time.hurry { animation: none; } }
</style>
