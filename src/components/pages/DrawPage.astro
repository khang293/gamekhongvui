  .dg-over { position: absolute; inset: 0; z-index: 4; display: grid; place-items: center; background: rgba(20, 16, 48, .62); }
  .dg-over.low { background: rgba(20, 16, 48, .28); }
  .dg-box { width: min(92%, 380px); max-height: 94%; overflow: auto; padding: 12px 14px; border-radius: 16px; background: #1c1b45f2; color: #fff; text-align: center; border: 2px solid #ffe066; }
  .dg-box h2 { margin: 0 0 8px; font-size: 1.1rem; color: #ffe066; }
