  .dg-log p b { margin-right: 6px; color: var(--accent); }
  .dg-log .k-got { color: #2b8a3e; font-weight: 800; }
  .dg-log .k-secret { color: #2b8a3e; } .dg-log .k-secret b { color: inherit; }
