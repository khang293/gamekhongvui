---
import Base from '../../layouts/Base.astro';
import { lp, type Lang } from '../../i18n';
import { gamesUi } from '../../data/games';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const g = gamesUi[lang];
const T = {
  vi: {
    title: 'Còn Một!', sub: 'Trò đổ bài theo màu và số: chơi với máy hoặc với bạn bè qua phòng online, 2 đến 8 người. Bộ lá tự thiết kế.',
    opp: 'Số đối thủ (máy)', start: 'Chơi ngay', you: 'Bạn', bots: ['Gà', 'Mèo', 'Gấu Trúc', 'Cáo', 'Thỏ', 'Ếch', 'Cánh Cụt', 'Gấu'],
    onlineH: 'Chơi online với bạn bè', namePh: 'Tên của bạn', create: 'Tạo phòng', codePh: 'Mã phòng', join: 'Vào phòng', connecting: 'Đang kết nối...', defName: 'Người chơi',
    onlineNote: 'Phòng online chạy qua máy chủ Firebase của Google. Máy chủ phòng chia bài nên chỉ chơi với người quen.',
    roomCode: 'Mã phòng', copyCode: 'Chép mã', copyLink: 'Chép link mời', copied: 'Đã chép', seats: 'Số người ở bàn (chỗ trống do máy chơi)', timer: 'Giới hạn 30 giây mỗi lượt', startRoom: 'Bắt đầu', waitHost: 'Chờ chủ phòng bắt đầu', leave: 'Rời phòng', leaveConfirm: 'Rời phòng? Nếu bạn là chủ phòng, phòng sẽ đóng.', menuConfirm: 'Bỏ ván đang chơi?', hostTag: 'Chủ phòng', botTag: 'Máy',
    colors: ['Đỏ san hô', 'Vàng hổ phách', 'Xanh ngọc', 'Tím'], pickColor: 'Chọn màu', cancel: 'Thôi',
    call: '📣 Còn một!', catch: '👀 Bắt {n}!', pass: 'Bỏ lượt', menu: 'Menu', drawLabel: 'Rút bài', left: 'Còn {c} lá',
    dealing: 'Đang chia bài...', yourTurn: 'Đến lượt bạn.', turnOf: 'Đến lượt {n}.', noPlay: 'Không có lá đánh được: bấm chồng bài để rút.', drawnHint: 'Vừa rút được lá đánh được: đánh nó hoặc Bỏ lượt.', pending: 'Bạn bị +{k}: đè lên hoặc bấm chồng bài để rút {k}.', cant: 'Lá này không đánh được.', lost: 'Mất kết nối, đang nối lại...',
    shout: '{n}: CÒN MỘT!', caught: '{n} quên hô! +2', skip: '⊘ {n} mất lượt', reverse: '⇄ Đảo chiều', toColor: 'Đổi sang {c}',
    youWin: 'Bạn thắng!', wins: '{n} thắng!', score: 'Số ván thắng', again: 'Ván mới', waitNext: 'Chờ chủ phòng chia ván mới',
    errs: { noroom: 'Không tìm thấy phòng này.', full: 'Phòng đã đủ người.', started: 'Ván đã bắt đầu, không vào được nữa.', version: 'Hai máy đang dùng bản khác nhau, hãy tải lại trang.', timeout: 'Kết nối quá lâu, hãy thử lại.', network: 'Không kết nối được, hãy kiểm tra mạng rồi thử lại.', closed: 'Phòng đã đóng.', hostLeft: 'Chủ phòng đã rời, phòng đóng.', lost: 'Mất kết nối với phòng.', kicked: 'Bạn đã bị mời ra khỏi phòng.', badmsg: 'Mã này là phòng của trò khác.', badcode: 'Mã phòng gồm 5 ký tự.' },
    rulesTitle: 'Luật chơi', rules: [
      '2 đến 8 người, mỗi người 7 lá. Ai hết bài trước thắng ván.',
      'Đánh một lá cùng màu, cùng số hoặc cùng ký hiệu với lá trên bàn. Lá đổi màu đánh lúc nào cũng được rồi chọn màu mới.',
      '⊘ Cấm lượt người kế. ⇄ Đảo chiều (chơi 2 người thì như cấm lượt). +2 và +4: người kế phải rút bài và mất lượt.',
      'Cộng dồn: bị +2 được đè +2 hoặc +4; bị +4 chỉ đè được +4. Người không đè được rút tổng số lá.',
      'Không đánh được (hoặc không muốn đánh) thì rút 1 lá. Lá vừa rút đánh được thì được đánh ngay hoặc bỏ lượt.',
      'Còn 2 lá và sắp đánh một lá, hãy bấm "Còn một!". Quên hô mà bị người khác bấm "Bắt" trước khi người kế đi thì rút 2 lá.',
      'Hết lá cuối là thắng ngay, kể cả khi lá cuối là +2 hay +4.',
      'Bật đồng hồ trong phòng online: quá 30 giây thì tự rút bài và mất lượt.',
    ],
  },
  en: {
    title: 'Last Card!', sub: 'A colour and number shedding game against the computer or with friends in an online room, 2 to 8 players. Our own card design.',
    opp: 'Computer opponents', start: 'Play', you: 'You', bots: ['Chick', 'Cat', 'Panda', 'Fox', 'Bunny', 'Frog', 'Penguin', 'Bear'],
    onlineH: 'Play online with friends', namePh: 'Your name', create: 'Create room', codePh: 'Room code', join: 'Join', connecting: 'Connecting...', defName: 'Player',
    onlineNote: 'Online rooms run through Google Firebase. The host device deals the cards, so only play with people you know.',
    roomCode: 'Room code', copyCode: 'Copy code', copyLink: 'Copy invite link', copied: 'Copied', seats: 'Players at the table (empty seats are played by the computer)', timer: '30 second limit per turn', startRoom: 'Start', waitHost: 'Waiting for the host to start', leave: 'Leave room', leaveConfirm: 'Leave the room? If you are the host, the room closes.', menuConfirm: 'Abandon this game?', hostTag: 'Host', botTag: 'Computer',
    colors: ['Coral', 'Amber', 'Teal', 'Violet'], pickColor: 'Pick a colour', cancel: 'Cancel',
    call: '📣 Last card!', catch: '👀 Catch {n}!', pass: 'Pass', menu: 'Menu', drawLabel: 'Draw a card', left: '{c} cards left',
    dealing: 'Dealing...', yourTurn: 'Your turn.', turnOf: "{n}'s turn.", noPlay: 'Nothing to play: tap the pile to draw.', drawnHint: 'You drew a playable card: play it or Pass.', pending: 'You face +{k}: stack on it or tap the pile to draw {k}.', cant: 'That card cannot be played.', lost: 'Connection lost, reconnecting...',
    shout: '{n}: LAST CARD!', caught: '{n} forgot to call! +2', skip: '⊘ {n} is skipped', reverse: '⇄ Reverse', toColor: 'Now {c}',
    youWin: 'You win!', wins: '{n} wins!', score: 'Hands won', again: 'New hand', waitNext: 'Waiting for the host to deal',
    errs: { noroom: 'Room not found.', full: 'The room is full.', started: 'The game has already started.', version: 'The two devices run different versions, please reload.', timeout: 'Connecting took too long, try again.', network: 'Could not connect, check your network and try again.', closed: 'The room has closed.', hostLeft: 'The host left, the room is closed.', lost: 'Lost the connection to the room.', kicked: 'You were removed from the room.', badmsg: 'That code belongs to another game.', badcode: 'A room code has 5 characters.' },
    rulesTitle: 'Rules', rules: [
      '2 to 8 players with 7 cards each. First to empty their hand wins.',
      'Play a card of the same colour, number or symbol as the top card. A colour-change card can be played any time; pick the new colour.',
      '⊘ skips the next player. ⇄ reverses (with 2 players it skips). +2 and +4 make the next player draw and lose the turn.',
      'Stacking: on +2 you may play +2 or +4; on +4 only +4. Whoever cannot stack draws the total.',
      'If you cannot (or will not) play, draw 1. If the drawn card fits you may play it or pass.',
      'With 2 cards and about to play one, press "Last card!". If someone presses "Catch" before the next player moves, you draw 2.',
      'Playing your last card wins at once, even if it is a +2 or +4.',
      'With the room timer on, after 30 seconds you draw and lose the turn.',
    ],
  },
}[lang];
---
<Base lang={lang} title={T.title} description={T.sub} noindex wide>
  <p class="meta"><a href={lp(lang, '/')}>{g.back}</a></p>
  <h1>{T.title}</h1>
  <p class="meta">{T.sub}</p>

  <div id="cm-root" data-ui={JSON.stringify(T)}>
    <div id="cm-setup">
      <h2 class="bd-h">{T.opp}</h2>
      <div class="bd-row" id="cm-oppn">{[1, 2, 3, 4, 5, 6, 7].map((n) => <button type="button" class={`bd-opt${n === 3 ? ' sel' : ''}`} data-v={n}>{n}</button>)}</div>
      <p><button type="button" class="btn" id="cm-start">🃏 {T.start}</button></p>
      <div class="cm-online">
        <h2 class="bd-h">{T.onlineH}</h2>
        <div class="bd-row"><input id="cm-name" class="cm-input" type="text" maxlength="16" autocomplete="nickname" placeholder={T.namePh} aria-label={T.namePh} /><button type="button" class="btn" id="cm-create">🌐 {T.create}</button></div>
        <div class="bd-row"><input id="cm-code" class="cm-input cm-codein" type="text" maxlength="5" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder={T.codePh} aria-label={T.codePh} /><button type="button" class="btn ghost" id="cm-join">🔑 {T.join}</button></div>
        <p class="cm-err" id="cm-err" aria-live="polite"></p>
        <p class="meta">{T.onlineNote}</p>
      </div>
    </div>

    <div id="cm-lobby" hidden></div>

    <div id="cm-game" hidden>
      <p class="cm-roomline" id="cm-roomline" hidden></p>
      <div class="cm-table" id="cm-table" data-color="coral">
        <div class="cm-sky" id="cm-sky" aria-hidden="true"></div>
        <div class="cm-felt" aria-hidden="true"></div>
        <div class="cm-glow"></div>
        <svg class="cm-ring" viewBox="0 0 200 200" aria-hidden="true">
          <g fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round">
            <path d="M100 14A86 86 0 0 1 174 57"/><path d="M186 100A86 86 0 0 1 143 174"/><path d="M100 186A86 86 0 0 1 26 143"/><path d="M14 100A86 86 0 0 1 57 26"/>
          </g>
          <g fill="currentColor"><path d="M180 66l-14-3l9-11Z"/><path d="M134 180l3-14l11 9Z"/><path d="M20 134l14 3l-9 11Z"/><path d="M66 20l-3 14l-11-9Z"/></g>
        </svg>
        <div id="cm-opps"></div>
        <div class="cm-center">
          <button type="button" class="cm-pile" id="cm-draw" aria-label={T.drawLabel}></button>
          <div class="cm-discard" id="cm-discard"></div>
        </div>
        <div class="cm-me" id="cm-me"><span class="face"></span><b>{T.you}</b></div>
        <p class="cm-status" id="cm-status" aria-live="polite"></p>
        <div class="cm-hand" id="cm-hand"></div>
        <div class="cm-banner" id="cm-banner"></div>
        <div class="cm-picker" id="cm-picker" hidden></div>
        <div class="cm-over" id="cm-over" hidden></div>
      </div>
      <div class="cm-actions" id="cm-actions">
        <button type="button" class="btn" id="cm-call" hidden>{T.call}</button>
        <button type="button" class="btn" id="cm-catch" hidden></button>
        <button type="button" class="btn ghost" id="cm-pass" hidden>{T.pass}</button>
        <button type="button" class="btn ghost" id="cm-menu" aria-label={T.menu}>☰</button>
      </div>
    </div>
    <details class="cm-rules"><summary>{T.rulesTitle}</summary><ul>{T.rules.map((r) => <li>{r}</li>)}</ul></details>
  </div>
</Base>

<script>
  import { sfx, mountMute } from '../../data/sfx';
  import { DECK, matches } from '../../data/conmotEngine';
  import { CMGame, CMNetHost, CMNetClient, type CMNetState, type CMEvent } from '../../data/conmotNet';
  import { FirebaseTransport } from '../../data/net/firebaseTransport';
  import { mountChat, type ChatBox } from '../../data/net/chatUi';
  import { normCode, validCode, sanitizeName, realClock, RoomError } from '../../data/net/room';

  const root = document.getElementById('cm-root') as HTMLElement;
  const T = JSON.parse(root.dataset.ui || '{}');
  const LANG = document.documentElement.lang.startsWith('en') ? 'en' : 'vi';
  const fmt = (s: string, o: Record<string, string | number>) => s.replace(/\{(\w+)\}/g, (_, k) => String(o[k] ?? ''));
  type Color = 'coral' | 'amber' | 'teal' | 'violet';
  interface Card { c: Color | 'wild'; v: string }
  const COLORS: Color[] = ['coral', 'amber', 'teal', 'violet'];
  const MARK: Record<Color, string> = { coral: '▲', amber: '●', teal: '■', violet: '◆' };
  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const table = $('cm-table');
  const sleep = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));
  let fast = false; // thử tự động
  const still = () => fast || window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---------- vẽ lá bài ----------
  function symbol(v: string): string {
    if (v === 'skip') return '<svg viewBox="0 0 40 40"><circle cx="20" cy="20" r="14" fill="none" stroke="currentColor" stroke-width="6"/><path d="M10 30L30 10" stroke="currentColor" stroke-width="6"/></svg>';
    if (v === 'rev') return '<svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 18V15q0-5 5-5h19M26 4l7 6l-7 6"/><path d="M32 22v3q0 5-5 5H8M14 24l-7 6l7 6"/></svg>';
    if (v === 'd2') return '<svg viewBox="0 0 40 40"><rect x="5" y="8" width="16" height="23" rx="3" fill="currentColor" transform="rotate(-12 13 20)"/><rect x="18" y="9" width="16" height="23" rx="3" fill="currentColor" stroke="#fff" stroke-width="2.5" transform="rotate(10 26 20)"/></svg>';
    if (v === 'wild' || v === 'd4') return `<svg viewBox="-22 -22 44 44">${['#ff5a5f', '#ffb703', '#0fb5a6', '#7b4dff'].map((c, i) => `<path d="M0 0Q4 -20 19 -14Q18 -2 0 0Z" fill="${c}" transform="rotate(${i * 90})"/>`).join('')}<circle r="4.5" fill="#fff"/></svg>`;
    return `<b>${v}</b>`;
  }
  const corner = (v: string) => (v === 'skip' ? '⊘' : v === 'rev' ? '⇄' : v === 'd2' ? '+2' : v === 'd4' ? '+4' : v === 'wild' ? '✦' : v);
  function face(card: Card, extra = ''): string {
    const mark = card.c === 'wild' ? '✦' : MARK[card.c];
    return `<span class="cm-c ${card.c}${extra}"><i class="tl">${corner(card.v)}<small>${mark}</small></i><span class="mid${card.v === '6' || card.v === '9' ? ' under' : ''}">${symbol(card.v)}</span><i class="br">${corner(card.v)}<small>${mark}</small></i></span>`;
  }
  const back = (extra = '') => `<span class="cm-c back${extra}"><span class="logo">1<small>!</small></span></span>`;

  // ---------- nhân vật: bốn con thú tự vẽ ----------
  const eyes = (y = 30, dx = 9) => `<g class="eyes"><circle cx="${32 - dx}" cy="${y}" r="3.4" fill="#1d1d28"/><circle cx="${32 + dx}" cy="${y}" r="3.4" fill="#1d1d28"/><circle cx="${33.2 - dx}" cy="${y - 1.2}" r="1.1" fill="#fff"/><circle cx="${33.2 + dx}" cy="${y - 1.2}" r="1.1" fill="#fff"/></g>`;
  const cheeks = '<ellipse cx="15" cy="40" rx="4.6" ry="2.8" fill="#ff7b9c" opacity=".55"/><ellipse cx="49" cy="40" rx="4.6" ry="2.8" fill="#ff7b9c" opacity=".55"/>';
  const FACES: Record<string, string> = {
    cat: `<path d="M9 26L11 4L27 14Z" fill="#ffa94d"/><path d="M55 26L53 4L37 14Z" fill="#ffa94d"/><path d="M13 19L14 9L22 14Z" fill="#ffc9c9"/><path d="M51 19L50 9L42 14Z" fill="#ffc9c9"/><circle cx="32" cy="35" r="24" fill="#ffa94d"/><path d="M26 13v8M32 12v9M38 13v8" stroke="#e8590c" stroke-width="2.6" stroke-linecap="round"/><ellipse cx="32" cy="44" rx="12" ry="9" fill="#fff"/>${eyes()}<path d="M29 39h6l-3 3.4Z" fill="#e64980"/><path d="M32 42q-3 5-7 2M32 42q3 5 7 2M6 38l12 2M6 45l12-1M58 38l-12 2M58 45l-12-1" fill="none" stroke="#5c3a1e" stroke-width="1.4" stroke-linecap="round"/>${cheeks}`,
    panda: `<circle cx="13" cy="16" r="10" fill="#23232f"/><circle cx="51" cy="16" r="10" fill="#23232f"/><circle cx="32" cy="35" r="24" fill="#fff"/><ellipse cx="22" cy="31" rx="8" ry="9.5" fill="#23232f" transform="rotate(28 22 31)"/><ellipse cx="42" cy="31" rx="8" ry="9.5" fill="#23232f" transform="rotate(-28 42 31)"/><g class="eyes"><circle cx="23" cy="30" r="3.2" fill="#fff"/><circle cx="41" cy="30" r="3.2" fill="#fff"/><circle cx="23" cy="30.6" r="1.8" fill="#111"/><circle cx="41" cy="30.6" r="1.8" fill="#111"/></g><ellipse cx="32" cy="41" rx="4.4" ry="3" fill="#23232f"/><path d="M32 44q-3 5-7 1.6M32 44q3 5 7 1.6" fill="none" stroke="#23232f" stroke-width="1.8" stroke-linecap="round"/>${cheeks}`,
    fox: `<path d="M7 30L9 3L29 17Z" fill="#f76707"/><path d="M57 30L55 3L35 17Z" fill="#f76707"/><path d="M12 20L12.6 9L22 16Z" fill="#3b1f12"/><path d="M52 20L51.4 9L42 16Z" fill="#3b1f12"/><path d="M8 30Q14 12 32 12T56 30Q52 52 32 60Q12 52 8 30Z" fill="#f76707"/><path d="M9 33Q22 34 32 46Q42 34 55 33Q50 52 32 60Q14 52 9 33Z" fill="#fff"/>${eyes(31, 10)}<ellipse cx="32" cy="48" rx="4" ry="3" fill="#23232f"/>${cheeks}`,
    chick: `<circle cx="32" cy="35" r="24" fill="#ffd43b"/><path d="M26 13q2-10 8-7q-3 2-2 6q4-6 9-2q-5 1-5 5Z" fill="#fab005"/>${eyes(31, 10)}<path d="M25 39q7-6 14 0q-7 3-14 0Z" fill="#ff922b"/><path d="M26 40q6 8 12 0q-6 3-12 0Z" fill="#e8590c"/>${cheeks}`,
  };
  Object.assign(FACES, {
    rabbit: `<ellipse cx="21" cy="12" rx="7" ry="15" fill="#f1f3f5"/><ellipse cx="43" cy="12" rx="7" ry="15" fill="#f1f3f5"/><ellipse cx="21" cy="12" rx="3" ry="10" fill="#ffc9c9"/><ellipse cx="43" cy="12" rx="3" ry="10" fill="#ffc9c9"/><circle cx="32" cy="38" r="22" fill="#f8f9fa"/>${eyes(33, 9)}<ellipse cx="32" cy="41" rx="3.4" ry="2.4" fill="#e64980"/><path d="M32 43v4M32 47q-4 3-7 0M32 47q4 3 7 0" fill="none" stroke="#868e96" stroke-width="1.5" stroke-linecap="round"/><path d="M29 48h6v6h-6zM32 48v6" fill="#fff" stroke="#adb5bd" stroke-width="1"/>${cheeks}`,
    frog: `<circle cx="18" cy="18" r="11" fill="#51cf66"/><circle cx="46" cy="18" r="11" fill="#51cf66"/><ellipse cx="32" cy="38" rx="27" ry="21" fill="#51cf66"/><g class="eyes"><circle cx="18" cy="17" r="6.5" fill="#fff"/><circle cx="46" cy="17" r="6.5" fill="#fff"/><circle cx="19" cy="18" r="3.2" fill="#1d1d28"/><circle cx="45" cy="18" r="3.2" fill="#1d1d28"/></g><path d="M16 41q16 14 32 0" fill="none" stroke="#1b5e20" stroke-width="2.6" stroke-linecap="round"/>${cheeks}`,
    penguin: `<circle cx="32" cy="34" r="26" fill="#343a56"/><path d="M32 18q-8-8-15 1q-6 9 2 22q5 12 13 14q8-2 13-14q8-13 2-22q-7-9-15-1Z" fill="#fff"/>${eyes(30, 8)}<path d="M25 38h14l-7 8Z" fill="#ff922b"/>${cheeks}`,
    bear: `<circle cx="13" cy="17" r="10" fill="#a47148"/><circle cx="51" cy="17" r="10" fill="#a47148"/><circle cx="13" cy="17" r="5" fill="#e6c29a"/><circle cx="51" cy="17" r="5" fill="#e6c29a"/><circle cx="32" cy="35" r="24" fill="#a47148"/><ellipse cx="32" cy="43" rx="13" ry="10" fill="#e6c29a"/>${eyes(30, 10)}<ellipse cx="32" cy="39" rx="4.6" ry="3.2" fill="#3b2314"/><path d="M32 42q-3 6-7 2M32 42q3 6 7 2" fill="none" stroke="#3b2314" stroke-width="1.7" stroke-linecap="round"/>${cheeks}`,
  });
  const faceSvg = (k: string) => `<svg viewBox="0 0 64 64" aria-hidden="true">${FACES[k]}</svg>`;
  const SEAT_FACE = ['chick', 'cat', 'panda', 'fox', 'rabbit', 'frog', 'penguin', 'bear'];
  const HEX: Record<Color, string> = { coral: '#ff5a5f', amber: '#ffc233', teal: '#1fd1bd', violet: '#9d7bff' };

  // tia sáng và vòng sóng tại chỗ lá bài đáp xuống
  function burst(at: Element, hex: string, n = 22) {
    const r = at.getBoundingClientRect(), t = table.getBoundingClientRect();
    const box = document.createElement('div');
    box.className = 'cm-burst';
    box.style.left = r.left - t.left + r.width / 2 + 'px';
    box.style.top = r.top - t.top + r.height / 2 + 'px';
    box.style.setProperty('--h', hex);
    box.innerHTML = '<u></u><u></u>' + Array.from({ length: n }, (_, i) => {
      const a = (i / n) * Math.PI * 2 + Math.random() * 0.4, d = 70 + Math.random() * 90;
      return `<i style="--x:${(Math.cos(a) * d).toFixed(0)}px;--y:${(Math.sin(a) * d).toFixed(0)}px;--s:${(4 + Math.random() * 7).toFixed(0)}px;background:${i % 4 ? hex : '#fff'}"></i>`;
    }).join('');
    table.appendChild(box);
    setTimeout(() => box.remove(), 900);
  }
  function flash(hex: string) {
    const f = document.createElement('div');
    f.className = 'cm-flash';
    f.style.setProperty('--h', hex);
    table.appendChild(f);
    setTimeout(() => f.remove(), 700);
  }
  function bolts() {
    const box = document.createElement('div');
    box.className = 'cm-bolts';
    box.innerHTML = [12, 30, 70, 86].map((x, i) => `<svg style="left:${x}%;animation-delay:${i * 0.07}s" viewBox="0 0 40 160" aria-hidden="true"><path d="M22 0L6 72h12L8 160L36 62H22L34 0Z" fill="#ffe066" stroke="#fff" stroke-width="2"/></svg>`).join('');
    table.appendChild(box);
    setTimeout(() => box.remove(), 800);
  }
  $('cm-sky').innerHTML = Array.from({ length: 34 }, () => `<i style="left:${(Math.random() * 100).toFixed(1)}%;top:${(Math.random() * 100).toFixed(1)}%;--d:${(3 + Math.random() * 5).toFixed(1)}s;--w:-${(Math.random() * 6).toFixed(1)}s;--s:${(2 + Math.random() * 3).toFixed(1)}px"></i>`).join('');

  const spec = (id: number): Card => ({ c: DECK[id].c === 4 ? 'wild' : COLORS[DECK[id].c], v: DECK[id].v });

  // ---------- phiên chơi ----------
  let ctl: { kind: 'solo'; game: CMGame } | { kind: 'host'; host: CMNetHost } | { kind: 'client'; client: CMNetClient } | null = null;
  let cur: CMNetState | null = null;      // trạng thái đang vẽ
  let queue: CMNetState[] = [];
  let busy = false, lastEv = 0, gen = 0, sentSeq = -1, deadline = 0, lost = false, note = '';
  let chat: ChatBox | null = null;

  const nameOf = (i: number) => (cur && i === cur.mySlot ? T.you : cur?.slots[i]?.name || '?');
  const online = () => !!ctl && ctl.kind !== 'solo';
  function send(p: Record<string, unknown>) {
    if (!ctl) return;
    if (ctl.kind === 'solo') ctl.game.intent(0, p);
    else if (ctl.kind === 'host') ctl.host.send(p);
    else ctl.client.send(p);
  }
  /** nước đi trong lượt: mỗi trạng thái chỉ gửi một lần */
  function act(p: Record<string, unknown>) {
    if (!cur || busy || lost || sentSeq === cur.seq) return;
    sentSeq = cur.seq; note = '';
    send(p);
  }

  const show = (v: 'setup' | 'lobby' | 'game') => { $('cm-setup').hidden = v !== 'setup'; $('cm-lobby').hidden = v !== 'lobby'; $('cm-game').hidden = v !== 'game'; };
  function resetTable() {
    gen++; cur = null; queue = []; busy = false; lastEv = 0; sentSeq = -1; deadline = 0; lost = false; note = '';
    $('cm-opps').innerHTML = ''; $('cm-discard').innerHTML = ''; $('cm-hand').innerHTML = ''; $('cm-banner').innerHTML = '';
    $('cm-picker').hidden = true; $('cm-over').hidden = true; $('cm-roomline').hidden = true;
    delete $('cm-opps').dataset.key;
    table.querySelectorAll('.cm-fly, .cm-burst, .cm-flash, .cm-bolts, .cm-conf').forEach((x) => x.remove());
  }

  // ---------- nhận trạng thái ----------
  function onState(s: CMNetState) {
    if (!ctl) return;
    if (s.phase === 'lobby') {
      if (ctl.kind === 'solo') return;
      resetTable(); show('lobby'); renderLobby(s); return;
    }
    queue.push(s);
    void pump();
  }
  async function pump() {
    if (busy) return;
    busy = true;
    const g = gen;
    while (queue.length && g === gen) {
      const s = queue.shift()!;
      const first = !cur;
      if (first) { show('game'); $('cm-game').scrollIntoView({ block: 'start', behavior: 'instant' as ScrollBehavior }); } // đưa cả bàn và bài trên tay vào màn hình
      const ev = s.ev && s.ev.n > lastEv ? s.ev : null;
      if (s.ev) lastEv = s.ev.n;
      deadline = s.turnMs ? Date.now() + s.turnMs : 0;
      const animate = ev && !still() && queue.length < 3 && (!first || ev.kind === 'deal');
      if (animate && ev.kind === 'deal') await dealAnim(s);
      else if (animate) await before(s, ev);
      if (g !== gen) return;
      cur = s;
      render();
      if (ev && (!first || ev.kind === 'deal')) after(s, ev);
    }
    busy = false;
    if (cur && g === gen) render();
  }

  // ---------- vẽ ----------
  const pos = (i: number, k: number) => { // đối thủ thứ i (1..k) tính theo chiều đi, xếp vòng cung trái - trên - phải
    const t = Math.PI * (-0.1 + ((i - 0.5) / k) * 1.2);
    return { x: 50 - 41 * Math.cos(t), y: Math.max(1.5, 37 - 35 * Math.sin(t)) };
  };
  const seatEl = (seat: number) => (cur && seat === cur.mySlot ? $('cm-me') : (table.querySelector(`.cm-opp[data-seat="${seat}"]`) as HTMLElement | null));
  function renderOpps(s: CMNetState, counts: number[]) {
    const n = s.slots.length, k = n - 1, v = s.view!;
    const key = JSON.stringify([s.mySlot, counts, v.turn, v.called, s.phase, s.slots.map((p) => [p.name, p.online, p.wins])]);
    if ($('cm-opps').dataset.key === key) return;
    $('cm-opps').dataset.key = key;
    table.classList.toggle('many', k >= 5);
    $('cm-opps').innerHTML = Array.from({ length: k }, (_, j) => {
      const seat = (s.mySlot + j + 1) % n, p = s.slots[seat], c = counts[seat], at = pos(j + 1, k), shown = Math.min(c, 8);
      return `<div class="cm-opp${v.turn === seat && s.phase === 'play' ? ' on' : ''}${p.human && !p.online ? ' off' : ''}" data-seat="${seat}" style="left:${at.x.toFixed(1)}%;top:${at.y.toFixed(1)}%">
        <span class="face">${faceSvg(SEAT_FACE[seat])}</span><b>${p.name}${p.human && !p.online ? ' 📴' : ''}</b>
        <span class="fan">${Array.from({ length: shown }, (_, i) => back(` mini" style="--i:${i - (shown - 1) / 2}`)).join('')}</span>
        <span class="count${c <= 2 ? ' low' : ''}">${c}</span>${c === 1 && v.called[seat] ? `<span class="one">${LANG === 'en' ? 'Last card!' : 'Còn một!'}</span>` : ''}</div>`;
    }).join('');
  }
  function renderDiscard(recent: number[]) {
    $('cm-discard').innerHTML = recent.map((id) => face(spec(id), `" style="--r:${((id * 37) % 29) - 14}deg" data-id="${id}`)).join('');
  }
  const sortHand = (h: number[]) => h.slice().sort((a, b) => DECK[a].c - DECK[b].c || DECK[a].v.localeCompare(DECK[b].v) || a - b);
  const topOf = (s: CMNetState) => s.view!.recent[s.view!.recent.length - 1];
  const myMove = (s: CMNetState) => s.phase === 'play' && s.view!.turn === s.mySlot;
  const playable = (s: CMNetState, id: number) => myMove(s) && (s.view!.drawn === null || s.view!.drawn === id) && matches(id, topOf(s), s.view!.color, s.view!.pendingKind);
  function renderHand(s: CMNetState, hand: number[]) {
    const el = $('cm-hand'), n = hand.length;
    const narrow = window.matchMedia('(max-width: 640px)').matches, cw = narrow ? 72 : 84, W = table.clientWidth || 360;
    const rot = Math.min(3.2, 22 / Math.max(1, n));
    el.style.setProperty('--gap', Math.min(narrow ? 44 : 60, (W - cw - (narrow ? 62 : 120)) / Math.max(1, n - 1)).toFixed(1) + 'px');
    el.style.setProperty('--rot', rot.toFixed(2) + 'deg');
    el.style.setProperty('--arc', Math.min(1.6, 40 / Math.max(1, n * n)).toFixed(2) + 'px');
    el.innerHTML = sortHand(hand).map((id, i) => `<button type="button" class="cm-slot${playable(s, id) ? ' can' : ''}${s.view!.drawn === id ? ' drawn' : ''}" data-card="${id}" style="--i:${i - (n - 1) / 2}">${face(spec(id))}</button>`).join('');
  }
  function statusText(s: CMNetState) {
    const v = s.view!;
    if (lost) return T.lost;
    if (note) return note;
    if (s.phase === 'over') return v.winner === s.mySlot ? T.youWin : fmt(T.wins, { n: nameOf(v.winner) });
    const left = deadline ? Math.ceil((deadline - Date.now()) / 1000) : 0;
    const time = left > 0 && left <= 30 ? ` · ${left}s` : '';
    if (v.turn !== s.mySlot) return fmt(T.turnOf, { n: nameOf(v.turn) }) + time;
    if (v.pending) return fmt(T.pending, { k: v.pending }) + time;
    if (v.drawn !== null) return T.drawnHint + time;
    return (v.hand.some((id) => playable(s, id)) ? T.yourTurn : T.noPlay) + time;
  }
  function render() {
    const s = cur;
    if (!s || !s.view) return;
    const v = s.view;
    table.dataset.color = COLORS[v.color];
    table.classList.toggle('ccw', v.dir < 0);
    renderOpps(s, v.counts);
    renderDiscard(v.recent);
    renderHand(s, v.hand);
    $('cm-draw').innerHTML = back() + back() + back() + (v.pending ? `<span class="cm-badge">+${v.pending}</span>` : '') + `<span class="cm-pilecount">${fmt(T.left, { c: v.drawCount })}</span>`;
    const me = $('cm-me');
    me.classList.toggle('on', myMove(s));
    const faceBox = me.querySelector('.face') as HTMLElement;
    if (faceBox.dataset.f !== SEAT_FACE[s.mySlot]) { faceBox.dataset.f = SEAT_FACE[s.mySlot]; faceBox.innerHTML = faceSvg(SEAT_FACE[s.mySlot]); }
    $('cm-status').textContent = statusText(s);
    $('cm-call').hidden = !(s.phase === 'play' && !v.called[s.mySlot] && (v.catchable === s.mySlot || (v.turn === s.mySlot && v.hand.length === 2)));
    const c = s.phase === 'play' && v.catchable >= 0 && v.catchable !== s.mySlot;
    $('cm-catch').hidden = !c;
    if (c) $('cm-catch').textContent = fmt(T.catch, { n: nameOf(v.catchable) });
    $('cm-pass').hidden = !(myMove(s) && v.drawn !== null);
    $('cm-roomline').hidden = !online(); $('cm-roomline').textContent = `${T.roomCode}: ${s.code}`;
    if (!myMove(s)) $('cm-picker').hidden = true;
    renderOver(s);
  }
  function renderOver(s: CMNetState) {
    const el = $('cm-over');
    if (s.phase !== 'over' || busy) { el.hidden = true; el.dataset.key = ''; return; }
    const v = s.view!, key = `${s.round}|${s.slots.map((p) => p.wins)}`;
    if (el.dataset.key === key) { el.hidden = false; return; }
    el.dataset.key = key;
    const host = ctl?.kind !== 'client';
    const rows = s.slots.map((p, i) => ({ p, i })).sort((a, b) => b.p.wins - a.p.wins || a.i - b.i)
      .map(({ p, i }) => `<li><span>${i === v.winner ? '👑 ' : ''}${nameOf(i)}${p.human ? '' : ' 🤖'}</span><b>${p.wins}</b></li>`).join('');
    el.innerHTML = `<div class="cm-box"><h2>${v.winner === s.mySlot ? T.youWin : fmt(T.wins, { n: nameOf(v.winner) })}</h2><p>${T.score}</p><ul>${rows}</ul>
      <div class="row">${host ? `<button type="button" class="btn" data-over="next">${T.again}</button>` : `<span>${T.waitNext}</span>`}<button type="button" class="btn ghost" data-over="leave">${online() ? T.leave : T.menu}</button></div></div>`;
    el.hidden = false;
  }

  // ---------- hiệu ứng ----------
  function fly(html: string, from: Element, to: Element, ms = 420, spin = 200) {
    const a = from.getBoundingClientRect(), b = to.getBoundingClientRect(), t = table.getBoundingClientRect();
    const g = document.createElement('div');
    g.className = 'cm-fly';
    g.innerHTML = html;
    g.style.left = b.left - t.left + b.width / 2 + 'px';
    g.style.top = b.top - t.top + b.height / 2 + 'px';
    table.appendChild(g);
    const dx = a.left + a.width / 2 - (b.left + b.width / 2), dy = a.top + a.height / 2 - (b.top + b.height / 2);
    return g.animate([{ transform: `translate(-50%,-50%) translate(${dx}px,${dy}px) rotate(${-spin}deg)` }, { transform: 'translate(-50%,-50%)' }], { duration: ms, easing: 'cubic-bezier(.2,.75,.25,1)', fill: 'forwards' }).finished.then(() => g.remove()).catch(() => g.remove());
  }
  function banner(text: string, cls: string) {
    const b = $('cm-banner'), span = document.createElement('span');
    span.className = cls; span.textContent = text;
    b.innerHTML = ''; b.appendChild(span);
    setTimeout(() => span.remove(), 1500);
  }
  function confetti() {
    const cols = ['#ff5a5f', '#ffb703', '#0fb5a6', '#7b4dff', '#fff'];
    const box = document.createElement('div');
    box.className = 'cm-conf';
    box.innerHTML = Array.from({ length: 60 }, (_, i) => `<i style="left:${Math.random() * 100}%;background:${cols[i % 5]};animation-delay:${(Math.random() * 0.6).toFixed(2)}s"></i>`).join('');
    table.appendChild(box);
    setTimeout(() => box.remove(), 2800);
  }
  async function dealAnim(s: CMNetState) {
    const g = gen, v = s.view!;
    cur = s;
    $('cm-over').hidden = true; $('cm-picker').hidden = true; $('cm-hand').innerHTML = ''; $('cm-discard').innerHTML = '';
    $('cm-call').hidden = true; $('cm-catch').hidden = true; $('cm-pass').hidden = true;
    delete $('cm-opps').dataset.key;
    table.dataset.color = COLORS[v.color]; table.classList.remove('ccw');
    renderOpps(s, v.counts.map(() => 0));
    $('cm-draw').innerHTML = back() + back() + back();
    $('cm-status').textContent = T.dealing;
    const seats = Array.from({ length: s.slots.length }, (_, i) => i);
    for (let r = 0; r < 5 && g === gen; r++) {
      for (const i of seats) { const to = i === s.mySlot ? $('cm-hand') : seatEl(i); if (to) void fly(back(), $('cm-draw'), to, 320, 300); await sleep(240 / seats.length + 14); }
      sfx.play('flip', 0.35);
    }
    await sleep(340);
    if (g !== gen) return;
    delete $('cm-opps').dataset.key;
  }
  /** hiệu ứng chạy trước khi vẽ trạng thái mới (lá bay đi từ vị trí cũ) */
  async function before(s: CMNetState, ev: CMEvent) {
    const prev = cur!;
    if (ev.kind === 'play' && ev.card !== undefined) {
      const mine = ev.seat === prev.mySlot;
      const from = mine ? ($('cm-hand').querySelector(`[data-card="${ev.card}"]`) as HTMLElement | null) : seatEl(ev.seat);
      if (!from) return;
      if (mine) from.style.visibility = 'hidden';
      sfx.play('flip');
      await fly(face(spec(ev.card)), from, $('cm-discard'));
      return;
    }
    if (ev.kind === 'draw' || ev.kind === 'catch') {
      const seat = ev.kind === 'catch' ? ev.target! : ev.seat, count = ev.count || 1;
      const to = seat === prev.mySlot ? $('cm-hand') : seatEl(seat);
      if (ev.kind === 'catch') banner(fmt(T.caught, { n: nameOf(seat) }), 'turn');
      if (ev.penalty) {
        table.classList.remove('shake'); void table.offsetWidth; table.classList.add('shake');
        banner(`+${count}`, 'plus'); sfx.play('capture');
        if (count >= 4) { bolts(); flash('#ffe066'); }
        await sleep(300);
      }
      for (let k = 0; k < Math.min(count, 6) && to; k++) { sfx.play('flip', 0.45); await fly(back(), $('cm-draw'), to, 220, 300); }
    }
  }
  /** hiệu ứng chạy sau khi đã vẽ */
  function after(s: CMNetState, ev: CMEvent) {
    const v = s.view!, n = s.slots.length;
    if (ev.kind === 'play' && ev.card !== undefined) {
      const k = DECK[ev.card];
      burst($('cm-discard'), HEX[COLORS[v.color]]);
      if (k.c === 4) { flash(HEX[COLORS[v.color]]); banner(fmt(T.toColor, { c: T.colors[v.color] }), 'color'); }
      if (s.phase === 'play') {
        if (k.v === 'rev' && n > 2) { banner(T.reverse, 'turn'); sfx.play('swoosh'); }
        else if (k.v === 'skip' || (k.v === 'rev' && n === 2)) {
          const skipped = (((ev.seat + v.dir) % n) + n) % n;
          const el = seatEl(skipped);
          if (el && skipped !== s.mySlot) { el.classList.remove('blocked'); void el.offsetWidth; el.classList.add('blocked'); }
          banner(fmt(T.skip, { n: nameOf(skipped) }), 'turn'); sfx.play('lose', 0.4);
        } else if (k.v === 'd2' || k.v === 'd4') { banner(`+${v.pending}`, 'plus'); sfx.play('capture'); }
      } else {
        banner(v.winner === s.mySlot ? T.youWin : fmt(T.wins, { n: nameOf(v.winner) }), 'win');
        confetti(); sfx.play(v.winner === s.mySlot ? 'win' : 'lose');
      }
    } else if (ev.kind === 'call') { banner(fmt(T.shout, { n: nameOf(ev.seat) }), 'shout'); sfx.play('power'); }
    else if (ev.kind === 'catch' && (still() || ev.target === undefined)) banner(fmt(T.caught, { n: nameOf(ev.target ?? 0) }), 'turn');
  }

  // ---------- thao tác ----------
  $('cm-hand').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('.cm-slot');
    if (!b || !cur || busy) return;
    const id = Number(b.dataset.card);
    if (!playable(cur, id)) {
      b.classList.remove('no'); void b.offsetWidth; b.classList.add('no');
      if (myMove(cur)) { note = T.cant; $('cm-status').textContent = note; setTimeout(() => { note = ''; if (cur) $('cm-status').textContent = statusText(cur); }, 1500); }
      sfx.play('lose', 0.3);
      return;
    }
    if (DECK[id].c !== 4) return act({ type: 'play', card: id });
    const el = $('cm-picker');
    el.innerHTML = `<div class="cm-box"><h2>${T.pickColor}</h2><div class="cm-colors">${COLORS.map((c, i) => `<button type="button" data-color="${i}" style="background:${HEX[c]}">${MARK[c]} ${T.colors[i]}</button>`).join('')}</div><p><button type="button" class="btn ghost" data-color="-1">${T.cancel}</button></p></div>`;
    el.dataset.card = String(id);
    el.hidden = false;
  });
  $('cm-picker').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-color]'); if (!b) return;
    const c = Number(b.dataset.color), id = Number($('cm-picker').dataset.card);
    $('cm-picker').hidden = true;
    if (c >= 0) act({ type: 'play', card: id, color: c });
  });
  $('cm-draw').addEventListener('click', () => { if (cur && myMove(cur) && cur.view!.drawn === null) act({ type: 'draw' }); });
  $('cm-pass').addEventListener('click', () => act({ type: 'pass' }));
  // hô và bắt phải nhanh: gửi ngay cả khi đang chạy hiệu ứng
  $('cm-call').addEventListener('click', () => { $('cm-call').hidden = true; send({ type: 'call' }); });
  $('cm-catch').addEventListener('click', () => { $('cm-catch').hidden = true; send({ type: 'catch' }); });
  $('cm-over').addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLElement>('[data-over]')?.dataset.over;
    if (a === 'next') { $('cm-over').hidden = true; send({ type: 'next' }); }
    else if (a === 'leave') quit();
  });
  $('cm-menu').addEventListener('click', () => { if (confirm(online() ? T.leaveConfirm : T.menuConfirm)) quit(); });
  setInterval(() => { if (cur && deadline && !busy && !note) $('cm-status').textContent = statusText(cur); }, 500);
  window.addEventListener('resize', () => { if (cur && !busy) renderHand(cur, cur.view!.hand); });

  // ---------- chơi với máy ----------
  let opp = 3;
  $('cm-oppn').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button'); if (!b) return;
    $('cm-oppn').querySelectorAll('button').forEach((x) => x.classList.toggle('sel', x === b));
    opp = Number(b.dataset.v); sfx.play('click');
  });
  function startSolo() {
    teardown(); resetTable();
    const game: CMGame = new CMGame(realClock, { botNames: T.bots, timer: false, botMs: fast ? [30, 60] : undefined, onChange: () => { if (ctl?.kind === 'solo' && ctl.game === game) onState(game.stateFor(0)); } });
    ctl = { kind: 'solo', game };
    game.settings.n = opp + 1;
    game.setHuman(0, T.you);
    game.start();
  }
  $('cm-start').addEventListener('click', () => { sfx.play('click'); startSolo(); });

  // ---------- online ----------
  const ROOM_KEY = 'cm-room';
  const store = (k: string, v: string | null) => { try { if (v === null) localStorage.removeItem(k); else localStorage.setItem(k, v); } catch {} };
  const read = (k: string) => { try { return localStorage.getItem(k) || ''; } catch { return ''; } };
  const nameIn = $('cm-name') as HTMLInputElement, codeIn = $('cm-code') as HTMLInputElement;
  nameIn.value = read('xd-name') || read('tl-name');
  const myName = () => { const n = sanitizeName(nameIn.value, T.defName); store('xd-name', nameIn.value.trim()); return n; };
  const setErr = (r: string) => { $('cm-err').textContent = r ? (r === 'connecting' ? T.connecting : T.errs[r] || T.errs.network) : ''; };
  const peers = () => new FirebaseTransport();

  function openChat(say: (t: string) => void, mySlot: number, bind: (cb: (m: { slot: number; name: string; text: string }) => void) => void) {
    chat?.destroy();
    chat = mountChat(LANG, say);
    bind((m) => chat?.add(m, m.slot === mySlot));
  }
  function teardown() {
    const c = ctl; ctl = null;
    chat?.destroy(); chat = null;
    try { if (c?.kind === 'host') c.host.close(); else if (c?.kind === 'client') c.client.leave(); } catch {}
  }
  function toMenu(err = '') { teardown(); resetTable(); show('setup'); setErr(err); }
  function quit() { store(ROOM_KEY, null); toMenu(); }

  function renderLobby(s: CMNetState) {
    const host = ctl?.kind === 'host', el = $('cm-lobby');
    const list = s.slots.map((p, i) => `<li><span class="face">${faceSvg(SEAT_FACE[i])}</span><b>${p.name}</b>${p.human ? '' : `<em>${T.botTag}</em>`}${i === s.mySlot ? `<em>${T.you}</em>` : ''}${p.host ? `<em>👑 ${T.hostTag}</em>` : ''}</li>`).join('');
    el.innerHTML = `<div class="cm-codebox"><small>${T.roomCode}</small><b id="cm-bigcode">${s.code}</b><div class="bd-row"><button type="button" class="btn sm" data-copy="code">${T.copyCode}</button><button type="button" class="btn sm" data-copy="link">${T.copyLink}</button></div></div>
      ${host ? `<h2 class="bd-h">${T.seats}</h2><div class="bd-row">${[2, 3, 4, 5, 6, 7, 8].map((n) => `<button type="button" class="bd-opt${n === s.settings.n ? ' sel' : ''}" data-seats="${n}">${n}</button>`).join('')}</div><p><label><input type="checkbox" id="cm-timer"${s.settings.timer ? ' checked' : ''}> ${T.timer}</label></p>` : ''}
      <ul class="cm-plist">${list}</ul>
      <p class="bd-row">${host ? `<button type="button" class="btn" id="cm-startroom">${T.startRoom}</button>` : `<span class="meta">${T.waitHost}</span>`}<button type="button" class="btn ghost" id="cm-leave">${T.leave}</button></p>`;
    el.dataset.code = s.code;
  }
  $('cm-lobby').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button'); if (!b) return;
    const code = $('cm-lobby').dataset.code || '';
    if (b.dataset.copy) {
      navigator.clipboard?.writeText(b.dataset.copy === 'code' ? code : `${location.origin}${location.pathname}?room=${code}`).then(() => { b.textContent = T.copied; }).catch(() => {});
    } else if (b.dataset.seats && ctl?.kind === 'host') ctl.host.setSettings({ n: Number(b.dataset.seats) });
    else if (b.id === 'cm-startroom' && ctl?.kind === 'host') { sfx.play('click'); ctl.host.start(); }
    else if (b.id === 'cm-leave') quit();
  });
  $('cm-lobby').addEventListener('change', (e) => { const el = e.target as HTMLInputElement; if (el.id === 'cm-timer' && ctl?.kind === 'host') ctl.host.setSettings({ timer: el.checked }); });

  let connecting = false;
  const setBusy = (on: boolean) => { connecting = on; ($('cm-create') as HTMLButtonElement).disabled = on; ($('cm-join') as HTMLButtonElement).disabled = on; };
  async function createRoom() {
    if (connecting) return;
    setBusy(true); setErr('connecting'); teardown(); resetTable();
    try {
      const pending: CMNetState[] = [];
      const host: CMNetHost = await CMNetHost.create(peers, myName(), (s) => { if (ctl?.kind === 'host') onState(s); else pending.push(s); }, T.bots);
      ctl = { kind: 'host', host }; setErr('');
      openChat((t) => host.room.say(t), 0, (cb) => { host.room.onChat = cb; });
      const last = pending[pending.length - 1];
      if (last) onState(last);
    } catch { setErr('network'); }
    setBusy(false);
  }
  async function joinRoom(codeRaw: string, name: string, token = '') {
    const code = normCode(codeRaw);
    if (connecting) return;
    if (!validCode(code)) { setErr('badcode'); return; }
    setBusy(true); setErr('connecting'); teardown(); resetTable();
    const client: CMNetClient = new CMNetClient(peers, {
      onState: (s) => { if (ctl?.kind === 'client' && ctl.client === client) onState(s); },
      onStatus: (x) => { lost = x === 'lost'; if (cur) $('cm-status').textContent = statusText(cur); },
      onClosed: (r) => { if (ctl?.kind === 'client' && ctl.client === client) { store(ROOM_KEY, null); ctl = null; toMenu(r); } },
    });
    ctl = { kind: 'client', client };
    try {
      const info = await client.join(code, name, token);
      store(ROOM_KEY, JSON.stringify({ code, token: info.token, name, at: Date.now() }));
      openChat((t) => client.rc.say(t), info.slot, (cb) => { client.rc.onChat = cb; });
      setErr('');
    } catch (e) {
      ctl = null; store(ROOM_KEY, null);
      setErr(e instanceof RoomError ? e.reason : 'network');
    }
    setBusy(false);
  }
  $('cm-create').addEventListener('click', () => { sfx.play('click'); void createRoom(); });
  $('cm-join').addEventListener('click', () => { sfx.play('click'); void joinRoom(codeIn.value, myName()); });
  codeIn.addEventListener('input', () => { codeIn.value = normCode(codeIn.value); });
  window.addEventListener('pagehide', () => { if (ctl?.kind === 'host') { try { ctl.host.close(); } catch {} } });
  const invite = normCode(new URLSearchParams(location.search).get('room') || '');
  if (invite) codeIn.value = invite;
  try {
    const saved = JSON.parse(read(ROOM_KEY) || 'null');
    if (saved && saved.code && saved.token && Date.now() - saved.at < 30 * 60 * 1000 && (!invite || invite === saved.code)) void joinRoom(saved.code, saved.name, saved.token);
  } catch {}

  mountMute(table);
  if (location.hash === '#debug') (window as any).__cm = { get state() { return cur; }, get ctl() { return ctl; }, get busy() { return busy; }, send, setFast: (f: boolean) => { fast = f; } };
</script>

