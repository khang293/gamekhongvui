      'Rank points at the end of a hand: 1st +20, 2nd +10, 3rd −10, 4th −20, by finishing order. The first player to empty their hand finishes 1st but the hand goes on: finished players watch while those still holding cards keep playing until 2nd, 3rd and 4th place are known (the hand ends when only one player still holds cards). If the player who made the last play of a round has just finished and everyone else passes, the lead goes to the next player who still has cards.',
      'Chop points, cumulative: the chopped player loses them and the chopper gains them. Each black 2 is 10 points, each red 2 is 20 points (a pair or triple of 2s counts card by card). Chopping consecutive pairs is 20 points, chopping a four of a kind is 20 points.',
      'Stacked 2s: when several 2s are played over each other and then chopped, whoever played the last one pays the value of every 2 in the stack (pairs of 2s over pairs too); the earlier players lose nothing.',
      'Beating a four of a kind or consecutive pairs with a higher one of the same type (a higher quad over a lower quad, and so on) also counts as a chop and scores.',
      'Chop on chop, the last one pays it all: if a chop is itself chopped in the same round (2s, four of a kind, consecutive pairs), the player chopped last pays the value of the whole chain to the final chopper; those chopped earlier lose nothing.',
      'Finished players are exempt: if their last play is chopped, it can still be beaten to take the lead, but they lose nothing and the chopper gets nothing for it. In a chop-on-chop chain, if the player chopped last has already finished, no points move.',
      'Burned hand: when someone finishes first, anyone who has not played a single card pays 10 points to the winner (even if they play later).',
      'Pig penalty: 2s still in hand at the end are charged as if chopped (black 2: 10 points, red 2: 20 points each), paid to the winner.',
      'Instant win: the winner gets +30 and each of the other three loses 10; there are no chop points and no penalties.',
    ],
    ptsTarget: 'Target score', ptsCustom: 'Custom (10 to 1000)', ptsEndless: 'No target', ptsFour: 'This mode is always 4 players; empty seats are played by the computer.',
    targetInfo: 'Target {t}', noTarget: 'No target', ptsSettle: 'Points for this hand', ptsTotal: 'Total',
    chopKinds: { black: 'black 2', red: 'red 2', twos: '2s', quad: 'four of a kind', pairs: 'consecutive pairs' },
    chopPts: 'Chop {k} −{v}',
    rankLn: ['1st place', '2nd place', '3rd place', '4th place'], tagChopPts: 'Chopper', tagChoppedPts: 'Got chopped',
    finPlace: ['1st', '2nd', '3rd'], finBadge: ['🥇 1st', '🥈 2nd', '🥉 3rd', '4th'],
    finStatus: '{n} finished {p}, play continues.', finBanner: '{n} finished {p}!', specTitle: 'You finished {p}!', specWait: 'Waiting for the others to finish...',
    lnChopped: '{k} chopped: −{v} (pays {n})', lnChopOf: 'chopped {k}: +{v} (from {n})', lnChain: 'chop on chop',
    lnBurnPts: 'Burned hand (no card played): −{v} (pays {n})', lnBurnOf: 'burned-hand bonus: +{v} (from {n})', lnHeoPts: 'Left holding {k}: −{v} (pays {n})', lnHeoOf: 'left-over {k}: +{v} (from {n})', tagThoi: 'Penalty',
    ptsWinYou: 'You won the whole game with {p} points!', ptsWinOther: '{n} won the whole game with {p} points.', ptsEndNote: 'Ended at your request; the leader wins.',
    standings: 'Final standings', endBtn: 'End', confirmRestartPts: "Restart and reset everyone's points to 0?",
    // ----- Online -----
    homeCards: [
      { k: 'solo', ic: '🤖', t: 'Play the computer', d: 'Alone against 1 to 3 computer players' },
      { k: 'create', ic: '🌐', t: 'Create an online room', d: 'Send the room code to friends to play together' },
      { k: 'join', ic: '🔑', t: 'Join with a code', d: 'Enter the room code a friend sent you' },
    ],
    back: '← Back', yourName: 'Your name', namePh: 'Name (max 16 characters)',
    createBtn: 'Create room', joinBtn: 'Join room', roomCode: 'Room code', codePh: 'e.g. K7PQ2',
    creating: 'Creating the room...', joining: 'Joining the room...', rejoining: 'Reconnecting to room {c}...',
    createHelp: 'You are the host: your device runs the rules and holds everyone\'s cards. Empty seats are played by the computer.',
    joinHelp: 'Enter the 5-character code the host sent you.',
    lobbyTitle: 'Lobby', copyLink: 'Copy link', copyCode: 'Copy code', shareBtn: 'Share', copied: 'Copied!',
    seatsLbl: 'Seats', seatsHint: 'Empty seats are played by the computer.',
    hostTag: 'Host', youTag: 'You', botTag: 'Bot', onlineTag: 'Online', offlineTag: 'Disconnected', replacedTag: 'Bot playing',
    timerLbl: 'Turn timer', timerOpts: ['30 seconds', 'Off'],
    startOnline: 'Start the hand', waitHost: 'Waiting for the host to start...', leaveRoom: 'Leave room',
    lobbyNote: 'Online rooms run through Google\'s Firebase servers; the host runs the rules. In theory the host can see everyone\'s cards, so play with friends.',
    settingsSummary: 'Settings: {n} seats, {m}, bot level {l}.',
    errs: {
      noroom: 'Room not found. Check the code.', full: 'The room is full.', started: 'The hand has already started, nobody can join now.',
      version: 'Game version mismatch, please reload the page.', timeout: 'Could not reach the room server. Check your connection and try again.',
      network: 'Could not reach the room server. Check your connection and try again.', closed: 'The room has closed.', hostLeft: 'The host left, the room is closed.',
      kicked: 'You were removed from the room.', lost: 'Disconnected for too long, so you left the room.', badmsg: 'The room did not answer correctly. Try again later.',
      badcode: 'A room code has 5 characters (letters and digits).', create: 'Could not create the room. Check your connection and try again.',
    },
    connOk: 'Online', connLost: 'Connection lost, reconnecting...', connHost: 'Host', roomClosed: 'Room closed', toMenu: 'Back to menu',
    ready: 'Ready', readyWait: 'Ready, waiting for the others...', readyCount: '{a}/{b} ready', waitHostRestart: 'Waiting for the host to restart...', playAgain: 'Play again',
    spectating: 'You are out of chips and watching the rest.', offlineBot: 'offline, bot playing', timeoutTag: 'Timed out',
    youWinTable: 'You won the whole table!', loseTable: 'You are out of chips, the game is over.', tableWinner: '{n} won the whole table!',
  },
};
const T = TXT[lang];
const MODE_KEYS = ['chips', 'single', 'points'];
---
<Base lang={lang} title={T.title} description={T.sub} noindex wide>
  <div class="tl-head">
    <p class="meta"><a href={lp(lang, '/')}>{g.back}</a></p>
    <h1>{T.title}</h1>
    <p class="meta">{T.sub}</p>
  </div>

  <div id="tl" data-ui={JSON.stringify(T)}>
    <div id="tl-menu">
      <!-- Màn hình chính: ba cách chơi -->
      <div id="tl-v-home" class="tl-view">
        <div class="tl-homecards">
          {T.homeCards.map((c) => (
            <button type="button" class="tl-hc" data-go={c.k}>
              <span class="tl-hc-ic" aria-hidden="true">{c.ic}</span>
              <b>{c.t}</b>
              <small>{c.d}</small>
            </button>
          ))}
        </div>
        <p class="bd-stat" id="tl-stat"></p>
        <p class="tl-rejoin" id="tl-rejoin" hidden></p>
        <details class="tl-rules">
          <summary>{T.rulesTitle}</summary>
          <ul>{T.rules.map((r) => <li>{r}</li>)}</ul>
          <ul class="tl-chiprules">{T.chipRules.map((r) => <li>{r}</li>)}</ul>
          <ul class="tl-chiprules tl-ptsrules">{T.pointRules.map((r) => <li>{r}</li>)}</ul>
        </details>
        <p class="meta">{T.note}</p>
      </div>

      <!-- Chơi với máy -->
      <div id="tl-v-solo" class="tl-view" hidden>
        <button type="button" class="tl-back" data-go="home">{T.back}</button>
        <h2 class="bd-h">{T.mode}</h2>
        <div class="bd-row">
          {T.modes.map((l, i) => <button type="button" class={`bd-opt${i === 0 ? ' sel' : ''}`} data-mode={MODE_KEYS[i]}>{l}</button>)}
        </div>
        <div id="tl-chipopts">
          <h2 class="bd-h">{T.stackLbl}</h2>
          <div class="bd-row">
            {[500, 1000, 2000].map((v) => <button type="button" class={`bd-opt${v === 1000 ? ' sel' : ''}`} data-stack={v}>{v}</button>)}
          </div>
          <h2 class="bd-h">{T.unitLbl}</h2>
          <div class="bd-row">
            {[5, 10, 20].map((v) => <button type="button" class={`bd-opt${v === 10 ? ' sel' : ''}`} data-unit={v}>{v}</button>)}
          </div>
        </div>
        <div id="tl-ptsopts" hidden>
          <h2 class="bd-h">{T.ptsTarget}</h2>
          <div class="bd-row">
            {[50, 100, 200, 300].map((v) => <button type="button" class={`bd-opt${v === 100 ? ' sel' : ''}`} data-target={v}>{v}</button>)}
            <button type="button" class="bd-opt" data-target="0">{T.ptsEndless}</button>
          </div>
          <label class="tl-lbl" for="tl-target-custom">{T.ptsCustom}</label>
          <input id="tl-target-custom" class="tl-input tl-num" type="number" inputmode="numeric" min="10" max="1000" step="10" placeholder="10 - 1000" />
          <p class="meta tl-small">{T.ptsFour}</p>
        </div>
        <div id="tl-players-wrap">
          <h2 class="bd-h">{T.players}</h2>
          <div class="bd-row">
            {T.playersOpt.map((l, i) => <button type="button" class={`bd-opt${i === 2 ? ' sel' : ''}`} data-players={i + 2}>{l}</button>)}
          </div>
        </div>
        <h2 class="bd-h">{T.level}</h2>
        <div class="bd-row">
          {T.levels.map((l, i) => <button type="button" class={`bd-opt${i === 1 ? ' sel' : ''}`} data-level={i + 1}>{l}</button>)}
        </div>
        <p class="tl-gap"></p>
        <button class="btn" type="button" id="tl-start">▶ {T.start}</button>
      </div>

      <!-- Tạo phòng -->
      <div id="tl-v-create" class="tl-view" hidden>
        <button type="button" class="tl-back" data-go="home">{T.back}</button>
        <h2 class="bd-h">{T.homeCards[1].t}</h2>
        <p class="meta">{T.createHelp}</p>
        <label class="tl-lbl" for="tl-name-c">{T.yourName}</label>
        <input id="tl-name-c" class="tl-input" type="text" maxlength="16" autocomplete="nickname" placeholder={T.namePh} />
        <p class="tl-err" id="tl-err-c" role="alert" hidden></p>
        <button class="btn" type="button" id="tl-create">🌐 {T.createBtn}</button>
      </div>

      <!-- Vào phòng -->
      <div id="tl-v-join" class="tl-view" hidden>
        <button type="button" class="tl-back" data-go="home">{T.back}</button>
        <h2 class="bd-h">{T.homeCards[2].t}</h2>
        <p class="meta">{T.joinHelp}</p>
        <label class="tl-lbl" for="tl-code">{T.roomCode}</label>
        <input id="tl-code" class="tl-input tl-codeinput" type="text" maxlength="5" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder={T.codePh} />
        <label class="tl-lbl" for="tl-name-j">{T.yourName}</label>
        <input id="tl-name-j" class="tl-input" type="text" maxlength="16" autocomplete="nickname" placeholder={T.namePh} />
        <p class="tl-err" id="tl-err-j" role="alert" hidden></p>
        <button class="btn" type="button" id="tl-joinbtn">🔑 {T.joinBtn}</button>
      </div>

      <!-- Phòng chờ (chủ phòng và khách) -->
      <div id="tl-v-lobby" class="tl-view" hidden></div>
    </div>

    <!-- Bàn chơi -->
    <div id="tl-game" hidden>
      <div class="tl-wrap">
        <div class="tl-room" id="tl-room">
          <div class="tl-top">
            <button type="button" class="tl-mini-btn" id="tl-menu-btn" aria-label={T.menu}>☰ <span>{T.menu}</span></button>
            <span class="tl-conn" id="tl-conn" hidden></span>
            <span class="tl-pill" id="tl-roomcode" hidden></span>
            <span class="tl-pill" id="tl-handinfo"></span>
            <span class="tl-pill gold" id="tl-un"></span>
            <button type="button" class="tl-mini-btn push" id="tl-new" aria-label={T.again}>↻ <span>{T.again}</span></button>
          </div>
          <div class="tl-stage">
            <div class="tl-table" id="tl-table">
              <div class="tl-seat" id="tl-s-top" hidden></div>
              <div class="tl-seat" id="tl-s-left" hidden></div>
              <div class="tl-seat" id="tl-s-right" hidden></div>
              <div class="tl-line"></div>
              <div class="tl-mark" aria-hidden="true">gamekhongvui</div>
              <div class="tl-center">
                <div class="tl-pile" id="tl-pile"></div>
                <div class="tl-by" id="tl-by"></div>
              </div>
              <div class="tl-banner" id="tl-banner" hidden></div>
            </div>
          </div>
          <div class="tl-dock">
            <div class="tl-bar" id="tl-bar" hidden><span class="tl-me" id="tl-me"></span></div>
            <p class="tl-status" id="tl-status" aria-live="polite"></p>
            <div class="tl-timer" id="tl-timer" hidden><i></i></div>
            <div class="tl-hand" id="tl-hand" role="group"></div>
            <p class="tl-reason" id="tl-reason" aria-live="polite"></p>
            <div class="tl-actions">
              <button type="button" class="tl-btn pass" id="tl-skip">{T.pass}</button>
              <button type="button" class="tl-btn clr" id="tl-clear" aria-label={T.clear} title={T.clear}>✕</button>
              <button type="button" class="tl-btn go" id="tl-act">{T.play}</button>
              <button type="button" class="tl-btn hint" id="tl-hint">💡 {T.hint}</button>
            </div>
          </div>
          <div class="tl-over" id="tl-over" hidden></div>
          <div class="tl-closed" id="tl-closed" hidden></div>
        </div>
      </div>
    </div>
  </div>
</Base>

<script>
  import { detectCombo, canBeat, rankOf, suitOf, RANKS, SUITS, enumerateCombos, type Combo } from '../../data/tienlenEngine';
  import { botDecide } from '../../data/tienlenBot';
  import { chopValue, chopKind } from '../../data/tienlenScore';
  import { TLGame, TLNetHost, TLNetClient, TURN_MS, type NetState, type ResItem } from '../../data/tienlenNet';
  import { FirebaseTransport } from '../../data/net/firebaseTransport';
  import { mountChat, type ChatBox } from '../../data/net/chatUi';
  import { LoopbackHub } from '../../data/net/loopbackTransport';
  import { normCode, validCode, sanitizeName, escapeHtml as esc, realClock, RoomError, type RejectReason } from '../../data/net/room';
  import type { Transport } from '../../data/net/transport';
  import { sfx, mountMute } from '../../data/sfx';

  const root = document.getElementById('tl') as HTMLElement;
  const MODE_KEYS = ['chips', 'single', 'points'] as const;
  const T = JSON.parse(root.dataset.ui || '{}');
  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const menu = $('tl-menu'), gameEl = $('tl-game'), tableEl = $('tl-table'), pileEl = $('tl-pile'), byEl = $('tl-by');
  const statusEl = $('tl-status'), reasonEl = $('tl-reason'), handEl = $('tl-hand'), overEl = $('tl-over'), closedEl = $('tl-closed');
  const mainEl = document.querySelector('main') as HTMLElement | null;
  mountMute(document.querySelector('.tl-wrap') as HTMLElement);

  // ---------- Trạng thái chung ----------
  type Ctl = { kind: 'solo'; game: TLGame } | { kind: 'host'; host: TLNetHost } | { kind: 'client'; client: TLNetClient };
  let ctl: Ctl | null = null;
  let ns: NetState | null = null;
  let nsAt = 0;                 // giờ nhận bản trạng thái mới nhất (để chạy đồng hồ lượt)
  let sel = new Set<number>();
  let reasonMsg = '';
  let reasonKind: 'bad' | 'info' = 'bad';
  let lastEv = 0, lastCur = -1, lastHand = -1, lastHandKey = '';
  let finMsg = '', finUntil = 0; // thông báo ngắn khi có người về đích (chế độ tính điểm)
  const dockEl = document.querySelector('.tl-dock') as HTMLElement;
  let dealing = false, fast = false, inGame = false;
  let conn: 'online' | 'lost' = 'online';
  let hub: LoopbackHub | null = null;
  let stats = { w: 0, l: 0, best: 0, hw: 0 };
  try { const s = JSON.parse(localStorage.getItem('tl-stats') || 'null'); if (s) stats = { ...stats, ...s }; } catch {}
  const saveStats = () => { try { localStorage.setItem('tl-stats', JSON.stringify(stats)); } catch {} };
  function paintStat() {
    const a = stats.w + stats.l ? `${T.stats}: ${stats.w} / ${stats.l}` : '';
    const b = stats.best ? `${T.bestStack}: ${stats.best} · ${T.handsWon}: ${stats.hw}` : '';
    $('tl-stat').textContent = [a, b].filter(Boolean).join(' · ');
  }
  const fmt = (s: string, o: Record<string, string | number>) => s.replace(/\{(\w+)\}/g, (_, k) => String(o[k] ?? ''));
  const AV_COL = ['#2b6cb0', '#c05621', '#2f855a', '#805ad5'];
  const comboText = (c: Combo) => fmt(T.combo[c.type], { k: c.type === 'run' || c.type === 'pairs' ? c.len : 0 });

  // Lưu thông tin để nối lại phòng sau khi tải lại trang
  const ROOM_KEY = 'tl-room';
  const saveRoom = (o: { code: string; token: string; name: string } | null) => { try { if (o) localStorage.setItem(ROOM_KEY, JSON.stringify({ ...o, at: Date.now() })); else localStorage.removeItem(ROOM_KEY); } catch {} };
  const loadRoom = (): { code: string; token: string; name: string } | null => {
    try { const o = JSON.parse(localStorage.getItem(ROOM_KEY) || 'null'); if (o && o.code && o.token && Date.now() - o.at < 30 * 60 * 1000) return o; } catch {}
    return null;
  };
  const loadName = () => { try { return localStorage.getItem('tl-name') || ''; } catch { return ''; } };
  const saveName = (n: string) => { try { localStorage.setItem('tl-name', n); } catch {} };
  const defaultName = () => (loadName() || (document.documentElement.lang === 'en' ? 'Player ' : 'Người chơi ') + (100 + Math.floor(Math.random() * 900)));

  // ---------- Điều hướng giữa các màn hình ----------
  const VIEWS = ['home', 'solo', 'create', 'join', 'lobby'];
  function showView(v: string) {
    inGame = false; setPlaying(false);
    gameEl.hidden = true; menu.hidden = false;
    for (const k of VIEWS) ($('tl-v-' + k)).hidden = k !== v;
    mainEl?.classList.toggle('tl-lobbying', v !== 'home'); document.documentElement.classList.toggle('tl-lock', v !== 'home');
    if (v === 'home') paintStat();
  }
  function setPlaying(on: boolean) { mainEl?.classList.toggle('tl-playing', on); mainEl?.classList.remove('tl-lobbying'); document.documentElement.classList.toggle('tl-lock', on); if (on) requestAnimationFrame(() => { if (ns?.view) layoutHand(); }); }
  function showGame() { inGame = true; menu.hidden = true; gameEl.hidden = false; setPlaying(true); }

  document.querySelectorAll<HTMLElement>('[data-go]').forEach((b) => b.addEventListener('click', () => {
    const v = b.dataset.go as string;
    if (v === 'create') ($('tl-name-c') as HTMLInputElement).value = defaultName();
    if (v === 'join') { ($('tl-name-j') as HTMLInputElement).value = defaultName(); }
    showView(v);
    sfx.play('click');
  }));

  // ---------- Điều khiển ván: một lớp chung cho chơi máy, chủ phòng và khách ----------
  function sendIntent(p: { type: 'play'; cards: number[] } | { type: 'pass' } | { type: 'ready' } | { type: 'restart' } | { type: 'endsession' }) {
    if (!ctl) return;
    if (ctl.kind === 'solo') { ctl.game.intent(0, p); }
    else if (ctl.kind === 'host') { ctl.host.intentHost(p); }
    else if (p.type === 'play') ctl.client.play(p.cards);
    else if (p.type === 'pass') ctl.client.pass();
    else if (p.type === 'ready') ctl.client.ready();
    // 'restart' và 'endsession' chỉ dành cho chủ phòng / người chơi một mình
  }

  function onState(s: NetState) {
    const prev = ns;
    ns = s; nsAt = Date.now();
    if (s.phase === 'lobby') { if (ctl && ctl.kind !== 'solo') { if (!inGame || prev?.phase !== 'lobby') showView('lobby'); renderLobby(); } return; }
    if (!inGame) { showGame(); sel = new Set(); overEl.hidden = true; overEl.innerHTML = ''; closedEl.hidden = true; }
    if (prev && prev.phase === 'lobby') { sel = new Set(); }
    handleEvents(prev, s);
    renderGame();
  }

  // Âm thanh và hiệu ứng theo sự kiện mới
  function handleEvents(prev: NetState | null, s: NetState) {
    const ev = s.ev;
    if (s.hand !== lastHand) { lastHand = s.hand; lastHandKey = ''; sel = new Set(); overEl.hidden = true; overEl.innerHTML = ''; reasonMsg = ''; }
    if (ev && ev.n !== lastEv) {
      lastEv = ev.n;
      if (ev.kind === 'deal') { dealing = true; sfx.play('deal'); setTimeout(() => { dealing = false; handEl.querySelectorAll('.deal').forEach((e) => e.classList.remove('deal')); }, 900); }
      else if (ev.kind === 'chop') { sfx.play('hit'); flashBanner(s.settings.mode === 'points' && ev.vc && ev.vk ? fmt(T.chopPts, { k: T.chopKinds[chopKind(ev.vk, ev.vc)], v: ev.vv ?? chopValue(ev.vk, ev.vc) }) : T.chopBanner); pileEl.dataset.from = fromPos(ev.slot); retrigger(pileEl); }
      else if (ev.kind === 'play') { sfx.play(ev.slot === s.mySlot ? 'place' : 'tap'); pileEl.dataset.from = fromPos(ev.slot); retrigger(pileEl); }
      else if (ev.kind === 'pass') sfx.play('click');
      else if (ev.kind === 'timeout') { sfx.play('error'); }
      if (ev.place && s.settings.mode === 'points') {
        const nm = s.slots[ev.slot]?.name || '', pl = T.finPlace[ev.place - 1] || '';
        if (ev.slot !== s.mySlot) { finMsg = fmt(T.finStatus, { n: nm, p: pl }); finUntil = Date.now() + 2800; } // chính mình về đích thì đã có lời nhắn ở khu bài
        const medal = ['🥇', '🥈', '🥉'][ev.place - 1] || '';
        setTimeout(() => flashBanner(`${medal} ${fmt(T.finBanner, { n: ev.slot === s.mySlot ? T.you : nm, p: pl })}`), ev.kind === 'chop' ? 950 : 150);
        setTimeout(() => { if (inGame && ns && ns.view) renderStatus(); }, 2900);
        if (ev.slot === s.mySlot) sfx.play('correct');
      }
    }
    const v = s.view;
    if (v && s.phase === 'playing' && !v.over) {
      const myTurn = s.mySeat >= 0 && v.cur === s.mySeat;
      if (myTurn && lastCur !== v.cur) sfx.play('turn');
      lastCur = v.cur;
    } else lastCur = -1;
  }
  const retrigger = (el: HTMLElement) => { el.classList.remove('tl-in'); void el.offsetWidth; el.classList.add('tl-in'); };
  function flashBanner(text: string) {
    const b = $('tl-banner'); b.textContent = text; b.hidden = false; b.classList.remove('show'); void b.offsetWidth; b.classList.add('show');
    setTimeout(() => { b.hidden = true; }, 1500);
  }

  // ---------- Vị trí chỗ ngồi (tính theo ghế của mình) ----------
  function posOf(slot: number): 'top' | 'left' | 'right' | 'bottom' {
    if (!ns) return 'top';
    const n = ns.settings.n, k = (slot - ns.mySlot + n) % n;
    if (k === 0) return 'bottom';
    if (n === 2) return 'top';
    if (n === 3) return k === 1 ? 'right' : 'left';
    return k === 1 ? 'right' : k === 2 ? 'top' : 'left';
  }
  const fromPos = (slot: number) => posOf(slot);

  // ---------- Vẽ lá bài ----------
  const isRed = (c: number) => suitOf(c) >= 2;
  function cardHTML(c: number, cls = '', style = '') {
    const r = rankOf(c), s = SUITS[suitOf(c)], rk = RANKS[r];
    const face = r >= 8 && r <= 10 ? `<span class="tl-face"><b>${rk === 'J' ? 'J' : rk === 'Q' ? 'Q' : 'K'}</b></span>` : `<span class="tl-cm">${s}</span>`;
    return `<button type="button" class="tl-card ${isRed(c) ? 'red' : 'blk'} ${cls}" data-c="${c}" style="${style}" aria-label="${rk}${s}"><span class="tl-ci"><b>${rk}</b><i>${s}</i></span>${face}<span class="tl-cj"><b>${rk}</b><i>${s}</i></span></button>`;
  }
  const miniHTML = (c: number, cls = '') => `<span class="tl-mini ${isRed(c) ? 'red' : 'blk'} ${cls}"><b>${RANKS[rankOf(c)]}</b><i>${SUITS[suitOf(c)]}</i></span>`;
  const backs = (n: number) => `<span class="tl-backs">${Array.from({ length: Math.min(n, 13) }, (_, i) => `<i style="--i:${i}"></i>`).join('')}</span>`;
  const pileCard = (c: number) => `<span class="tl-pc ${isRed(c) ? 'red' : 'blk'}"><b>${RANKS[rankOf(c)]}</b><i>${SUITS[suitOf(c)]}</i><em>${SUITS[suitOf(c)]}</em></span>`;

  // ---------- Vẽ bàn ----------
  const chipsMode = () => !!ns && ns.settings.mode === 'chips' && !!ns.stacks;
  const pointsMode = () => !!ns && ns.settings.mode === 'points' && !!ns.points;
  let prevStacks: number[] = [];
  let prevTotals: number[] = [];
  // Điểm cộng dồn của một người (chế độ tính điểm); đổi điểm thì nháy xanh hoặc đỏ
  function scorePill(slot: number, big = false) {
    if (!pointsMode() || !ns!.points) return '';
    const cur = ns!.points.totals[slot], prev = prevTotals[slot];
    const chg = prev !== undefined && prev !== cur ? (cur > prev ? ' up' : ' dn') : '';
    return `<span class="tl-chip pts${cur < 0 ? ' neg' : ''}${big ? ' big' : ''}${chg}">⭐ ${cur}</span>`;
  }
  function chipPill(slot: number) {
    if (pointsMode()) return scorePill(slot);
    if (!chipsMode() || !ns!.stacks) return '';
    const cur = ns!.stacks[slot], prev = prevStacks[slot];
    const chg = prev !== undefined && prev !== cur ? (cur > prev ? ' up' : ' dn') : '';
    return `<span class="tl-chip${chg}">🪙 ${cur}</span>`;
  }

  function renderSeats() {
    const s = ns!, v = s.view!;
    const slots: Record<string, HTMLElement> = { top: $('tl-s-top'), left: $('tl-s-left'), right: $('tl-s-right') };
    for (const k in slots) { slots[k].hidden = true; slots[k].innerHTML = ''; slots[k].className = 'tl-seat'; }
    const n = s.settings.n;
    for (let slot = 0; slot < n; slot++) {
      if (slot === s.mySlot) continue;
      const el = slots[posOf(slot)];
      if (!el) continue;
      const ps = s.slots[slot];
      el.hidden = false;
      const seat = s.seats.indexOf(slot);
      const name = esc(ps.name);
      const human = ps.kind === 'human';
      const tags: string[] = [];
      if (ps.host) tags.push(`<span class="tl-tag host">${T.hostTag}</span>`);
      if (human && !ps.online) tags.push(`<span class="tl-tag off">${T.offlineTag}</span>`);
      else if (human && ps.replaced) tags.push(`<span class="tl-tag bot">${T.replacedTag}</span>`);
      const col = AV_COL[slot % 4];
      if (seat < 0) {
        el.className = 'tl-seat out';
        el.innerHTML = `<span class="tl-avw"><span class="tl-av" style="--c:#6b7280">${esc([...ps.name][0] || '?')}</span></span><span class="tl-nm">${name}</span><span class="tl-chip dn">${T.chipsOut}</span>`;
        continue;
      }
      const on = !v.over && v.cur === seat;
      const left = v.counts[seat];
      const win = v.over && v.winner === seat;
      const place = v.multi ? v.finished.indexOf(seat) : -1; // chế độ nhiều hạng: hạng đã về đích (0 = nhất)
      const done = place >= 0 && (place < 3 || !!v.over);
      el.className = 'tl-seat' + (on ? ' on' : '') + (win ? ' win' : '') + (done ? ' fin' : '') + (human && (!ps.online || ps.replaced) ? ' away' : '');
      const cards = v.over && v.hands ? `<span class="tl-rev">${v.hands[seat].map((c) => miniHTML(c)).join('')}</span>` : done ? '' : backs(left);
      const finTag = done ? `<span class="tl-fin p${place}">${T.finBadge[Math.min(place, 3)]}</span>` : '';
      const pass = v.passed[seat] && !v.over && !done ? `<span class="tl-pass">${T.passedTag}</span>` : '';
      const cnt = done && place < 3 ? `<span class="tl-cnt medal">${['🥇', '🥈', '🥉'][place]}</span>` : `<span class="tl-cnt">${left}</span>`;
      el.innerHTML = `<span class="tl-avw${on ? ' ring' : ''}"><span class="tl-av" style="--c:${col}">${esc([...ps.name][0] || '?')}</span>${cnt}${pass}</span><span class="tl-nm">${name}${human ? '' : ' <small>🤖</small>'}</span>${chipPill(slot)}${tags.join('')}${finTag}${cards}`;
    }
  }

  function renderPile() {
    const v = ns!.view!;
    if (!v.table) { pileEl.innerHTML = ''; byEl.textContent = v.over ? '' : T.free; return; }
    const lastLog = v.log.length ? v.log[v.log.length - 1] : null;
    const chop = !!(lastLog && lastLog.chop && lastLog.seat === v.tableBy);
    const slot = ns!.seats[v.tableBy];
    const nm = esc(ns!.slots[slot]?.name || '');
    pileEl.innerHTML = v.table.cards.map(pileCard).join('');
    pileEl.classList.toggle('chop', chop);
    byEl.innerHTML = (chop ? fmt(T.chopped, { n: nm }) + ' ' : fmt(T.playedBy, { n: nm }) + ' ') + '· ' + comboText(v.table);
  }

  // Xếp bài: màn hình rộng thì một hàng cong nhẹ; màn hình hẹp (điện thoại) thì hai hàng chồng lệch để mỗi lá đủ to và đủ chỗ chạm
  function layoutHand() {
    const cards = Array.from(handEl.querySelectorAll<HTMLElement>('.tl-card'));
    const n = cards.length;
    const W = handEl.clientWidth || 320;
    const narrow = W < 700;
    const lift = narrow ? 22 : 26;
    const two = narrow && n > 7;
    const perRow = two ? Math.ceil(n / 2) : n;
    // Kích thước lá tính theo hàng đầy đủ (7 lá ở điện thoại) để lá không đổi cỡ khi bài ít dần; mỗi lá luôn lộ ra >= 45px để chạm
    let cw: number, step: number;
    if (narrow) {
      cw = Math.max(52, Math.min(74, Math.floor(W - 8 - 45.5 * 6)));
      step = perRow > 1 ? Math.min(cw * 0.8, (W - 8 - cw) / (perRow - 1)) : 0;
    } else {
      cw = Math.max(58, Math.min(90, Math.floor(W / 11.2)));
      step = n > 1 ? Math.min(cw * 0.72, (W - 8 - cw) / (n - 1)) : 0;
    }
    // không để bài chiếm quá nhiều chiều cao màn hình
    const maxH = window.innerHeight * (narrow ? 0.34 : 0.3);
    const full = () => cw * 1.4 + (narrow ? cw * 0.64 : 18) + lift + 8;
    while (full() > maxH && cw > 50) { cw -= 2; if (narrow) step = Math.min(step, (W - 8 - cw) / Math.max(1, perRow - 1)); }
    const ch = cw * 1.4, dy = narrow ? ch * 0.46 : 0, arc = 0.5, rot = 1.3;
    handEl.style.setProperty('--cw', cw + 'px');
    handEl.style.height = Math.ceil(lift + 2 + ch + dy + (narrow ? 0 : 18) + 6) + 'px'; // chiều cao cố định: bàn không bị nhảy khi đánh bài
    handEl.dataset.mode = two ? 'two' : 'one';
    if (!n) return;
    const rowOf = (i: number) => (two && i >= perRow ? 1 : 0);
    const rowCnt = [two ? perRow : n, two ? n - perRow : 0];
    cards.forEach((el, i) => {
      const r = rowOf(i), idx = r === 0 ? i : i - perRow;
      const rowW = cw + (rowCnt[r] - 1) * step;
      const x = (W - rowW) / 2 + idx * step;
      const o = narrow ? 0 : i - (n - 1) / 2;
      const rowY = narrow ? (two ? r * dy : dy) : 0; // ít lá: một hàng nằm ở hàng dưới, sát các nút
      el.style.setProperty('--x', x.toFixed(1) + 'px');
      el.style.setProperty('--y', (lift + 2 + rowY).toFixed(1) + 'px');
      el.style.setProperty('--ty', (o * o * arc).toFixed(1) + 'px');
      el.style.setProperty('--r', (o * rot).toFixed(2) + 'deg');
      el.style.setProperty('--z', String(r * 30 + idx));
    });
  }

  // Người chơi đã hết bài sớm (chế độ nhiều hạng) thì ngồi xem tiếp, khu bài của mình hiện lời nhắn thay cho bài
  function spectating(): boolean {
    const s = ns;
    return !!s && !!s.view && !!s.view.multi && s.phase === 'playing' && !s.view.over && s.mySeat >= 0 && s.view.finished.indexOf(s.mySeat) >= 0;
  }
  function renderHand() {
    const v = ns!.view!;
    if (spectating()) {
      const p = v.finished.indexOf(ns!.mySeat);
      const key = '__spec' + p;
      if (lastHandKey !== key) {
        lastHandKey = key; sel = new Set();
        handEl.innerHTML = `<div class="tl-spec"><b>${['🥇', '🥈', '🥉'][p] || ''} ${fmt(T.specTitle, { p: T.finPlace[p] || '' })}</b><span>${T.specWait}</span></div>`;
      }
      dockEl.classList.add('spec');
      return;
    }
    dockEl.classList.remove('spec');
    const hand = v.hand;
    for (const c of [...sel]) if (!hand.includes(c)) sel.delete(c);
    const key = hand.join(',');
    if (key !== lastHandKey || dealing) {
      lastHandKey = key;
      handEl.innerHTML = hand.map((c, i) => cardHTML(c, (sel.has(c) ? 'sel ' : '') + (dealing ? 'deal' : ''), `--i:${i}`)).join('');
    } else {
      handEl.querySelectorAll<HTMLElement>('.tl-card').forEach((b) => b.classList.toggle('sel', sel.has(Number(b.dataset.c))));
    }
    layoutHand();
  }

  function selectionReason(): string {
    const v = ns?.view;
    if (!sel.size || !v) return '';
    const combo = detectCombo([...sel]);
    if (!combo) return T.rInvalid;
    if (!v.table) return '';
    if (!canBeat(v.table, combo)) {
      const sameKind = combo.type === v.table.type && combo.len === v.table.len;
      return sameKind ? T.rLower : fmt(T.rType, { t: comboText(v.table) }) + ' ' + T.rLower;
    }
    return '';
  }
  function setReason(text: string, kind: '' | 'ok' | 'bad' | 'info') { reasonEl.textContent = text; reasonEl.className = 'tl-reason' + (kind ? ' ' + kind : ''); }
  // Dòng ngay trên các nút: tên bộ đang chọn (xanh), lý do chưa đánh được (đỏ) hoặc gợi ý (xanh dương)
  function paintReason() {
    if (reasonMsg) { const cb = reasonKind === 'info' && sel.size ? detectCombo([...sel]) : null; setReason(reasonMsg + (cb ? ' · ' + comboText(cb) : ''), reasonKind); return; }
    const v = ns?.view;
    if (!v || !sel.size) { setReason('', ''); return; }
    const combo = detectCombo([...sel]);
    if (!combo) { setReason(T.rInvalid, 'bad'); return; }
    if (v.table && !canBeat(v.table, combo)) { setReason(selectionReason(), 'bad'); return; }
    setReason('✓ ' + comboText(combo), 'ok');
  }
  const myTurn = () => !!ns && ns.phase === 'playing' && !!ns.view && !ns.view.over && ns.mySeat >= 0 && ns.view.cur === ns.mySeat;

  function renderStatus() {
    const s = ns!, v = s.view!;
    const st = statusEl;
    st.classList.remove('done');
    if (v.over) { st.textContent = T.done; st.classList.add('done'); return; }
    if (s.mySeat < 0) { st.textContent = T.spectating; return; }
    if (finMsg && Date.now() < finUntil) { st.textContent = finMsg; return; }
    if (myTurn()) { st.textContent = v.table ? T.yourTurn + ' ' + T.beat : T.yourLead; return; }
    const curSlot = s.seats[v.cur], ps = s.slots[curSlot];
    const nm = ps ? ps.name : '';
    st.textContent = fmt(ps && ps.kind === 'human' && s.settings.n >= 2 && ctl?.kind !== 'solo' ? T.waiting : T.thinking, { n: nm });
  }

  function renderButtons() {
    const s = ns!, v = s.view!;
    const my = myTurn();
    const combo = sel.size ? detectCombo([...sel]) : null;
    const valid = !!combo && canBeat(v.table, combo);
    ($('tl-act') as HTMLButtonElement).disabled = !(my && valid);
    ($('tl-skip') as HTMLButtonElement).disabled = !(my && !!v.table);
    ($('tl-hint') as HTMLButtonElement).disabled = !my;
    ($('tl-clear') as HTMLButtonElement).disabled = !sel.size;
    const newBtn = $('tl-new') as HTMLButtonElement;
    newBtn.hidden = ctl?.kind === 'client';
    const nbLabel = chipsMode() || pointsMode() ? T.restart : T.again;
    newBtn.innerHTML = `↻ <span>${nbLabel}</span>`; newBtn.setAttribute('aria-label', nbLabel); newBtn.title = nbLabel;
    handEl.classList.toggle('mine', my);
  }

  function renderTop() {
    const s = ns!;
    const connEl = $('tl-conn'), codeEl = $('tl-roomcode');
    const online = ctl && ctl.kind !== 'solo';
    connEl.hidden = !online; codeEl.hidden = !online;
    if (online) {
      connEl.className = 'tl-conn' + (conn === 'lost' ? ' lost' : '');
      connEl.textContent = conn === 'lost' ? T.connLost : (ctl!.kind === 'host' ? T.connHost : T.connOk);
      codeEl.textContent = `${T.roomCode}: ${s.code}`;
    }
    $('tl-handinfo').textContent = fmt(T.handNo, { k: s.hand });
    const un = $('tl-un');
    const pm = pointsMode();
    un.hidden = !(chipsMode() || pm);
    if (pm) { const t = s.points!.target; const full = t > 0 ? fmt(T.targetInfo, { t }) : T.noTarget; un.title = full; un.textContent = full; }
    else if (chipsMode()) { const full = fmt(T.unitInfo, { u: s.settings.unit }); un.title = full; un.textContent = window.matchMedia('(max-width: 720px)').matches ? full.replace(/\s*chips?\s*$/i, '') : full; }
    const bar = $('tl-bar');
    bar.hidden = !(chipsMode() || pm);
    if (pm) {
      const myPl = s.view && s.view.multi ? s.view.finished.indexOf(s.mySeat) : -1;
      const myFin = myPl >= 0 && myPl < 3 ? `<span class="tl-fin p${myPl}">${T.finBadge[myPl]}</span>` : '';
      $('tl-me').innerHTML = `${scorePill(s.mySlot, true)}<span class="tl-meName">${esc(s.slots[s.mySlot]?.name || '')}</span>${myFin}`;
    } else if (chipsMode() && s.stacks) {
      const cur = s.stacks[s.mySlot], prev = prevStacks[s.mySlot];
      const chg = prev !== undefined && prev !== cur ? (cur > prev ? ' up' : ' dn') : '';
      $('tl-me').innerHTML = `<span class="tl-chip big${chg}">🪙 ${cur}</span><span class="tl-meName">${esc(s.slots[s.mySlot]?.name || '')}</span>`;
    }
  }

  function renderGame() {
    const s = ns!;
    if (!s.view) return;
    renderTop(); renderSeats(); renderPile(); renderHand(); renderStatus();
    paintReason();
    renderButtons();
    if (s.stacks) prevStacks = s.stacks.slice();
    if (s.points) prevTotals = s.points.totals.slice();
    tableEl.classList.toggle('myturn', myTurn());
    renderResult();
    tickTimer();
  }

  // ---------- Đồng hồ lượt ----------
  function tickTimer() {
    const s = ns; const tm = $('tl-timer');
    if (!s || !s.view || s.phase !== 'playing' || s.view.over || s.turnMs == null) {
      tm.hidden = true;
      document.querySelectorAll<HTMLElement>('.tl-avw.ring').forEach((e) => e.style.setProperty('--p', '1'));
      return;
    }
    const left = Math.max(0, s.turnMs - (Date.now() - nsAt));
    const p = Math.max(0, Math.min(1, left / TURN_MS));
    document.querySelectorAll<HTMLElement>('.tl-avw.ring').forEach((e) => e.style.setProperty('--p', p.toFixed(3)));
    const mine = myTurn();
    tm.hidden = !mine;
    if (mine) { tm.style.setProperty('--p', p.toFixed(3)); tm.classList.toggle('low', left < 8000); }
  }
  setInterval(() => { if (inGame) tickTimer(); }, 250);

  // ---------- Kết quả ván ----------
  const sgn = (n: number) => (n > 0 ? '+' + n : String(n));
  function itemLine(it: ResItem, me: number, unit: number): string {
    const nameOf = (slot: number) => esc(ns!.slots[slot]?.name || '');
    const u = unit;
    let parts: string;
    if (it.kind === 'white') parts = fmt(T.lnWhite, { u });
    else if (it.kind === 'chop') {
      const p: string[] = [];
      if (it.black) p.push(fmt(T.lnBlack, { k: it.black, u: 3 * u }));
      if (it.red) p.push(fmt(T.lnRed, { k: it.red, u: 4 * u }));
      if (it.bombs) p.push(fmt(T.lnBomb, { k: it.bombs, u: 4 * u }));
      parts = fmt(T.lnChop, { p: p.join(' + ') }) + ((it.stack || 1) > 1 ? ' · ' + T.lnStack : '');
    } else {
      const p = [it.burned ? fmt(T.lnBurn, { c: it.cards ?? 0, u }) : fmt(T.lnCards, { c: it.cards ?? 0, u })];
      if (it.black) p.push(fmt(T.lnBlack, { k: it.black, u }));
      if (it.red) p.push(fmt(T.lnRed, { k: it.red, u: 2 * u }));
      parts = p.join(' + ');
    }
    const short = it.paid < it.due ? ` (${fmt(T.lnShort, { p: it.paid })})` : '';
    if (it.from === me) return `${parts} = ${it.due}${short} → ${nameOf(it.to)}`;
    return `${nameOf(it.from)}: +${it.paid}${short}${it.kind === 'chop' ? ' (' + T.tagChop + ')' : ''}`;
  }
  let shownResultKey = '';
  function confettiHTML() {
    const cols = ['#ffd43b', '#ff6b6b', '#4dabf7', '#69db7c', '#f783ac', '#fff3bf'];
    let h = '';
    for (let i = 0; i < 30; i++) h += `<i style="left:${Math.random() * 100}%;background:${cols[i % 6]};animation-delay:${(Math.random() * 0.7).toFixed(2)}s;animation-duration:${(1.6 + Math.random() * 1.3).toFixed(2)}s"></i>`;
    return `<div class="tl-conf" aria-hidden="true">${h}</div>`;
  }
  function renderResult() {
    const s = ns!;
    if (s.phase !== 'result' || !s.result || !s.view) { if (!overEl.hidden && s.phase === 'playing') { overEl.hidden = true; overEl.innerHTML = ''; shownResultKey = ''; } return; }
    if (s.settings.mode === 'points' && s.result.pts) { renderResultPts(s); return; }
    const r = s.result, me = s.mySlot, n = s.settings.n;
    const nameOf = (slot: number) => esc(s.slots[slot]?.name || '');
    const chips = chipsMode();
    const key = `${s.hand}|${r.winner}|${r.sessionOver}`;
    const readyCount = s.slots.filter((x) => x.kind === 'human' && x.online && x.ready).length;
    const needCount = s.slots.filter((x, i) => x.kind === 'human' && x.online && (!chips || (s.stacks ? s.stacks[i] > 0 : true))).length;
    const iReady = !!s.slots[me]?.ready;
    // tiêu đề
    let msg: string;
    const winnerName = nameOf(r.winner);
    if (r.sessionOver) {
      if (r.sessionWinner === me) msg = T.youWinTable;
      else if (s.stacks && s.stacks[me] <= 0) msg = T.loseTable;
      else msg = fmt(T.tableWinner, { n: nameOf(r.sessionWinner) });
    } else if (r.white) { const k = T.white[r.white]; msg = r.winner === me ? fmt(T.youWhite, { k }) : fmt(T.whiteWin, { n: winnerName, k }); }
    else msg = r.winner === me ? T.youWin : fmt(T.botWin, { n: winnerName });
    // chip mode: ghi nhận thống kê một lần cho mỗi ván
    if (shownResultKey !== key) {
      shownResultKey = key;
      if (r.winner === me) stats.hw++;
      if (ctl?.kind === 'solo') { if (r.sessionOver) { if (r.sessionWinner === me) stats.w++; else stats.l++; } else if (!chips) { if (r.winner === me) stats.w++; else stats.l++; } }
      if (s.stacks) stats.best = Math.max(stats.best, s.stacks[me] ?? 0);
      saveStats();
      sfx.play(r.winner === me || (r.sessionOver && r.sessionWinner === me) ? 'win' : 'lose');
    }
    const chopSeats = new Set<number>(), choppedSeats = new Set<number>();
    for (const c of r.chops) { chopSeats.add(c.chopper); choppedSeats.add(c.victim); }
    const rows = r.order.map((slot, i) => {
      const d = r.deltas[slot];
      const tags: string[] = [];
      if (i === 0) tags.push(`<em>${r.white ? T.tagWhite : T.winnerTag}</em>`);
      if (r.burned[slot]) tags.push(`<em class="bad">${T.burned}</em>`);
      if (chopSeats.has(slot)) tags.push(`<em class="gold">${T.tagChop}</em>`);
      if (choppedSeats.has(slot)) tags.push(`<em class="bad">${T.tagChopped}</em>`);
      const lines = chips ? r.items.filter((it) => it.from === slot || it.to === slot).map((it) => `<div>${itemLine(it, slot, s.settings.unit)}</div>`).join('') : '';
      const left = r.hands[String(slot)]?.length ?? 0;
      const tail = chips ? `<strong class="${d > 0 ? 'up' : d < 0 ? 'dn' : ''}">${sgn(d)}</strong><small>🪙 ${s.stacks ? s.stacks[slot] : 0}</small>` : `<span>${i === 0 ? '' : fmt(T.left, { k: left })}</span>`;
      return `<li><span class="tl-av sm" style="--c:${AV_COL[slot % 4]}">${esc([...(s.slots[slot]?.name || '?')][0] || '?')}</span><b>${nameOf(slot)}</b>${tags.join('')}${tail}${lines ? `<div class="tl-bd">${lines}</div>` : ''}</li>`;
    }).join('');
    // nút
    let btns = '';
    if (r.sessionOver) {
      btns = ctl?.kind === 'client' ? `<span class="tl-wait">${T.waitHostRestart}</span>` : `<button type="button" class="btn" id="tl-restart">${T.restart}</button>`;
    } else if (ctl?.kind === 'solo') btns = `<button type="button" class="btn" id="tl-next">${T.nextHand}</button>`;
    else btns = iReady ? `<span class="tl-wait">${T.readyWait} (${fmt(T.readyCount, { a: readyCount, b: needCount })})</span>` : `<button type="button" class="btn" id="tl-ready">${T.ready}${needCount > 1 ? ` (${fmt(T.readyCount, { a: readyCount, b: needCount })})` : ''}</button>`;
    const sig = key + '|' + iReady + '|' + readyCount + '|' + needCount + '|' + (s.stacks ? s.stacks.join(',') : '');
    if (overEl.dataset.sig === sig && !overEl.hidden) return;
    overEl.dataset.sig = sig;
    overEl.className = 'tl-over' + (chips ? ' chip' : '');
    overEl.innerHTML = `${r.winner === me ? confettiHTML() : ''}<div class="tl-box${chips ? ' tl-settle' : ''}"><h2>${msg}</h2><p>${chips ? T.settle + ' · ' + fmt(T.unitInfo, { u: s.settings.unit }) : T.order}</p><ol>${rows}</ol><div class="tl-nextbar">${btns}<button type="button" class="btn ghost" id="tl-menu2">${ctl?.kind === 'solo' ? T.menu : T.leaveRoom}</button></div></div>`;
    overEl.hidden = false;
  }
  // ---------- Kết quả ván: chế độ tính điểm ----------
  let countedHand = '', countedOver = '';
  function renderResultPts(s: NetState) {
    const r = s.result!, pts = r.pts!, me = s.mySlot;
    const nameOf = (slot: number) => esc(s.slots[slot]?.name || '');
    const over = r.sessionOver;
    const key = `${s.hand}|${r.winner}|${over}|${pts.over}`;
    const humansOn = s.slots.filter((x) => x.kind === 'human' && x.online);
    const readyCount = humansOn.filter((x) => x.ready).length, needCount = humansOn.length;
    const iReady = !!s.slots[me]?.ready;
    const hk = `${s.code}|${s.hand}`;
    if (countedHand !== hk) { countedHand = hk; if (r.winner === me) stats.hw++; saveStats(); }
    if (over && countedOver !== hk) {
      countedOver = hk;
      if (ctl?.kind === 'solo') { if (r.sessionWinner === me) stats.w++; else stats.l++; saveStats(); }
    }
    if (shownResultKey !== key) { shownResultKey = key; sfx.play(over ? (r.sessionWinner === me ? 'win' : 'lose') : (r.winner === me ? 'win' : 'lose')); }
    const totals = pts.totals;
    // người dẫn đầu: điểm cao nhất, bằng điểm thì ai được nhiều điểm hơn ở ván vừa rồi, rồi số ghế
    const ranked = [0, 1, 2, 3].sort((a, b) => totals[b] - totals[a] || r.deltas[b] - r.deltas[a] || a - b);
    const avatar = (slot: number) => `<span class="tl-av sm" style="--c:${AV_COL[slot % 4]}">${esc([...(s.slots[slot]?.name || '?')][0] || '?')}</span>`;
    let msg: string, sub: string, rows: string;
    if (over) {
      const w = r.sessionWinner;
      msg = w === me ? fmt(T.ptsWinYou, { p: totals[w] }) : fmt(T.ptsWinOther, { n: nameOf(w), p: totals[w] });
      sub = pts.over === 'ended' ? T.ptsEndNote : T.standings;
      const medal = ['🥇', '🥈', '🥉', '4.'];
      rows = ranked.map((slot, i) => `<li><span class="tl-medal">${medal[i]}</span>${avatar(slot)}<b>${nameOf(slot)}</b>${slot === me ? `<em class="gold">${T.youTag}</em>` : ''}<strong class="${totals[slot] > 0 ? 'up' : totals[slot] < 0 ? 'dn' : ''}">${totals[slot]}</strong></li>`).join('');
    } else {
      const handMsg = r.white ? (r.winner === me ? fmt(T.youWhite, { k: T.white[r.white] }) : fmt(T.whiteWin, { n: nameOf(r.winner), k: T.white[r.white] })) : (r.winner === me ? T.youWin : fmt(T.botWin, { n: nameOf(r.winner) }));
      msg = handMsg;
      sub = `${T.ptsSettle} · ${pts.target > 0 ? fmt(T.targetInfo, { t: pts.target }) : T.noTarget}`;
      rows = r.order.map((slot, i) => {
        const d = r.deltas[slot];
        // tới trắng không phân nhì, ba, bét nên không ghi hạng
        const lines: string[] = [`<div>${r.white ? T.tagWhite : T.rankLn[i]}: ${sgn(pts.rank[slot])}</div>`];
        for (const it of pts.items) {
          if (it.self) continue;
          if (it.kind !== 'chop') {
            const k = it.kind === 'heo' ? T.chopKinds[chopKind(it.key, it.cards)] : '';
            if (it.from === slot) lines.push(`<div>${fmt(it.kind === 'burn' ? T.lnBurnPts : T.lnHeoPts, { k, v: it.val, n: nameOf(it.to) })}</div>`);
            else if (it.to === slot) lines.push(`<div>${fmt(it.kind === 'burn' ? T.lnBurnOf : T.lnHeoOf, { k, v: it.val, n: nameOf(it.from) })}</div>`);
            continue;
          }
          const lab = T.chopKinds[chopKind(it.key, it.cards)];
          const chain = (it.stack || 1) > 1 ? ` · ${T.lnChain}` : '';
          if (it.from === slot) lines.push(`<div>${fmt(T.lnChopped, { k: lab, v: it.val, n: nameOf(it.to) })}${chain}</div>`);
          else if (it.to === slot) lines.push(`<div>${fmt(T.lnChopOf, { k: lab, v: it.val, n: nameOf(it.from) })}${chain}</div>`);
        }
        const tags = (i === 0 ? `<em>${r.white ? T.tagWhite : T.winnerTag}</em>` : '') + (pts.items.some((it) => it.kind === 'chop' && !it.self && it.to === slot) ? `<em class="gold">${T.tagChopPts}</em>` : '') + (pts.items.some((it) => it.kind === 'chop' && it.from === slot) ? `<em class="bad">${T.tagChoppedPts}</em>` : '') + (pts.items.some((it) => it.kind !== 'chop' && it.from === slot) ? `<em class="bad">${T.tagThoi}</em>` : '');
        return `<li>${avatar(slot)}<b>${nameOf(slot)}</b>${tags}<span class="tl-pd"><strong class="${d > 0 ? 'up' : d < 0 ? 'dn' : ''}">${sgn(d)}</strong><small>⭐ ${totals[slot]}</small></span><div class="tl-bd">${lines.join('')}</div></li>`;
      }).join('');
    }
    let btns = '';
    if (over) btns = ctl?.kind === 'client' ? `<span class="tl-wait">${T.waitHostRestart}</span>` : `<button type="button" class="btn" id="tl-restart">${T.playAgain}</button>`;
    else {
      const endBtn = ctl?.kind === 'client' ? '' : `<button type="button" class="btn ghost" id="tl-endsession">${T.endBtn}</button>`;
      if (ctl?.kind === 'solo') btns = `<button type="button" class="btn" id="tl-next">${T.nextHand}</button>${endBtn}`;
      else btns = (iReady ? `<span class="tl-wait">${T.readyWait} (${fmt(T.readyCount, { a: readyCount, b: needCount })})</span>` : `<button type="button" class="btn" id="tl-ready">${T.ready}${needCount > 1 ? ` (${fmt(T.readyCount, { a: readyCount, b: needCount })})` : ''}</button>`) + endBtn;
    }
    const sig = key + '|' + iReady + '|' + readyCount + '|' + needCount + '|' + totals.join(',');
    if (overEl.dataset.sig === sig && !overEl.hidden) return;
    overEl.dataset.sig = sig;
    overEl.className = 'tl-over chip';
    overEl.innerHTML = `${(over ? r.sessionWinner === me : r.winner === me) ? confettiHTML() : ''}<div class="tl-box tl-settle tl-pts"><h2>${msg}</h2><p>${sub}</p><ol>${rows}</ol><div class="tl-nextbar">${btns}<button type="button" class="btn ghost" id="tl-menu2">${ctl?.kind === 'solo' ? T.menu : T.leaveRoom}</button></div></div>`;
    overEl.hidden = false;
  }
  overEl.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (t.closest('#tl-endsession')) sendIntent({ type: 'endsession' });
    else if (t.closest('#tl-next')) sendIntent({ type: 'ready' });
    else if (t.closest('#tl-ready')) sendIntent({ type: 'ready' });
    else if (t.closest('#tl-restart')) { countedHand = ''; countedOver = ''; shownResultKey = ''; sendIntent({ type: 'restart' }); }
    else if (t.closest('#tl-menu2')) leaveToMenu();
  });

  // ---------- Thao tác của người chơi ----------
  function failText(reason: string): string {
    switch (reason) { case 'notTurn': return T.rTurn; case 'empty': return T.rEmpty; default: return T.rInvalid; }
  }
  function humanPlay() {
    if (!ns || !ns.view) return;
    if (!myTurn()) { reasonMsg = T.rTurn; reasonKind = 'bad'; paintReason(); return; }
    const cards = [...sel];
    if (!cards.length) { reasonMsg = T.rEmpty; reasonKind = 'bad'; paintReason(); sfx.play('error'); return; }
    const combo = detectCombo(cards);
    const v = ns.view;
    if (!combo) { reasonMsg = T.rInvalid; reasonKind = 'bad'; paintReason(); sfx.play('error'); return; }
    if (!canBeat(v.table, combo)) { reasonMsg = selectionReason() || T.rLower; reasonKind = 'bad'; paintReason(); sfx.play('error'); return; }
    sel = new Set(); reasonMsg = '';
    sendIntent({ type: 'play', cards });
    if (ctl?.kind === 'client') { handEl.querySelectorAll('.tl-card.sel').forEach((b) => b.classList.remove('sel')); }
  }
  function humanPass() {
    if (!myTurn() || !ns?.view?.table) return;
    sel = new Set(); reasonMsg = '';
    sendIntent({ type: 'pass' });
  }
  function humanHint() {
    if (!myTurn() || !ns?.view) return;
    const mv = botDecide(ns.view, 3, () => 0.5);
    if ('pass' in mv) { sel = new Set(); reasonMsg = T.hintPass; reasonKind = 'info'; const b = $('tl-skip'); b.classList.remove('flash'); void b.offsetWidth; b.classList.add('flash'); }
    else { sel = new Set(mv.cards); reasonMsg = T.hintPlay; reasonKind = 'info'; }
    refreshSel(); sfx.play('select');
  }
  function refreshSel() {
    handEl.querySelectorAll<HTMLElement>('.tl-card').forEach((b) => b.classList.toggle('sel', sel.has(Number(b.dataset.c))));
    paintReason();
    if (ns?.view) renderButtons();
  }
  // Chạm vào lá, hoặc giữ và quét ngón tay qua nhiều lá để chọn / bỏ chọn cùng lúc
  let drag: { mode: boolean; seen: Set<number> } | null = null;
  const cardAt = (x: number, y: number) => (document.elementFromPoint(x, y) as HTMLElement | null)?.closest('.tl-card') as HTMLElement | null;
  const applyCard = (b: HTMLElement | null) => {
    if (!b || !drag) return;
    const c = Number(b.dataset.c);
    if (drag.seen.has(c)) return;
    drag.seen.add(c);
    if (sel.has(c) === drag.mode) return;
    if (drag.mode) sel.add(c); else sel.delete(c);
    reasonMsg = ''; sfx.play('select'); refreshSel();
  };
  // Chạm đúp một lá: tự chọn cả bộ hợp lệ chứa lá đó (đôi, sám, tứ quý, sảnh, đôi thông), ưu tiên bộ đánh được bài trên bàn
  function smartSelect(c: number) {
    const v = ns?.view; if (!v) return;
    let pool = enumerateCombos(v.hand).filter((cb) => cb.cards.includes(c) && canBeat(v.table, cb));
    if (!pool.length) { sel = new Set([c]); reasonMsg = ''; sfx.play('select'); refreshSel(); return; }
    if (v.table) {
      // phải đánh cùng loại với bộ trên bàn (nếu có), chọn bộ nhỏ nhất đủ lớn; không có thì mới tính đến chặt
      const same = pool.filter((cb) => cb.type === v.table!.type && cb.len === v.table!.len);
      if (same.length) pool = same;
      pool.sort((a, b) => a.top - b.top || b.cards.length - a.cards.length);
    } else {
      // dẫn bài: ưu tiên cả nhóm cùng hạng (đôi, sám, tứ quý) chứa lá đó; không có nhóm thì lấy sảnh dài nhất; không có nữa thì lá đơn
      const group = pool.filter((cb) => cb.type === 'pair' || cb.type === 'triple' || cb.type === 'quad');
      if (group.length) pool = group; else { const runs = pool.filter((cb) => cb.type === 'run'); if (runs.length) pool = runs; }
      pool.sort((a, b) => b.cards.length - a.cards.length || a.top - b.top);
    }
    sel = new Set(pool[0].cards); reasonMsg = ''; sfx.play('select'); refreshSel();
  }
  let lastTap = { c: -1, t: 0 };
  handEl.addEventListener('pointerdown', (e) => {
    const b = (e.target as HTMLElement).closest('.tl-card') as HTMLElement | null;
    if (!b) return;
    const c = Number(b.dataset.c), now = performance.now();
    if (lastTap.c === c && now - lastTap.t < 380) { lastTap = { c: -1, t: 0 }; drag = null; smartSelect(c); return; }
    lastTap = { c, t: now };
    drag = { mode: !sel.has(c), seen: new Set() };
    applyCard(b);
  });
  handEl.addEventListener('pointermove', (e) => { if (drag && e.buttons) applyCard(cardAt(e.clientX, e.clientY)); });
  const endDrag = () => { drag = null; };
  window.addEventListener('pointerup', endDrag); window.addEventListener('pointercancel', endDrag);
  handEl.addEventListener('click', (e) => { // bàn phím (Enter / Space): click không có toạ độ con trỏ
    if ((e as MouseEvent).detail !== 0) return;
    const b = (e.target as HTMLElement).closest('.tl-card') as HTMLElement | null;
    if (!b) return;
    const c = Number(b.dataset.c);
    if (sel.has(c)) sel.delete(c); else sel.add(c);
    reasonMsg = ''; sfx.play('select'); refreshSel();
  });
  $('tl-act').addEventListener('click', humanPlay);
  $('tl-skip').addEventListener('click', humanPass);
  $('tl-hint').addEventListener('click', humanHint);
  $('tl-clear').addEventListener('click', () => { sel = new Set(); reasonMsg = ''; refreshSel(); sfx.play('click'); });
  $('tl-new').addEventListener('click', () => {
    if (!ctl || ctl.kind === 'client') return;
    if (chipsMode() || pointsMode()) {
      const busy = ns && ns.phase !== 'lobby' && (ns.hand > 1 || (ns.view && ns.view.log.length > 0));
      if (busy && !window.confirm(pointsMode() ? T.confirmRestartPts : T.confirmRestart)) return;
    }
    countedHand = ''; countedOver = ''; shownResultKey = '';
    if (ctl.kind === 'solo') ctl.game.restartNow(); else ctl.host.game.restartNow();
  });
  $('tl-menu-btn').addEventListener('click', () => leaveToMenu());
  window.addEventListener('resize', () => { if (inGame && ns?.view) layoutHand(); });
  window.addEventListener('orientationchange', () => setTimeout(() => { if (inGame && ns?.view) layoutHand(); }, 250));

  // ---------- Thoát / dọn dẹp ----------
  // chat và biểu cảm trong phòng
  let chat: ChatBox | null = null;
  const closeChat = () => { chat?.destroy(); chat = null; };
  function hostChat(room: { say(t: string): void; onChat: any }) {
    closeChat();
    chat = mountChat((document.documentElement.lang.startsWith('en') ? 'en' : 'vi'), (t) => room.say(t));
    room.onChat = (m: any) => chat?.add(m, m.slot === 0);
  }
  function guestChat(rc: { say(t: string): void; onChat: any }, slot: number) {
    closeChat();
    chat = mountChat((document.documentElement.lang.startsWith('en') ? 'en' : 'vi'), (t) => rc.say(t));
    rc.onChat = (m: any) => chat?.add(m, m.slot === slot);
  }

  function teardown() {
    closeChat();
    const c = ctl; ctl = null; ns = null;
    try { if (c?.kind === 'host') c.host.close(); else if (c?.kind === 'client') c.client.leave(); } catch {}
    shownResultKey = ''; lastEv = 0; lastHand = -1; lastHandKey = ''; lastCur = -1; prevStacks = []; prevTotals = []; countedHand = ''; countedOver = ''; sel = new Set();
    overEl.hidden = true; overEl.innerHTML = ''; overEl.dataset.sig = ''; closedEl.hidden = true;
    conn = 'online';
  }
  function leaveToMenu() { teardown(); saveRoom(null); showView('home'); }
  window.addEventListener('pagehide', () => { if (ctl?.kind === 'host') { try { ctl.host.close(); } catch {} } else if (ctl?.kind === 'client') { /* giữ token để nối lại khi tải lại trang */ } });

  // ---------- Chơi với máy ----------
  let nPlayers = 4, level = 2, mode: 'chips' | 'single' | 'points' = 'chips', stackStart = 1000, unit = 10, targetPts = 100;
  function pick(attr: string, cb: (v: string) => void) {
    document.querySelectorAll<HTMLElement>(`#tl-v-solo [data-${attr}]`).forEach((btn) => btn.addEventListener('click', () => {
      document.querySelectorAll(`#tl-v-solo [data-${attr}]`).forEach((x) => x.classList.remove('sel'));
      btn.classList.add('sel');
      cb(btn.dataset[attr] as string);
    }));
  }
  pick('mode', (v) => {
    mode = v === 'single' ? 'single' : v === 'points' ? 'points' : 'chips';
    $('tl-chipopts').hidden = mode !== 'chips'; $('tl-ptsopts').hidden = mode !== 'points'; $('tl-players-wrap').hidden = mode === 'points';
  });
  pick('target', (v) => { targetPts = Number(v); (document.getElementById('tl-target-custom') as HTMLInputElement).value = ''; });
  // đích tự nhập: chỉ nhận số nguyên từ 10 đến 1000
  (document.getElementById('tl-target-custom') as HTMLInputElement).addEventListener('input', (e) => {
    const el = e.target as HTMLInputElement; const x = Number(el.value);
    const good = el.value !== '' && Number.isInteger(x) && x >= 10 && x <= 1000;
    el.classList.toggle('bad', el.value !== '' && !good);
    if (good) { targetPts = x; document.querySelectorAll('#tl-v-solo [data-target]').forEach((b) => b.classList.remove('sel')); }
  });
  pick('stack', (v) => { stackStart = Number(v); });
  pick('unit', (v) => { unit = Number(v); });
  pick('players', (v) => { nPlayers = Number(v); });
  pick('level', (v) => { level = Number(v); });

  function startSolo(n: number, lv: number, m: 'chips' | 'single' | 'points', stack: number, u: number, target = 100) {
    teardown();
    const game = new TLGame(realClock, { botNames: T.bots, botMs: fast ? [0, 0] : [600, 1300], onChange: () => { if (ctl && ctl.kind === 'solo') onState(game.stateFor(0)); } });
    ctl = { kind: 'solo', game };
    game.setHuman(0, T.you, true);
    game.setSettings({ n: m === 'points' ? 4 : n, mode: m, stack, unit: u, level: lv, timer: false, target });
    game.start();
  }
  $('tl-start').addEventListener('click', () => { sfx.play('click'); startSolo(nPlayers, level, mode, stackStart, unit, targetPts); });

  // ---------- Online ----------
  const peerFactory = (): Transport => new FirebaseTransport();
  const errText = (r: string) => (T.errs[r] || T.errs.network);
  const setErr = (id: string, msg: string) => { const e = $(id); e.textContent = msg; e.hidden = !msg; };

  async function createRoom() {
    const nameEl = $('tl-name-c') as HTMLInputElement;
    const name = sanitizeName(nameEl.value, defaultName()); saveName(name);
    const btn = $('tl-create') as HTMLButtonElement;
    setErr('tl-err-c', ''); btn.disabled = true; const label = btn.textContent; btn.textContent = T.creating;
    try {
      teardown();
      const host = await TLNetHost.create(hub ? () => hub!.create() : peerFactory, realClock, name, (s) => { if (ctl && ctl.kind === 'host' && ctl.host === host) onState(s); }, { botNames: T.bots, botMs: fast ? [0, 0] : [600, 1300] });
      ctl = { kind: 'host', host };
      hostChat(host.room);
      host.setSettings({ n: 4, mode: 'chips', stack: 1000, unit: 10, level: 2, timer: true });
      host.publish();
    } catch (e) { setErr('tl-err-c', T.errs.create); }
    btn.disabled = false; btn.textContent = label;
  }
  $('tl-create').addEventListener('click', () => { sfx.play('click'); createRoom(); });

  async function joinRoom(codeRaw: string, nameRaw: string, token = '', silent = false) {
    const code = normCode(codeRaw);
    const name = sanitizeName(nameRaw, defaultName()); saveName(name);
    const errId = 'tl-err-j';
    if (!validCode(code)) { setErr(errId, T.errs.badcode); return false; }
    const btn = $('tl-joinbtn') as HTMLButtonElement;
    setErr(errId, ''); btn.disabled = true; const label = btn.textContent; btn.textContent = T.joining;
    teardown();
    const client = new TLNetClient(hub ? () => hub!.create() : peerFactory, {
      onState: (s) => { if (ctl && ctl.kind === 'client' && ctl.client === client) onState(s); },
      onStatus: (st) => { conn = st; if (ns && inGame) renderTop(); else if (ns) renderLobby(); },
      onClosed: (r) => { if (ctl && ctl.kind === 'client' && ctl.client === client) roomClosed(r); },
    }, realClock);
    ctl = { kind: 'client', client };
    try {
      const info = await client.join(code, name, token);
      saveRoom({ code, token: info.token, name });
      guestChat(client.rc, info.slot);
      btn.disabled = false; btn.textContent = label;
      return true;
    } catch (e) {
      ctl = null;
      const r = e instanceof RoomError ? e.reason : 'network';
      if (!silent) setErr(errId, errText(r));
      btn.disabled = false; btn.textContent = label;
      return false;
    }
  }
  $('tl-joinbtn').addEventListener('click', () => { sfx.play('click'); joinRoom(($('tl-code') as HTMLInputElement).value, ($('tl-name-j') as HTMLInputElement).value); });
  ($('tl-code') as HTMLInputElement).addEventListener('input', (e) => { const el = e.target as HTMLInputElement; el.value = normCode(el.value); });

  function roomClosed(reason: RejectReason) {
    saveRoom(null); closeChat();
    const msg = errText(reason === 'closed' ? 'closed' : reason);
    if (!inGame) { // đang ở phòng chờ
      showView('home'); const el = $('tl-rejoin'); el.textContent = msg; el.hidden = false; return;
    }
    closedEl.innerHTML = `<div class="tl-box"><h2>${T.roomClosed}</h2><p>${esc(msg)}</p><div class="tl-nextbar"><button type="button" class="btn" id="tl-closed-ok">${T.toMenu}</button></div></div>`;
    closedEl.hidden = false; overEl.hidden = true;
    $('tl-closed-ok').addEventListener('click', () => { teardown(); showView('home'); });
  }

  // ---------- Phòng chờ ----------
  function lobbyLink(code: string) { return `${location.origin}${location.pathname}?room=${code}`; }
  async function copyText(text: string, btn: HTMLElement) {
    try { await navigator.clipboard.writeText(text); } catch {
      const ta = document.createElement('textarea'); ta.value = text; document.body.appendChild(ta); ta.select(); try { document.execCommand('copy'); } catch {} ta.remove();
    }
    const old = btn.textContent; btn.textContent = T.copied; setTimeout(() => { btn.textContent = old; }, 1400);
  }
  function renderLobby() {
    const s = ns; const el = $('tl-v-lobby');
    if (!s || s.phase !== 'lobby' || !ctl || ctl.kind === 'solo') return;
    const isHost = ctl.kind === 'host';
    const n = s.settings.n;
    const humans = s.slots.filter((x) => x.kind === 'human').length;
    const maxHumanSlot = Math.max(0, ...s.slots.map((x, i) => (x.kind === 'human' ? i : 0)));
    const seatRows = s.slots.map((x, i) => {
      const human = x.kind === 'human';
      const tags = [x.host ? `<span class="tl-tag host">${T.hostTag}</span>` : '', i === s.mySlot ? `<span class="tl-tag you">${T.youTag}</span>` : '', human ? '' : `<span class="tl-tag bot">${T.botTag}</span>`].join('');
      const dot = human ? `<i class="tl-dot${x.online ? ' on' : ''}" title="${x.online ? T.onlineTag : T.offlineTag}"></i>` : '<i class="tl-dot bot"></i>';
      return `<li class="${human ? 'human' : 'botrow'}"><span class="tl-av sm" style="--c:${AV_COL[i % 4]}">${esc([...x.name][0] || '?')}</span><b>${esc(x.name)}</b>${tags}${dot}</li>`;
    }).join('');
    const opt = (attr: string, vals: (string | number)[], cur: string | number, labels?: string[]) => `<div class="bd-row">${vals.map((v, i) => `<button type="button" class="bd-opt${String(v) === String(cur) ? ' sel' : ''}" data-set-${attr}="${v}"${attr === 'n' && Number(v) <= maxHumanSlot ? ' disabled' : ''}>${labels ? labels[i] : v}</button>`).join('')}</div>`;
    const isPts = s.settings.mode === 'points';
    const tg = s.settings.target;
    const settings = isHost ? `
      ${isPts ? `<p class="meta tl-small">${T.ptsFour}</p>` : `<h2 class="bd-h">${T.seatsLbl}</h2>${opt('n', [2, 3, 4], n, T.playersOpt)}<p class="meta tl-small">${T.seatsHint}</p>`}
      <h2 class="bd-h">${T.mode}</h2>${opt('mode', MODE_KEYS, s.settings.mode, T.modes)}
      ${isPts ? `<h2 class="bd-h">${T.ptsTarget}</h2>${opt('target', [50, 100, 200, 300, 0], tg, ['50', '100', '200', '300', T.ptsEndless])}<label class="tl-lbl" for="tl-set-target-in">${T.ptsCustom}</label><input id="tl-set-target-in" class="tl-input tl-num" type="number" inputmode="numeric" min="10" max="1000" step="10" value="${[0, 50, 100, 200, 300].includes(tg) ? '' : tg}" placeholder="10 - 1000" />` : ''}
      ${s.settings.mode === 'chips' ? `<h2 class="bd-h">${T.stackLbl}</h2>${opt('stack', [500, 1000, 2000], s.settings.stack)}<h2 class="bd-h">${T.unitLbl}</h2>${opt('unit', [5, 10, 20], s.settings.unit)}` : ''}
      <h2 class="bd-h">${T.level}</h2>${opt('level', [1, 2, 3], s.settings.level, T.levels)}
      <h2 class="bd-h">${T.timerLbl}</h2>${opt('timer', ['on', 'off'], s.settings.timer ? 'on' : 'off', T.timerOpts)}
    ` : `<p class="meta">${fmt(T.settingsSummary, { n, m: s.settings.mode === 'chips' ? `${T.modes[0]}, ${s.settings.stack} / ${s.settings.unit}` : s.settings.mode === 'points' ? `${T.modes[2]}, ${s.settings.target > 0 ? fmt(T.targetInfo, { t: s.settings.target }) : T.noTarget}` : T.modes[1], l: T.levels[s.settings.level - 1] })}</p>`;
    const link = lobbyLink(s.code);
    const lostTag = conn === 'lost' ? `<p class="tl-err">${T.connLost}</p>` : '';
    el.innerHTML = `
      <button type="button" class="tl-back" id="tl-leave-lobby">${T.back}</button>
      <h2 class="bd-h">${T.lobbyTitle}</h2>
      <div class="tl-codebox"><small>${T.roomCode}</small><b id="tl-bigcode">${esc(s.code)}</b>
        <div class="tl-codebtns"><button type="button" class="btn ghost sm" id="tl-copycode">${T.copyCode}</button><button type="button" class="btn ghost sm" id="tl-copylink">${T.copyLink}</button>${typeof (navigator as any).share === 'function' ? `<button type="button" class="btn ghost sm" id="tl-share">${T.shareBtn}</button>` : ''}</div>
      </div>
      ${lostTag}
      <ul class="tl-seats">${seatRows}</ul>
      ${settings}
      <p class="tl-gap"></p>
      ${isHost ? `<button class="btn" type="button" id="tl-startonline">▶ ${T.startOnline}</button>` : `<p class="tl-wait">${T.waitHost}</p>`}
      <p class="meta tl-small">${T.lobbyNote}</p>`;
    $('tl-leave-lobby').addEventListener('click', () => leaveToMenu());
    $('tl-copycode').addEventListener('click', (e) => copyText(s.code, e.currentTarget as HTMLElement));
    $('tl-copylink').addEventListener('click', (e) => copyText(link, e.currentTarget as HTMLElement));
    const sh = document.getElementById('tl-share'); sh?.addEventListener('click', () => { try { (navigator as any).share({ title: T.title, text: `${T.roomCode}: ${s.code}`, url: link }); } catch {} });
    if (isHost) {
      const host = (ctl as Extract<Ctl, { kind: 'host' }>).host;
      el.querySelectorAll<HTMLElement>('[data-set-n]').forEach((b) => b.addEventListener('click', () => host.setSettings({ n: Number(b.dataset.setN) })));
      el.querySelectorAll<HTMLElement>('[data-set-mode]').forEach((b) => b.addEventListener('click', () => host.setSettings({ mode: b.dataset.setMode as 'chips' | 'single' | 'points' })));
      el.querySelectorAll<HTMLElement>('[data-set-target]').forEach((b) => b.addEventListener('click', () => host.setSettings({ target: Number(b.dataset.setTarget) })));
      const tIn = document.getElementById('tl-set-target-in') as HTMLInputElement | null;
      tIn?.addEventListener('change', () => { const x = Number(tIn.value); if (Number.isInteger(x) && x >= 10 && x <= 1000) host.setSettings({ target: x }); else tIn.classList.add('bad'); });
      el.querySelectorAll<HTMLElement>('[data-set-stack]').forEach((b) => b.addEventListener('click', () => host.setSettings({ stack: Number(b.dataset.setStack) })));
      el.querySelectorAll<HTMLElement>('[data-set-unit]').forEach((b) => b.addEventListener('click', () => host.setSettings({ unit: Number(b.dataset.setUnit) })));
      el.querySelectorAll<HTMLElement>('[data-set-level]').forEach((b) => b.addEventListener('click', () => host.setSettings({ level: Number(b.dataset.setLevel) })));
      el.querySelectorAll<HTMLElement>('[data-set-timer]').forEach((b) => b.addEventListener('click', () => host.setSettings({ timer: b.dataset.setTimer === 'on' })));
      $('tl-startonline').addEventListener('click', () => { sfx.play('click'); host.start(); });
    }
  }

  // ---------- Mở trang ----------
  paintStat();
  ($('tl-chipopts')).hidden = false;
  const params = new URLSearchParams(location.search);
  const roomParam = normCode(params.get('room') || '');
  const debug = location.hash.includes('debug');
  if (roomParam && !debug) {
    ($('tl-code') as HTMLInputElement).value = roomParam;
    ($('tl-name-j') as HTMLInputElement).value = defaultName();
    showView('join');
    try { history.replaceState(null, '', location.pathname); } catch {}
  } else if (!debug) {
    const saved = loadRoom();
    if (saved) {
      const el = $('tl-rejoin'); el.textContent = fmt(T.rejoining, { c: saved.code }); el.hidden = false;
      joinRoom(saved.code, saved.name, saved.token, true).then((ok) => { if (!ok) { saveRoom(null); el.hidden = true; } else el.hidden = true; });
    }
  }

  // ---------- Debug (chỉ khi URL có #debug) ----------
  if (debug) {
    const agents: { client: TLNetClient; st: NetState | null }[] = [];
    let agentTimer: ReturnType<typeof setInterval> | null = null;
    const agentStep = () => {
      for (const a of agents) {
        const s = a.st; if (!s || !s.view) continue;
        if (s.phase === 'playing' && s.mySeat >= 0 && !s.view.over && s.view.cur === s.mySeat) {
          const legal = enumerateCombos(s.view.hand).filter((c) => canBeat(s.view!.table, c));
          if (legal.length && (!s.view.table || Math.random() < 0.85)) a.client.play(legal[Math.floor(Math.random() * legal.length)].cards);
          else if (s.view.table) a.client.pass(); else a.client.play([Math.min(...s.view.hand)]);
        } else if (s.phase === 'result' && s.result && !s.result.sessionOver && !s.slots[s.mySlot].ready) a.client.ready();
      }
    };
    (window as any).__tl = {
      get ns() { return ns; }, get ctl() { return ctl; }, get sel() { return [...sel]; },
      fast: (f = true) => { fast = f; },
      solo: (n = 4, lv = 2, m: 'chips' | 'single' | 'points' = 'chips', stack = 1000, u = 10, target = 100) => startSolo(n, lv, m, stack, u, target),
      view: (v: string) => showView(v),
      setSel: (cards: number[]) => { sel = new Set(cards); refreshSel(); },
      play: () => humanPlay(), pass: () => humanPass(), hint: () => humanHint(),
      // phòng giả lập trong bộ nhớ (không cần mạng): chủ phòng là giao diện này, các khách tự chơi
      demoRoom: async (o: { humans?: number; n?: number; mode?: 'chips' | 'single' | 'points'; target?: number; start?: boolean; timer?: boolean; names?: string[] } = {}) => {
        fast = true; hub = new LoopbackHub();
        ($('tl-name-c') as HTMLInputElement).value = 'Khang';
        await createRoom();
        const host = (ctl as Extract<Ctl, { kind: 'host' }>).host;
        host.setSettings({ n: o.n ?? 4, mode: o.mode ?? 'chips', timer: !!o.timer, stack: 1000, unit: 10, level: 2, target: o.target ?? 100 });
        const names = o.names || ['Linh', 'Bảo', 'Quỳnh'];
        for (let i = 0; i < (o.humans ?? 2) - 1; i++) {
          const a = { client: null as unknown as TLNetClient, st: null as NetState | null };
          a.client = new TLNetClient(() => hub!.create(), { onState: (s) => { a.st = s; }, onStatus: () => {}, onClosed: () => {} }, realClock);
          await a.client.join(host.code, names[i % names.length]);
          agents.push(a);
        }
        if (o.start) host.start();
        if (!agentTimer) agentTimer = setInterval(agentStep, 700);
        return host.code;
      },
      agentsOff: () => { if (agentTimer) clearInterval(agentTimer); agentTimer = null; },
      agentStep,
      joinForm: (code = 'K7PQ2') => { ($('tl-code') as HTMLInputElement).value = code; ($('tl-name-j') as HTMLInputElement).value = 'Linh'; showView('join'); },
      // chơi hết ván ngay (cho ảnh chụp): người chơi cũng đánh theo gợi ý của máy
      finishHand: () => {
        const g = ctl && (ctl.kind === 'solo' ? ctl.game : ctl.kind === 'host' ? ctl.host.game : null);
        if (!g || !g.st) return;
        const st = g.st; let guard = 0;
        while (!st.over && guard++ < 800) {
          const seat = st.cur; const slot = g.seats[seat];
          if (g.controller(slot) === 'bot') (g as any).botAct((g as any).turnToken);
          else {
            const mv = botDecide(g.stateFor(slot).view!, 2, Math.random, false, g.settings.mode === 'points');
            if ('pass' in mv) g.intent(slot, { type: 'pass' }); else g.intent(slot, { type: 'play', cards: mv.cards });
          }
        }
      },
    };
  }
</script>

